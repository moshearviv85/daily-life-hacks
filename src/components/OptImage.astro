---
/**
 * Responsive image wrapper over the WebP variants produced by
 * scripts/optimize-images.mjs.
 *
 * Two things this deliberately does that the naive version did not:
 *
 * 1. It reads public/images/opt/manifest.json, so the `srcset` advertises the
 *    widths that were actually generated. Sources narrower than 1200px used to
 *    get a `-1200w.webp` entry describing a file that is not 1200px wide,
 *    which makes the browser pick the wrong candidate.
 *
 * 2. If no variants exist for a source it emits a plain `<img>` instead of a
 *    `<picture>`. A `<source>` pointing at a 404 is NOT recoverable — the
 *    browser commits to that source and renders a broken image. Nine article
 *    heroes are currently missing from disk; without this guard they render
 *    broken rather than merely absent.
 *
 * Intrinsic width/height are taken from the manifest when the caller does not
 * pass them, so every image reserves its box and contributes no CLS.
 */
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  [key: string]: any;
}

type ManifestEntry = {
  width: number;
  height: number;
  variants: { w: number; file: string }[];
};

let manifest: Record<string, ManifestEntry> = {};
try {
  manifest = JSON.parse(
    readFileSync(new URL("../../public/images/opt/manifest.json", import.meta.url), "utf8")
  );
} catch {
  // `astro dev` without a prebuild, or a fresh checkout. Fall back to the
  // plain <img>; correctness over cleverness.
  manifest = {};
}

const {
  src,
  alt,
  width,
  height,
  sizes = "(max-width: 768px) 100vw, 640px",
  class: className,
  loading = "lazy",
  decoding = "async",
  fetchpriority = "auto",
  ...rest
} = Astro.props;

const entry = manifest[src];
const variants = entry?.variants ?? [];
const sourceExists =
  !src.startsWith("/") ||
  existsSync(join(process.cwd(), "public", src.replace(/^\/+/, "")));

// De-duplicate by real width: a 768px-wide source produces 400w + 768w, not
// 400w/800w/1200w.
const byWidth = new Map<number, string>();
for (const v of variants) byWidth.set(v.w, v.file);
const srcset = [...byWidth.entries()]
  .sort((a, b) => a[0] - b[0])
  .map(([w, file]) => `${file} ${w}w`)
  .join(", ");

const finalWidth = width ?? entry?.width;
const finalHeight = height ?? entry?.height;
---

{
  !sourceExists ? (
    <span
      role="img"
      aria-label={alt}
      class={`${className ?? ""} flex items-center justify-center bg-gradient-to-br from-orange-50 to-slate-100 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:from-slate-800 dark:to-slate-900 dark:text-slate-300`}
    >
      Daily Life Hacks
    </span>
  ) : srcset ? (
    <picture>
      <source type="image/webp" srcset={srcset} sizes={sizes} />
      <img
        src={src}
        alt={alt}
        width={finalWidth}
        height={finalHeight}
        class={className}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        {...rest}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={finalWidth}
      height={finalHeight}
      class={className}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      {...rest}
    />
  )
}
