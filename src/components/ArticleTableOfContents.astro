---
interface TocItem {
  slug: string;
  text: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav
      class="article-toc mb-8 rounded-xl border p-4"
      style="background-color: var(--card-bg); border-color: var(--border-color);"
      aria-labelledby="article-toc-heading"
    >
      <details open>
        <summary
          id="article-toc-heading"
          class="cursor-pointer select-none rounded-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F29B30]"
          style="color: var(--heading-color);"
        >
          On this page
        </summary>
        <ol class="mt-3 grid list-decimal gap-2 border-t pt-3 pl-5" style="border-color: var(--border-color);">
          {
            items.map((item) => (
              <li>
                <a
                  href={`#${item.slug}`}
                  class="inline-block rounded-sm text-sm font-medium leading-snug underline decoration-transparent underline-offset-4 transition-colors hover:text-[#F29B30] hover:decoration-current focus-visible:text-[#F29B30] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F29B30]"
                  style="color: var(--text-color);"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ol>
      </details>
    </nav>
  )
}
