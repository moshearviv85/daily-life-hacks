---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import NewsletterPopup from "../components/NewsletterPopup.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  jsonLd?: object | object[];
  /** Defaults to indexable; use `noindex, follow` for pages not ready for Search (must match build-time policy). */
  robots?: string;
  /** Open Graph type — articles only; everything else defaults to website. */
  ogType?: "article" | "website";
}

const DEFAULT_ROBOTS =
  "index, follow, max-image-preview:large, max-snippet:-1";

const {
  title,
  description = "Daily Life Hacks - Practical nutrition tips and recipes for a healthier, happier life.",
  image = "/logo.png",
  canonicalURL = (() => {
    const base = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
    base.pathname = base.pathname.replace(/-v\d+\/?$/, '/');
    if (base.pathname !== '/' && !base.pathname.endsWith('/')) base.pathname += '/';
    return base.href;
  })(),
  jsonLd,
  robots = DEFAULT_ROBOTS,
  ogType = "website",
} = Astro.props;

const absoluteImage = image.startsWith("http")
  ? image
  : new URL(image, canonicalURL).href;

/** Search engines flag meta descriptions over ~160 chars; clamp on a word boundary. */
const MAX_DESCRIPTION_LENGTH = 155;
const metaDescription =
  description.length <= MAX_DESCRIPTION_LENGTH + 5
    ? description
    : `${description.slice(0, MAX_DESCRIPTION_LENGTH).replace(/\s+\S*$/, "")}...`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Analytics (deferred to reduce TBT on mobile) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PRSS2YN6G2');
      setTimeout(function(){
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-PRSS2YN6G2';
        s.async = true;
        document.head.appendChild(s);
      }, 3500);
    </script>

    <!-- Record one anonymous engagement event per calculator session. Input values are never sent. -->
    <script is:inline>
      (function () {
        if (window.__dlhToolTrackerBound) return;
        window.__dlhToolTrackerBound = true;

        function recordToolUse(event) {
          if (!location.pathname.startsWith('/tools/') || location.pathname === '/tools/') return;
          if (!(event.target instanceof Element)) return;
          if (!event.target.closest('[id$="-app"]')) return;

          var toolName = location.pathname.split('/').filter(Boolean).pop();
          var storageKey = 'dlh-tool-used:' + toolName;
          if (sessionStorage.getItem(storageKey)) return;

          sessionStorage.setItem(storageKey, '1');
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'tool_engagement', {
              tool_name: toolName,
              interaction_type: event.type,
            });
          }
        }

        document.addEventListener('input', recordToolUse, true);
        document.addEventListener('click', recordToolUse, true);
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    <ClientRouter />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Daily Life Hacks" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- Pinterest -->
    <meta name="pinterest-rich-pin" content="true" />
    <meta name="p:domain_verify" content="0aee36e1e94111369fd7fdf18cb18c48"/>

    <!-- Mobile browser chrome color (status bar / address bar) -->
    <meta id="theme-color-meta" name="theme-color" content="#ffffff" />

    <!-- Prevent white flash in dark mode -->
    <script is:inline>
      const getTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return "light"; // default
      };

      const setTheme = () => {
        const theme = getTheme();
        const isDark = theme === "dark";
        if (isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
        // Keep mobile browser chrome in sync with the site theme
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.setAttribute("content", isDark ? "#1e293b" : "#ffffff");
      };

      // Set on initial load
      setTheme();

      // Set on navigation
      document.addEventListener("astro:after-swap", setTheme);
    </script>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Feed autodiscovery (aggregators + readers look for this) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daily Life Hacks"
      href="https://www.daily-life-hacks.com/rss.xml"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- LLMs -->
    <link rel="llms-txt" href="/llms.txt" />

    <!-- JSON-LD Schema -->
    {
      jsonLd && Array.isArray(jsonLd)
        ? jsonLd.map((schema) => (
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify(schema)}
            />
          ))
        : jsonLd && (
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify(jsonLd)}
            />
          )
    }

    <!-- Robots -->
    <meta name="robots" content={robots} />

    <!-- Microsoft Clarity (deferred until after page load to avoid INP impact) -->
    <script is:inline>
      window.addEventListener("load", function () {
        setTimeout(function () {
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "w40uh6kjsh");
        }, 3000);
      });
    </script>
    <!-- Impact Affiliate Verification -->
    <meta name="impact-site-verification" content="2f93537c-72d5-4c10-a770-22a38d0fd42f" />
  </head>
  <body
    class="min-h-screen"
    style="background-color: var(--page-bg); color: var(--text-color);"
  >
    <slot />
    <NewsletterPopup />

    <!-- Pinterest: custom Save overlay handles pin creation; SDK removed to avoid mobile issues -->
    <script is:inline>
      document.addEventListener("astro:page-load", function () {
        document.querySelectorAll("[data-pin-log]").forEach(function (el) {
          el.remove();
        });
        var old = document.getElementById("pinterest-sdk");
        if (old) old.remove();
      });
    </script>

    <!-- Infinite scroll for category pages (single shared listener, View Transitions-safe) -->
    <script>
      {
        let _infiniteObserver: IntersectionObserver | null = null;

        function initCategoryInfiniteScroll() {
          // Always clean up previous observer before re-initializing
          if (_infiniteObserver) {
            _infiniteObserver.disconnect();
            _infiniteObserver = null;
          }

          const BATCH_SIZE = 12;
          let visible = BATCH_SIZE;
          let busy = false;

          // Re-query from current DOM on every navigation
          const items = Array.from(
            document.querySelectorAll<HTMLElement>(".article-item")
          );
          const sentinel = document.getElementById("load-sentinel");
          const spinner = document.getElementById("loading-spinner");

          // Not a category page, or all items already visible
          if (!sentinel || items.length <= BATCH_SIZE) return;

          _infiniteObserver = new IntersectionObserver(
            ([entry]) => {
              if (!entry.isIntersecting || busy) return;
              busy = true;
              if (spinner) spinner.classList.remove("hidden");

              setTimeout(() => {
                const end = Math.min(visible + BATCH_SIZE, items.length);
                for (let i = visible; i < end; i++) {
                  items[i].style.display = "";
                  items[i].style.animation = "fadeInUp 0.35s ease both";
                }
                visible = end;
                if (spinner) spinner.classList.add("hidden");
                busy = false;

                if (visible >= items.length) {
                  if (_infiniteObserver) {
                    _infiniteObserver.disconnect();
                    _infiniteObserver = null;
                  }
                  sentinel.remove();
                }
              }, 300);
            },
            { rootMargin: "200px" }
          );

          _infiniteObserver.observe(sentinel);
        }

        // Fires on initial load AND on every View Transitions navigation
        document.addEventListener("astro:page-load", initCategoryInfiniteScroll);
      }
    </script>

    <!-- Page view tracking (client-side) -->
    <script is:inline>
      function sendPageView() {
        try {
          var path =
            typeof window !== "undefined" && window.location
              ? window.location.pathname
              : "";
          if (!path) return;

          // Prevent spamming duplicates on the same path in one tab/session.
          var key = "pv_sent:" + path;
          try {
            if (sessionStorage.getItem(key) === "1") return;
            sessionStorage.setItem(key, "1");
          } catch (e) {}

          // Classify the traffic source once per session-path so we can finally
          // tell whether AI citations, Pinterest, or search actually send people.
          var ref = "";
          try { ref = document.referrer || ""; } catch (e) {}
          var host = "";
          try { host = ref ? new URL(ref).hostname.replace(/^www\./, "") : ""; } catch (e) {}
          var source = "direct";
          if (host) {
            if (host === window.location.hostname.replace(/^www\./, "")) {
              source = "internal";
            } else if (/(chatgpt\.com|openai\.com|perplexity\.ai|copilot\.microsoft\.com|gemini\.google\.com|claude\.ai|you\.com|phind\.com|poe\.com)$/.test(host)) {
              source = "ai:" + host;
            } else if (/(^|\.)google\.|(^|\.)bing\.com$|duckduckgo\.com$|search\.yahoo\.|ecosia\.org$|brave\.com$/.test(host)) {
              source = "search:" + host;
            } else if (/pinterest\./.test(host)) {
              source = "pinterest";
            } else if (/reddit\.com$|redd\.it$/.test(host)) {
              source = "reddit";
            } else if (/(facebook|instagram|twitter|x\.com|tiktok|linkedin|threads)\./.test(host)) {
              source = "social:" + host;
            } else if (/(flipboard|feedly|news\.google|msn\.com)/.test(host)) {
              source = "aggregator:" + host;
            } else {
              source = "referral:" + host;
            }
          }

          fetch("/api/event", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              event_type: "page_view",
              page: path,
              source: source,
              metadata: ref ? ref.slice(0, 200) : "",
            }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      }

      // Send immediately when this script runs.
      sendPageView();

      // Also send on initial page load and on Astro navigations.
      window.addEventListener("load", sendPageView);
      document.addEventListener("astro:page-load", sendPageView);
      document.addEventListener("astro:after-swap", sendPageView);
    </script>
  </body>
</html>
