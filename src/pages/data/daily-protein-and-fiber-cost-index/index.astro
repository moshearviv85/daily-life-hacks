---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import {
  DATA_LICENSE_URL,
  DATA_RELEASE_DATE,
  DATA_VERSION,
  DATASET_ORGANIZATION,
  DATASET_PERSON_CREATOR,
} from "../../../content/datasets";
import { parseCsv } from "../../../content/price-basis.mjs";

const PAGE_PATH = "/data/daily-protein-and-fiber-cost-index/";
const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}${PAGE_PATH}`;
const chartSrc = "/images/daily-protein-and-fiber-cost-index-chart.jpg";
const chartAlt =
  "Grouped bar chart of the annual cost of five protein menus and five fiber menus, each bar equal to that daily menu times 365";

const FILES = [
  "protein-day-cost-2026.csv",
  "fiber-day-cost-2026.csv",
  "one-dollar-protein-what-it-buys-2026.csv",
  "one-dollar-fiber-what-it-buys-2026.csv",
];

type Cells = Record<string, string>;

function rowsFrom(fileName: string): Cells[] {
  const parsed = parseCsv(readFileSync(join(process.cwd(), "public/data", fileName), "utf8"));
  return parsed.rows.map((cells) =>
    Object.fromEntries(parsed.header.map((name, index) => [name, cells[index] ?? ""])),
  );
}

function round1(value: number) {
  return Math.round(value * 10) / 10;
}

function cents(value: number) {
  return Math.round(value * 100) / 100;
}

function usd(value: number) {
  return cents(value).toLocaleString("en-US", { style: "currency", currency: "USD" });
}

type Menu = {
  kind: "protein" | "fiber";
  day: string;
  grams: number;
  cost: number;
};

function menusFrom(fileName: string, kind: "protein" | "fiber", gramKey: "protein_g" | "fiber_g"): Menu[] {
  const order: string[] = [];
  const buckets = new Map<string, { grams: number; cost: number }>();
  for (const row of rowsFrom(fileName)) {
    if (!buckets.has(row.day)) {
      buckets.set(row.day, { grams: 0, cost: 0 });
      order.push(row.day);
    }
    const bucket = buckets.get(row.day);
    if (!bucket) throw new Error(`Missing day bucket ${row.day}`);
    bucket.grams += Number(row[gramKey] || 0);
    bucket.cost += Number(row.cost_usd || 0);
  }
  if (order.length !== 5) throw new Error(`${fileName} expected 5 menus, got ${order.length}`);
  return order.map((day) => {
    const bucket = buckets.get(day);
    if (!bucket) throw new Error(`Missing ${day}`);
    return { kind, day, grams: round1(bucket.grams), cost: cents(bucket.cost) };
  });
}

function dollarFoods(fileName: string, nutrient: "protein" | "fiber") {
  const foods = rowsFrom(fileName)
    .map((row) => ({
      food: row.food,
      category: row.category,
      value: row.value,
      packageLabel: row.package,
      price: row.package_price_usd,
      fdc: row.fdc_id,
      nutrient,
    }))
    .sort((a, b) => Number(b.value) - Number(a.value) || a.food.localeCompare(b.food));
  if (foods.length !== 15) throw new Error(`${fileName} expected 15 foods, got ${foods.length}`);
  return foods;
}

const proteinMenus = menusFrom("protein-day-cost-2026.csv", "protein", "protein_g");
const fiberMenus = menusFrom("fiber-day-cost-2026.csv", "fiber", "fiber_g");
const proteinDollars = dollarFoods("one-dollar-protein-what-it-buys-2026.csv", "protein");
const fiberDollars = dollarFoods("one-dollar-fiber-what-it-buys-2026.csv", "fiber");

const cheapProtein = proteinMenus[0];
const restaurantProtein = proteinMenus.find((menu) => menu.day.includes("Restaurant"));
const cheapFiber = fiberMenus[0];
const restaurantFiber = fiberMenus.find((menu) => menu.day.includes("Restaurant"));
if (!restaurantProtein || !restaurantFiber) throw new Error("Missing a restaurant menu");

const topProtein = proteinDollars[0];
const topFiber = fiberDollars[0];
const scaledCheap = cheapProtein.cost * (100 / cheapProtein.grams);

function fdcHref(id: string) {
  return /^\d+$/.test(id) ? `https://fdc.nal.usda.gov/food-details/${id}/nutrients` : "";
}

function annual(cost: number) {
  return cost * 365;
}

function scaled(menu: Menu) {
  return menu.cost * (100 / menu.grams);
}

const title = "Daily Protein and Fiber Cost Index";
const description =
  "What $1 buys in protein and fiber, and what five single-person menus cost for 30 g fiber, 50 g protein, or a scaled 100 g day.";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  author: DATASET_PERSON_CREATOR,
  mainEntity: { "@id": `${pageUrl}#dataset` },
  datePublished: "2026-11-26",
  dateModified: "2026-11-26",
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${chartSrc}`,
    caption: chartAlt,
  },
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": `${pageUrl}#dataset`,
  name: "Daily protein and fiber menu costs and what one dollar buys",
  description:
    "Five protein menus near 50 grams, five fiber menus near 30 grams, and the top 15 foods for protein per dollar and fiber per dollar. A 100 gram protein figure on this page is the 50 gram menu scaled by 100 divided by that menu's grams. That scaled figure isn't a separate grocery list.",
  url: pageUrl,
  identifier: `${pageUrl}#dataset`,
  version: DATA_VERSION,
  isAccessibleForFree: true,
  license: DATA_LICENSE_URL,
  creator: DATASET_PERSON_CREATOR,
  publisher: DATASET_ORGANIZATION,
  includedInDataCatalog: { "@id": `${siteUrl}/data/#catalog` },
  keywords: ["protein cost per day", "fiber cost per day", "one dollar of protein", "single person grocery cost"],
  variableMeasured: ["protein grams", "fiber grams", "menu cost (USD)", "grams per dollar"],
  spatialCoverage: "United States",
  measurementTechnique: `${siteUrl}/methodology/`,
  dateModified: DATA_RELEASE_DATE,
  distribution: FILES.map((file) => ({
    "@type": "DataDownload",
    name: file,
    encodingFormat: "text/csv",
    contentUrl: `${siteUrl}/data/${file}`,
    license: DATA_LICENSE_URL,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Data", item: `${siteUrl}/data/` },
    { "@type": "ListItem", position: 3, name: "Daily protein and fiber cost", item: pageUrl },
  ],
};

const linkClass = "underline font-semibold";
const linkStyle = "color:#F29B30;";
---

<BaseLayout
  title={title}
  description={description}
  image={chartSrc}
  canonicalURL={pageUrl}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[webPageSchema, datasetSchema, breadcrumbSchema]}
>
  <Header />
  <main id="daily-cost-index" class="dci-page max-w-5xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/" class={linkClass} style={linkStyle}>Home</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / </span>
      <a href="/data/" class={linkClass} style={linkStyle}>Data</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Daily protein and fiber cost</span>
    </nav>

    <p class="text-sm font-bold uppercase tracking-wider mb-3" style="color:#a85e00;">
      By <a href="/author/david-miller/" class={linkClass} style={linkStyle}>{AUTHOR_NAME}</a>
      <span aria-hidden="true"> · </span>
      10 menus, 30 foods, v{DATA_VERSION}
    </p>
    <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">
      What a Dollar Buys, and What One Person Spends in a Year
    </h1>
    <p class="text-lg max-w-3xl mb-4" style="color:var(--text-color);">
      {topProtein.food} leads the protein dollar list at {topProtein.value} grams per dollar. The same food leads the fiber dollar list at {topFiber.value} grams. Flour wins both scoreboards and still isn't lunch. I'd like a receipt that looks like a day, not a bakery math problem.
    </p>
    <p class="text-lg max-w-3xl mb-8" style="color:var(--text-color);">
      For one person, {cheapProtein.day} is {cheapProtein.grams} g of protein for {usd(cheapProtein.cost)}. Eat that exact menu for 365 days and the priced foods are {usd(annual(cheapProtein.cost))}. The restaurant protein day is {usd(restaurantProtein.cost)}, which is {usd(annual(restaurantProtein.cost))} across a year. Same rough job. Very different habit.
    </p>

    <figure class="mb-10">
      <img src={chartSrc} alt={chartAlt} width="1200" height="675" class="w-full h-auto rounded-2xl" />
      <figcaption class="mt-3 text-sm" style="color:var(--muted-color);">
        Not a photograph, and not an AI illustration.
        Each bar is that day's cost times 365.
        Protein Day 1 is {usd(annual(cheapProtein.cost))}. Fiber Day 1 is {usd(annual(cheapFiber.cost))}.
        Day 3 protein is a meat-cook menu. Day 3 fiber is a produce menu. They're not one basket.
        The restaurant pair is {usd(annual(restaurantProtein.cost))} and {usd(annual(restaurantFiber.cost))}.
      </figcaption>
    </figure>

    <section class="mb-12" aria-label="Cost explorer">
      <h2>Flip between a dollar of food and a full menu</h2>
      <p>
        What $1 buys is the top 15 rows in one-dollar-protein-what-it-buys-2026.csv and one-dollar-fiber-what-it-buys-2026.csv. The menus are the five days in protein-day-cost-2026.csv and fiber-day-cost-2026.csv. Pick 1 to 365 days. The 100 g protein choice stretches a 50 g menu. It doesn't invent a new cart.
      </p>
      <div class="mode-row" role="group" aria-label="Explorer mode">
        <button type="button" class="mode-button" id="dci-mode-dollar" aria-pressed="false">What $1 buys</button>
        <button type="button" class="mode-button" id="dci-mode-menu" aria-pressed="true">Daily and annual menu cost</button>
      </div>
      <div id="dci-dollar-controls">
        <label class="tool-label">
          Food
          <select class="tool-input" id="dci-food">
            <optgroup label="Protein grams per dollar">
              {proteinDollars.map((food) => (
                <option value={`protein:${food.food}`} data-name={food.food} data-nutrient="protein" data-value={food.value}>
                  {food.food} ({food.value} g)
                </option>
              ))}
            </optgroup>
            <optgroup label="Fiber grams per dollar">
              {fiberDollars.map((food) => (
                <option value={`fiber:${food.food}`} data-name={food.food} data-nutrient="fiber" data-value={food.value}>
                  {food.food} ({food.value} g)
                </option>
              ))}
            </optgroup>
          </select>
        </label>
      </div>
      <div id="dci-menu-controls" class="grid md:grid-cols-3 gap-4">
        <label class="tool-label">
          Target
          <select class="tool-input" id="dci-target">
            <option value="fiber">30 g fiber menus</option>
            <option value="protein" selected>50 g protein menus</option>
            <option value="protein100">100 g protein, scaled from the 50 g menus</option>
          </select>
        </label>
        <label class="tool-label">
          Menu
          <select class="tool-input" id="dci-menu">
            {proteinMenus.map((menu, index) => (
              <option value={`protein-${index}`} data-kind="protein" data-day={menu.day} data-grams={menu.grams} data-cost={menu.cost} selected={index === 0}>
                {menu.day}
              </option>
            ))}
            {fiberMenus.map((menu, index) => (
              <option value={`fiber-${index}`} data-kind="fiber" data-day={menu.day} data-grams={menu.grams} data-cost={menu.cost}>
                {menu.day}
              </option>
            ))}
          </select>
        </label>
        <label class="tool-label">
          Days, 1 to 365
          <input class="tool-input" id="dci-days" type="number" min="1" max="365" value="365" inputmode="numeric" />
        </label>
      </div>
      <p id="dci-result" class="result-box" aria-live="polite">
        {cheapProtein.day}. 50 g protein menu. {(cheapProtein.grams * 365).toFixed(1)} g across 365 days costs {usd(annual(cheapProtein.cost))}. One day of this rate is {usd(cheapProtein.cost)}.
      </p>
      <p class="text-xs" style="color:var(--muted-color);">
        The day count stays in this browser tab. Nothing you type is saved or sent.
      </p>
    </section>

    <section class="mb-12">
      <h2>What $1 buys</h2>
      <p>
        {topProtein.food} is {topProtein.value} g of protein per dollar, from a {topProtein.packageLabel} at ${topProtein.price}. {topFiber.food} is {topFiber.value} g of fiber per dollar on the other file. The last row is still a strong one, because these files are the top 15, not the whole aisle. {proteinDollars.at(-1)?.food} is {proteinDollars.at(-1)?.value} g of protein per dollar. {fiberDollars.at(-1)?.food} is {fiberDollars.at(-1)?.value} g of fiber per dollar.
      </p>
      <div class="table-wrap mb-6">
        <table>
          <caption>Fifteen foods ranked by protein grams per dollar. Package price is the price in the file.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Category</th>
              <th scope="col">Protein g per $1</th>
              <th scope="col">Package</th>
              <th scope="col">Record</th>
            </tr>
          </thead>
          <tbody>
            {proteinDollars.map((food) => (
              <tr>
                <th scope="row">{food.food}</th>
                <td>{food.category}</td>
                <td>{food.value}</td>
                <td>{food.packageLabel} at ${food.price}</td>
                <td>
                  {fdcHref(food.fdc) ? (
                    <a href={fdcHref(food.fdc)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdc}</a>
                  ) : (
                    "no FDC id on this row"
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="table-wrap">
        <table>
          <caption>Fifteen foods ranked by fiber grams per dollar. Package price is the price in the file.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Category</th>
              <th scope="col">Fiber g per $1</th>
              <th scope="col">Package</th>
              <th scope="col">Record</th>
            </tr>
          </thead>
          <tbody>
            {fiberDollars.map((food) => (
              <tr>
                <th scope="row">{food.food}</th>
                <td>{food.category}</td>
                <td>{food.value}</td>
                <td>{food.packageLabel} at ${food.price}</td>
                <td>
                  {fdcHref(food.fdc) ? (
                    <a href={fdcHref(food.fdc)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdc}</a>
                  ) : (
                    "no FDC id on this row"
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-12">
      <h2>Daily and annual cost for one person</h2>
      <p>
        These are the foods the day files actually priced. Oil, coffee, and the snack you didn't write down aren't in the total. The fiber rock-bottom day is {cheapFiber.grams} g for {usd(cheapFiber.cost)}, or {usd(annual(cheapFiber.cost))} across 365 days. Stretching the cheap protein day from {cheapProtein.grams} g to 100 g makes one day {usd(scaledCheap)} and a year {usd(scaledCheap * 365)}. Same foods, more of them.
      </p>
      <div class="table-wrap mb-6">
        <table>
          <caption>Five protein menus near 50 g, with the published day cost, the 365-day cost, and the same menu scaled to 100 g of protein.</caption>
          <thead>
            <tr>
              <th scope="col">Menu</th>
              <th scope="col">Protein</th>
              <th scope="col">1 day</th>
              <th scope="col">365 days</th>
              <th scope="col">Scaled to 100 g</th>
              <th scope="col">100 g times 365</th>
            </tr>
          </thead>
          <tbody>
            {proteinMenus.map((menu) => (
              <tr>
                <th scope="row">{menu.day}</th>
                <td>{menu.grams.toFixed(1)} g</td>
                <td>{usd(menu.cost)}</td>
                <td>{usd(annual(menu.cost))}</td>
                <td>{usd(scaled(menu))}</td>
                <td>{usd(scaled(menu) * 365)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="table-wrap">
        <table>
          <caption>Five fiber menus near 30 g. The grams are the file total, not a promise that every day lands on exactly 30.</caption>
          <thead>
            <tr>
              <th scope="col">Menu</th>
              <th scope="col">Fiber</th>
              <th scope="col">1 day</th>
              <th scope="col">365 days</th>
            </tr>
          </thead>
          <tbody>
            {fiberMenus.map((menu) => (
              <tr>
                <th scope="row">{menu.day}</th>
                <td>{menu.grams.toFixed(1)} g</td>
                <td>{usd(menu.cost)}</td>
                <td>{usd(annual(menu.cost))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-4">
      <h2>Where the same numbers get a longer look</h2>
      <p>
        The dollar-for-dollar write-up, flour included, is
        <a href="/one-dollar-of-protein-vs-one-dollar-of-fiber/" class={linkClass} style={linkStyle}>what $1 of protein buys versus $1 of fiber</a>.
        The paired day, 50 g of protein and 30 g of fiber on one page, is
        <a href="/cost-of-50g-protein-and-30g-fiber-per-day/" class={linkClass} style={linkStyle}>the cost of 50 g protein and 30 g fiber</a>.
        Five different grocery lists that actually land near 100 g, not this scaler, are
        <a href="/how-much-100-grams-of-protein-costs-per-day/" class={linkClass} style={linkStyle}>how much 100 grams of protein costs per day</a>.
        The 50 g protein write-up is
        <a href="/what-50-grams-of-protein-costs-per-day/" class={linkClass} style={linkStyle}>what 50 grams of protein costs per day</a>.
        The 30 g fiber menus on this page are the five days in fiber-day-cost-2026.csv.
        Shelf snacks and fridge proteins, peanut butter through cottage cheese, are a different cut on the
        <a href="/data/no-cook-protein-and-high-fiber-snacks-index/" class={linkClass} style={linkStyle}>no-cook protein and high-fiber snacks index</a>.
      </p>
      <p>
        A menu cost isn't a claim that you should eat the rock-bottom day on repeat. It's the floor. How a row earns its price is on the
        <a href="/methodology/" class={linkClass} style={linkStyle}>methodology page</a>.
        Daily Life Hacks publishes the files. {AUTHOR_NAME} runs the checks. You're free to reuse the contribution under
        <a href={DATA_LICENSE_URL} class={linkClass} style={linkStyle} rel="license noopener" target="_blank">CC BY 4.0</a>,
        with credit. The catalog date on the data hub stays {DATA_RELEASE_DATE}. This page is the multiplier.
      </p>
    </section>
  </main>
  <Footer />

  <style is:global>
    .dci-page h2 { font-size: 1.65rem; line-height: 1.2; font-weight: 700; margin: 0 0 0.7rem; color: var(--heading-color); }
    .dci-page p { line-height: 1.7; margin: 0.7rem 0; color: var(--text-color); }
    .dci-page .mode-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1rem 0; }
    .dci-page .mode-button { border-radius: 999px; padding: 0.55rem 0.9rem; font-weight: 700; background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); }
    .dci-page .mode-button[aria-pressed="true"] { background: #F29B30; color: #1c1917; border-color: #F29B30; }
    .dci-page .tool-label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; font-weight: 600; color: var(--text-color); }
    .dci-page .tool-input { width: 100%; border-radius: 0.75rem; padding: 0.65rem 0.75rem; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); }
    .dci-page .result-box { font-weight: 700; border-radius: 1rem; padding: 1rem 1.1rem; background: rgba(242,155,48,.10); border: 2px solid #F29B30; color: var(--heading-color); }
    .dci-page .table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 1rem; background: var(--card-bg); }
    .dci-page table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .dci-page caption { caption-side: bottom; text-align: left; padding: 0.75rem 1rem; color: var(--muted-color); font-size: 0.8rem; }
    .dci-page th, .dci-page td { text-align: left; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--border-color); vertical-align: top; }
    .dci-page th { color: var(--heading-color); }
  </style>

  <script is:inline>
    (function () {
      function boot() {
        var root = document.getElementById('daily-cost-index');
        if (!root || root.dataset.booted) return;
        root.dataset.booted = '1';
        var dollarButton = root.querySelector('#dci-mode-dollar');
        var menuButton = root.querySelector('#dci-mode-menu');
        var dollarControls = root.querySelector('#dci-dollar-controls');
        var menuControls = root.querySelector('#dci-menu-controls');
        var food = root.querySelector('#dci-food');
        var target = root.querySelector('#dci-target');
        var menu = root.querySelector('#dci-menu');
        var daysInput = root.querySelector('#dci-days');
        var result = root.querySelector('#dci-result');
        var mode = 'menu';
        function num(value) {
          var parsed = parseFloat(value);
          return isFinite(parsed) ? parsed : 0;
        }
        function days() {
          var parsed = parseInt(daysInput.value, 10);
          if (!isFinite(parsed) || parsed < 1) return 1;
          if (parsed > 365) return 365;
          return parsed;
        }
        function money(amount) {
          return amount.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        }
        function gram(amount) {
          return (Math.round(amount * 10) / 10).toFixed(1);
        }
        function syncMenus() {
          var wantFiber = target.value === 'fiber';
          var options = Array.prototype.slice.call(menu.options);
          var first = null;
          options.forEach(function (option) {
            var show = wantFiber ? option.dataset.kind === 'fiber' : option.dataset.kind === 'protein';
            option.hidden = !show;
            option.disabled = !show;
            if (show && !first) first = option;
          });
          if (menu.selectedOptions[0] && menu.selectedOptions[0].disabled && first) menu.value = first.value;
        }
        function render() {
          dollarButton.setAttribute('aria-pressed', mode === 'dollar' ? 'true' : 'false');
          menuButton.setAttribute('aria-pressed', mode === 'menu' ? 'true' : 'false');
          dollarControls.hidden = mode !== 'dollar';
          menuControls.hidden = mode !== 'menu';
          if (mode === 'dollar') {
            var picked = food.options[food.selectedIndex];
            var perDollar = num(picked.dataset.value);
            result.textContent = picked.dataset.name + ': $1 buys ' + gram(perDollar) + ' g of ' + picked.dataset.nutrient + '. The day multiplier applies to a menu, not to this per-dollar rate.';
            return;
          }
          syncMenus();
          var chosen = menu.options[menu.selectedIndex];
          var count = days();
          var menuGrams = num(chosen.dataset.grams);
          var menuCost = num(chosen.dataset.cost);
          var scale = target.value === 'protein100' ? 100 / menuGrams : 1;
          var totalGrams = menuGrams * scale * count;
          var totalCost = menuCost * scale * count;
          var dayCost = menuCost * scale;
          var label = target.value === 'fiber' ? '30 g fiber menu' : (target.value === 'protein100' ? '100 g protein, scaled from this 50 g menu' : '50 g protein menu');
          var sentence = chosen.dataset.day + '. ' + label + '. ' + gram(totalGrams) + ' g across ' + count + (count === 1 ? ' day' : ' days') + ' costs ' + money(totalCost) + '. One day of this rate is ' + money(dayCost) + '.';
          if (target.value === 'protein100') {
            sentence += ' The scale is 100 divided by the published ' + gram(menuGrams) + ' g. Same foods, more of them.';
          }
          result.textContent = sentence;
        }
        dollarButton.addEventListener('click', function () { mode = 'dollar'; render(); });
        menuButton.addEventListener('click', function () { mode = 'menu'; render(); });
        food.addEventListener('change', render);
        target.addEventListener('change', render);
        menu.addEventListener('change', render);
        daysInput.addEventListener('input', render);
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
