---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import {
  DATA_LICENSE_URL,
  DATA_RELEASE_DATE,
  DATA_VERSION,
  DATASET_ORGANIZATION,
  DATASET_PERSON_CREATOR,
} from "../../../content/datasets";
import {
  BEAN_COST_FILE,
  BEAN_FIBER_FILE,
  FIBER_FILE,
  FORMATS,
  PANTRY_FILE,
  SODIUM_FILE,
  chartComparison,
  comparisonPairs,
  loadPantryCostIndex,
  money,
} from "../../../lib/pantry-cost-index.mjs";

const rows = loadPantryCostIndex();
const pairs = comparisonPairs(rows);
const bars = chartComparison(rows);
const kidney = rows.find((row) => row.food === "Canned kidney beans");
const dryBlack = rows.find((row) => row.food === "Black beans (dry)");
const cannedBlack = rows.find((row) => row.food === "Canned black beans");
if (!kidney || !dryBlack || !cannedBlack) throw new Error("pantry index lost a comparison row");
const dryCount = rows.filter((row) => row.format === "Dry").length;
const cannedCount = rows.filter((row) => row.format === "Canned").length;
const shelfCount = rows.filter((row) => row.format === "Shelf-stable").length;

const PAGE_PATH = "/data/canned-vs-dry-beans-and-pantry-cost-index/";
const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}${PAGE_PATH}`;
const chartSrc = "/images/canned-vs-dry-beans-and-pantry-cost-index-chart.jpg";
const chartAlt =
  "Grouped bar chart of protein grams per dollar for dry and canned black beans and for dry and canned chickpeas";
const title = "Canned vs Dry Beans and Pantry Cost Index";
const description =
  "Sort dry beans, canned beans, and shelf-stable staples by protein per dollar, fiber, sodium per 100 g, and cost per serving.";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  author: DATASET_PERSON_CREATOR,
  mainEntity: { "@id": `${pageUrl}#dataset` },
  datePublished: "2026-11-26",
  dateModified: "2026-11-26",
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${chartSrc}`,
    caption: chartAlt,
  },
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": `${pageUrl}#dataset`,
  name: "Canned versus dry beans and shelf-stable pantry cost index",
  description:
    "Shelf-stable grocery rows with protein grams per dollar, fiber grams per dollar when the file has them, sodium milligrams per 100 grams when the sodium file has that FDC id, and a serving cost from the package price. Dry beans use a half-cup cooked serving. Cans use a third of the can. Other pantry foods use 100 grams.",
  url: pageUrl,
  identifier: `${pageUrl}#dataset`,
  version: DATA_VERSION,
  isAccessibleForFree: true,
  license: DATA_LICENSE_URL,
  creator: DATASET_PERSON_CREATOR,
  publisher: DATASET_ORGANIZATION,
  includedInDataCatalog: { "@id": `${siteUrl}/data/#catalog` },
  keywords: ["canned beans", "dried beans", "pantry cost", "protein per dollar", "sodium"],
  variableMeasured: [
    "protein grams per dollar",
    "fiber grams per dollar",
    "sodium milligrams per 100 grams",
    "cost per serving (USD)",
  ],
  spatialCoverage: "United States",
  measurementTechnique: `${siteUrl}/methodology/`,
  dateModified: DATA_RELEASE_DATE,
  distribution: [PANTRY_FILE, BEAN_COST_FILE, BEAN_FIBER_FILE, FIBER_FILE, SODIUM_FILE].map((file) => ({
    "@type": "DataDownload",
    name: file,
    encodingFormat: "text/csv",
    contentUrl: `${siteUrl}/data/${file}`,
    license: DATA_LICENSE_URL,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Data", item: `${siteUrl}/data/` },
    { "@type": "ListItem", position: 3, name: "Canned vs dry beans and pantry cost", item: pageUrl },
  ],
};

const linkClass = "underline font-semibold";
const linkStyle = "color:#F29B30;";

function cell(value: string) {
  return value ? value : "not in the file";
}

function fdcHref(id: string) {
  return /^\d+$/.test(id) ? `https://fdc.nal.usda.gov/food-details/${id}/nutrients` : "";
}
---

<BaseLayout
  title={title}
  description={description}
  image={chartSrc}
  canonicalURL={pageUrl}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[webPageSchema, datasetSchema, breadcrumbSchema]}
>
  <Header />
  <main id="pantry-cost-index" class="pci-page max-w-5xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/" class={linkClass} style={linkStyle}>Home</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / </span>
      <a href="/data/" class={linkClass} style={linkStyle}>Data</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Canned vs dry beans and pantry cost</span>
    </nav>

    <p class="text-sm font-bold uppercase tracking-wider mb-3" style="color:#a85e00;">
      By <a href="/author/david-miller/" class={linkClass} style={linkStyle}>{AUTHOR_NAME}</a>
      <span aria-hidden="true"> · </span>
      {rows.length} foods, v{DATA_VERSION}
    </p>
    <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">
      Dry beans, the can, and the rest of the cupboard
    </h1>
    <p class="text-lg max-w-3xl mb-4" style="color:var(--text-color);">
      Dry black beans return {dryBlack.proteinLabel} g of protein per dollar. The can returns {cannedBlack.proteinLabel}. Same cupboard, different receipt. A half cup cooked from the dry bag is {money(dryBlack.servingCost)}. A half cup from the can is {money(cannedBlack.servingCost)}.
    </p>
    <p class="text-lg max-w-3xl mb-8" style="color:var(--text-color);">
      {rows.length} rows. {dryCount} are dry beans and lentils. {cannedCount} are cans. {shelfCount} are the other shelf-stable foods, flour included. Protein and the package price are {PANTRY_FILE}. The bean check is {BEAN_COST_FILE}. Fiber on the bean rows is {BEAN_FIBER_FILE}. Fiber on the rest, when it exists, is {FIBER_FILE}. Sodium milligrams per 100 g are {SODIUM_FILE}, matched by FDC id, and a missing id stays blank.
    </p>

    <figure class="mb-10">
      <img src={chartSrc} alt={chartAlt} width="1200" height="675" class="w-full h-auto rounded-2xl" />
      <figcaption class="mt-3 text-sm" style="color:var(--muted-color);">
        Not a photograph, and not an AI illustration.
        {bars.map((bar) => `${bar.label}: dry ${bar.dryProtein} g per dollar, canned ${bar.cannedProtein}.`).join(" ")}
        Kidney beans are a can at {kidney.proteinLabel} g per dollar and {kidney.sodiumLabel} mg of sodium per 100 g. The files don't have a dry kidney row, so the bars leave it out.
      </figcaption>
    </figure>

    <section class="mb-12">
      <h2>The dry bag against the can</h2>
      <p>
        Black beans and chickpeas are the only varieties with both a dry row and a can. Kidney has the can and not the bag. Dry black beans are {dryBlack.sodiumLabel} mg of sodium per 100 g. The black bean can and the chickpea can aren't in the sodium file, so this table doesn't borrow the kidney can's {kidney.sodiumLabel} mg and call it theirs.
      </p>
      <div class="table-wrap">
        <table>
          <caption>Protein and fiber per dollar, plus the serving cost. Dry serving is 1/2 cup cooked. Can serving is 1/2 cup, one third of the 1.5 cup drained can.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Protein g per $</th>
              <th scope="col">Fiber g per $</th>
              <th scope="col">Sodium mg / 100 g</th>
              <th scope="col">Cost / serving</th>
            </tr>
          </thead>
          <tbody>
            {pairs.flatMap((pair) => [pair.dry, pair.can]).concat([kidney]).map((food) => (
              <tr>
                <th scope="row">{food.food}</th>
                <td>{food.proteinLabel}</td>
                <td>{cell(food.fiberLabel)}</td>
                <td>{cell(food.sodiumLabel)}</td>
                <td>{money(food.servingCost)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-12" aria-label="Pantry format filter">
      <h2>Filter by format and sort the receipt</h2>
      <p>
        Dry, canned, and shelf-stable are separate piles. Flour is shelf-stable. It isn't a bean, and it isn't hiding in the dry-bean count.
      </p>
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <label class="tool-label">
          Format
          <select class="tool-input" id="pci-format">
            <option value="all" selected>All {rows.length} foods</option>
            {FORMATS.map((format) => (
              <option value={format}>{format}</option>
            ))}
          </select>
        </label>
        <label class="tool-label">
          Sort
          <select class="tool-input" id="pci-sort">
            <option value="protein" selected>Protein per dollar, high first</option>
            <option value="fiber">Fiber per dollar, high first</option>
            <option value="sodium">Sodium mg per 100 g, low first</option>
            <option value="cost">Cost per serving, low first</option>
          </select>
        </label>
      </div>
      <p id="pci-count" aria-live="polite" class="count-line"></p>
      <div class="table-wrap">
        <table>
          <caption>Every row in the pantry file. A blank fiber or sodium cell means that file has no FDC match. It doesn't mean zero.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Protein g per $</th>
              <th scope="col">Fiber g per $</th>
              <th scope="col">Sodium mg / 100 g</th>
              <th scope="col">Cost / serving</th>
            </tr>
          </thead>
          <tbody id="pci-rows">
            {rows.map((food) => (
              <tr
                data-name={food.food}
                data-format={food.format}
                data-protein={food.proteinLabel}
                data-fiber={food.fiberLabel}
                data-sodium={food.sodiumLabel}
                data-cost={food.servingCost.toFixed(6)}
              >
                <th scope="row">
                  {food.food}
                  <span class="food-meta">
                    {food.format}
                    {food.package ? ` · ${food.package} at $${food.packagePrice}` : ""}
                    {` · ${food.serving}`}
                    {fdcHref(food.fdcId) ? (
                      <>
                        {" · "}
                        <a href={fdcHref(food.fdcId)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdcId}</a>
                      </>
                    ) : " · no FDC id"}
                  </span>
                </th>
                <td>{food.proteinLabel}</td>
                <td>{cell(food.fiberLabel)}</td>
                <td>{cell(food.sodiumLabel)}</td>
                <td>{money(food.servingCost)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs" style="color:var(--muted-color);">
        The filter runs in this browser tab. Nothing you pick is saved or sent. The table above is the same file, already printed.
      </p>
    </section>

    <section class="mb-4">
      <h2>Where the same foods get a longer look</h2>
      <p>
        The bean-only markup, sodium included where that page measured it, is
        <a href="/canned-vs-dry-beans-cost-and-sodium-per-serving/" class={linkClass} style={linkStyle}>canned versus dry beans, cost and sodium per serving</a>.
        The nutrition comparison, without the pantry sort, is
        <a href="/canned-beans-vs-dried-beans-nutrition/" class={linkClass} style={linkStyle}>canned beans versus dried beans</a>.
        The cupboard ranking on its own is
        <a href="/cheapest-shelf-stable-pantry-foods-for-protein/" class={linkClass} style={linkStyle}>the cheapest shelf-stable pantry foods for protein</a>.
        Dry bags, frozen peas, and canned fish on one chart are
        <a href="/how-much-protein-and-fiber-in-canned-vs-frozen-vs-dry-staples/" class={linkClass} style={linkStyle}>canned, frozen, and dry staples</a>.
      </p>
      <p>
        A gram per dollar isn't a claim that the winner belongs in every pot. Dry beans still have to be cooked. The can is already cooked, and it costs more protein per dollar to say so. How a row earns its price is on the
        <a href="/methodology/" class={linkClass} style={linkStyle}>methodology page</a>.
        Daily Life Hacks publishes the files. {AUTHOR_NAME} runs the checks. You're free to reuse the contribution under
        <a href={DATA_LICENSE_URL} class={linkClass} style={linkStyle} rel="license noopener" target="_blank">CC BY 4.0</a>,
        with credit. The catalog date on the data hub stays {DATA_RELEASE_DATE}. This page is the filter.
      </p>
    </section>
  </main>
  <Footer />

  <style is:global>
    .pci-page h2 { font-size: 1.65rem; line-height: 1.2; font-weight: 700; margin: 0 0 0.7rem; color: var(--heading-color); }
    .pci-page p { line-height: 1.7; margin: 0.7rem 0; color: var(--text-color); }
    .pci-page .tool-label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; font-weight: 600; color: var(--text-color); }
    .pci-page .tool-input { width: 100%; border-radius: 0.75rem; padding: 0.65rem 0.75rem; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); }
    .pci-page .table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 1rem; background: var(--card-bg); }
    .pci-page table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .pci-page caption { caption-side: bottom; text-align: left; padding: 0.75rem 1rem; color: var(--muted-color); font-size: 0.8rem; }
    .pci-page th, .pci-page td { text-align: left; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--border-color); vertical-align: top; }
    .pci-page th { color: var(--heading-color); }
    .pci-page .food-meta { display: block; margin-top: 0.2rem; font-weight: 500; font-size: 0.75rem; color: var(--muted-color); }
    .pci-page .count-line { font-weight: 700; color: var(--heading-color); }
  </style>

  <script is:inline>
    (function () {
      function boot() {
        var root = document.getElementById("pantry-cost-index");
        if (!root || root.dataset.booted) return;
        root.dataset.booted = "1";
        var format = root.querySelector("#pci-format");
        var sort = root.querySelector("#pci-sort");
        var count = root.querySelector("#pci-count");
        var body = root.querySelector("#pci-rows");
        var rows = Array.prototype.slice.call(body.querySelectorAll("tr"));
        function num(value) {
          if (value === "") return null;
          var parsed = parseFloat(value);
          return isFinite(parsed) ? parsed : null;
        }
        function render() {
          var mode = sort.value;
          var chosen = format.value;
          var sorted = rows.slice().sort(function (a, b) {
            var av = num(a.dataset[mode]);
            var bv = num(b.dataset[mode]);
            if (av === null && bv === null) return a.dataset.name.localeCompare(b.dataset.name);
            if (av === null) return 1;
            if (bv === null) return -1;
            if (mode === "protein" || mode === "fiber") return bv - av;
            return av - bv;
          });
          sorted.forEach(function (row) { body.appendChild(row); });
          var visible = 0;
          rows.forEach(function (row) {
            var hide = chosen !== "all" && row.dataset.format !== chosen;
            row.hidden = hide;
            if (!hide) visible += 1;
          });
          var label = chosen === "all" ? "every format" : chosen;
          count.textContent = visible + " of " + rows.length + " foods in " + label + ".";
        }
        format.addEventListener("change", render);
        sort.addEventListener("change", render);
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
