---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import {
  DATA_LICENSE_URL,
  DATA_RELEASE_DATE,
  DATA_VERSION,
  DATASET_ORGANIZATION,
  DATASET_PERSON_CREATOR,
} from "../../../content/datasets";
import { parseCsv } from "../../../content/price-basis.mjs";

const PAGE_PATH = "/data/meat-dairy-and-plant-protein-index/";
const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}${PAGE_PATH}`;
const chartSrc = "/images/meat-dairy-and-plant-protein-index-chart.jpg";
const chartAlt =
  "Grouped bar chart of protein grams per dollar for the top three foods in dried beans, nuts and seeds, meat, eggs and dairy, canned beans, and soy";

const FILES = [
  { file: "meat-per-dollar-protein-ranked-2026.csv", label: "Meat file" },
  { file: "dairy-protein-per-dollar-ranked-2026.csv", label: "Dairy file" },
  { file: "plant-protein-per-dollar-ranked-2026.csv", label: "Plant file" },
];

const CATEGORIES = [
  "Meat & poultry",
  "Eggs & dairy",
  "Soy & plant proteins",
  "Dried beans & lentils",
  "Nuts & seeds",
  "Canned beans",
];

const ASKED = [
  "Brown lentils (dry)",
  "Peanut butter",
  "Chicken drumsticks (bone-in)",
  "Eggs (large)",
  "Mozzarella (low-moisture part-skim)",
  "Chicken thighs (boneless, skinless)",
  "Greek yogurt (plain, nonfat)",
  "Pork shoulder butt roast (boneless)",
  "Chicken breast (boneless, skinless)",
  "TVP (textured vegetable protein)",
  "Tofu (extra firm)",
  "Ground beef (80/20)",
];

function rowsFrom(fileName: string) {
  const parsed = parseCsv(readFileSync(join(process.cwd(), "public/data", fileName), "utf8"));
  return parsed.rows.map((cells) =>
    Object.fromEntries(parsed.header.map((name, index) => [name, cells[index] ?? ""])),
  );
}

const foods = FILES.flatMap((source) =>
  rowsFrom(source.file).map((row) => ({
    ...row,
    file: source.file,
    fileLabel: source.label,
  })),
).sort((a, b) => Number(b.value) - Number(a.value) || a.food.localeCompare(b.food));

const seen = new Set(foods.map((row) => row.category));
for (const category of CATEGORIES) {
  if (!seen.has(category)) throw new Error(`Missing category ${category}`);
}
for (const category of seen) {
  if (!CATEGORIES.includes(category)) throw new Error(`Unexpected category ${category}`);
}

function must(name: string) {
  const row = foods.find((item) => item.food === name);
  if (!row) throw new Error(`Missing ${name}`);
  return row;
}

const asked = ASKED.map((name) => must(name));
const high = foods[0];
const low = foods[foods.length - 1];
const lentils = must("Brown lentils (dry)");
const drumsticks = must("Chicken drumsticks (bone-in)");
const flour = rowsFrom("protein-per-dollar-2026.csv").find((row) => row.food === "Whole wheat flour");
if (!flour) throw new Error("Missing whole wheat flour in protein-per-dollar-2026.csv");

const byCategory = CATEGORIES.map((category) => {
  const rows = foods.filter((row) => row.category === category);
  return { category, count: rows.length, leader: rows[0] };
});

const title = "Meat, Dairy, and Plant Protein per Dollar";
const description =
  "Filter 35 grocery proteins by category and sort grams per dollar. Meat, eggs, dairy, beans, nuts, and soy from three audited files.";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  author: DATASET_PERSON_CREATOR,
  mainEntity: { "@id": `${pageUrl}#dataset` },
  datePublished: "2026-11-26",
  dateModified: "2026-11-26",
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${chartSrc}`,
    caption: chartAlt,
  },
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": `${pageUrl}#dataset`,
  name: "Meat, dairy, and plant protein grams per dollar",
  description:
    "Grocery proteins from the meat, dairy, and plant category files, with protein grams per dollar, package price, and the USDA record when the row has one. Whole wheat flour stays in the wider protein file and is not mixed into this filter.",
  url: pageUrl,
  identifier: `${pageUrl}#dataset`,
  version: DATA_VERSION,
  isAccessibleForFree: true,
  license: DATA_LICENSE_URL,
  creator: DATASET_PERSON_CREATOR,
  publisher: DATASET_ORGANIZATION,
  includedInDataCatalog: { "@id": `${siteUrl}/data/#catalog` },
  keywords: ["protein per dollar", "meat", "dairy", "plant protein", "grocery prices"],
  variableMeasured: ["protein grams per dollar", "package price (USD)", "food category"],
  spatialCoverage: "United States",
  measurementTechnique: `${siteUrl}/methodology/`,
  dateModified: DATA_RELEASE_DATE,
  distribution: FILES.map((source) => ({
    "@type": "DataDownload",
    name: source.file,
    encodingFormat: "text/csv",
    contentUrl: `${siteUrl}/data/${source.file}`,
    license: DATA_LICENSE_URL,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Data", item: `${siteUrl}/data/` },
    { "@type": "ListItem", position: 3, name: "Meat, dairy, and plant protein", item: pageUrl },
  ],
};

const linkClass = "underline font-semibold";
const linkStyle = "color:#F29B30;";

function fdcHref(id: string) {
  return /^\d+$/.test(id) ? `https://fdc.nal.usda.gov/food-details/${id}/nutrients` : "";
}
---

<BaseLayout
  title={title}
  description={description}
  image={chartSrc}
  canonicalURL={pageUrl}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[webPageSchema, datasetSchema, breadcrumbSchema]}
>
  <Header />
  <main id="protein-index" class="ppi-page max-w-5xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/" class={linkClass} style={linkStyle}>Home</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / </span>
      <a href="/data/" class={linkClass} style={linkStyle}>Data</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Meat, dairy, and plant protein</span>
    </nav>

    <p class="text-sm font-bold uppercase tracking-wider mb-3" style="color:#a85e00;">
      By <a href="/author/david-miller/" class={linkClass} style={linkStyle}>{AUTHOR_NAME}</a>
      <span aria-hidden="true"> · </span>
      {foods.length} foods, v{DATA_VERSION}
    </p>
    <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">
      Filter Meat, Dairy, and Plant Protein by Grams per Dollar
    </h1>
    <p class="text-lg max-w-3xl mb-4" style="color:var(--text-color);">
      {high.food} leads these three files at {high.value} grams of protein per dollar. {low.food} is the other end, at {low.value}. Flour can beat both of them. Flour isn't in this filter.
    </p>
    <p class="text-lg max-w-3xl mb-8" style="color:var(--text-color);">
      {foods.length} rows. Meat and poultry are meat-per-dollar-protein-ranked-2026.csv. Eggs and dairy are dairy-protein-per-dollar-ranked-2026.csv. Beans, nuts, canned beans, and soy are plant-protein-per-dollar-ranked-2026.csv. Whole wheat flour is {flour.protein_g_per_dollar} grams per dollar in protein-per-dollar-2026.csv, from a {flour.package} at ${flour.package_price_usd}. It stays with the grains.
    </p>

    <figure class="mb-10">
      <img src={chartSrc} alt={chartAlt} width="1200" height="675" class="w-full h-auto rounded-2xl" />
      <figcaption class="mt-3 text-sm" style="color:var(--muted-color);">
        Not a photograph, and not an AI illustration.
        Each group is the top three foods in that category.
        {byCategory.map((group) => `${group.category} leads with ${group.leader.food} at ${group.leader.value} g per dollar.`).join(" ")}
      </figcaption>
    </figure>

    <section class="mb-12">
      <h2>The rows people actually compare</h2>
      <p>
        Lentils at {lentils.value} grams per dollar, from a {lentils.package} at ${lentils.package_price_usd}, are the top of this set. Drumsticks get to {drumsticks.value} only after the file has already done the ugly math. The note on that row says: {drumsticks.audit_note}. The bone wasn't a bonus. It was removed.
      </p>
      <div class="table-wrap">
        <table>
          <caption>Protein grams per dollar for the grocery rows readers ask about. The full {foods.length} are in the filter below.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Category</th>
              <th scope="col">Protein g per $</th>
              <th scope="col">Package</th>
              <th scope="col">Record</th>
            </tr>
          </thead>
          <tbody>
            {asked.map((food) => (
              <tr>
                <th scope="row">{food.food}</th>
                <td>{food.category}</td>
                <td>{food.value}</td>
                <td>{food.package} at ${food.package_price_usd}</td>
                <td>
                  {fdcHref(food.fdc_id) ? (
                    <a href={fdcHref(food.fdc_id)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdc_id}</a>
                  ) : (
                    "no FDC id on this row"
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="protein-explorer" class="mb-12" aria-label="Protein category filter">
      <h2>Pick a category and sort by protein per dollar</h2>
      <p>
        Six categories, because the plant file isn't one blob. Canned beans are not the dry bag. Soy isn't peanuts. The filter keeps those labels.
      </p>
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <label class="tool-label">
          Category
          <select class="tool-input" id="ppi-category">
            <option value="all" selected>All {foods.length} foods</option>
            {CATEGORIES.map((category) => (
              <option value={category}>{category}</option>
            ))}
          </select>
        </label>
        <label class="tool-label">
          Sort
          <select class="tool-input" id="ppi-sort">
            <option value="protein" selected>Protein grams per dollar</option>
            <option value="price">Package price, low first</option>
            <option value="name">Name</option>
          </select>
        </label>
      </div>
      <p id="ppi-count" aria-live="polite" class="count-line"></p>
      <div class="table-wrap">
        <table>
          <caption>Every row in the three category files. Package price is the price in the file, not a promise about tomorrow's shelf.</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Protein g per $</th>
              <th scope="col">Package price</th>
              <th scope="col">File</th>
            </tr>
          </thead>
          <tbody id="ppi-rows">
            {foods.map((food) => (
              <tr data-name={food.food} data-category={food.category} data-value={food.value} data-price={food.package_price_usd}>
                <th scope="row">
                  {food.food}
                  <span class="food-meta">
                    {food.category}
                    {food.package ? ` · ${food.package}` : ""}
                    {fdcHref(food.fdc_id) ? (
                      <>
                        {" · "}
                        <a href={fdcHref(food.fdc_id)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdc_id}</a>
                      </>
                    ) : " · no FDC id"}
                  </span>
                </th>
                <td>{food.value}</td>
                <td>${food.package_price_usd}</td>
                <td>{food.fileLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs" style="color:var(--muted-color);">
        The filter runs in this browser tab. Nothing you pick is saved or sent. The table above is the same three files, already printed.
      </p>
    </section>

    <section class="mb-4">
      <h2>Where the same foods get a longer look</h2>
      <p>
        The plant and animal split on one price list is
        <a href="/plant-vs-animal-protein-cost-per-dollar/" class={linkClass} style={linkStyle}>plant vs animal protein cost per dollar</a>.
        Meat on its own, including the cuts that lose to lentils, is
        <a href="/animal-protein-per-dollar-ranked/" class={linkClass} style={linkStyle}>animal protein per dollar</a>.
        Eggs, mozzarella, Greek yogurt, tofu, and tempeh share a chart on
        <a href="/cheapest-dairy-and-soy-protein-per-dollar/" class={linkClass} style={linkStyle}>cheapest dairy and soy protein per dollar</a>.
        Flour's raw {flour.protein_g_per_dollar} grams get cut down once protein quality is in the math. That page is
        <a href="/protein-per-dollar-adjusted-for-quality/" class={linkClass} style={linkStyle}>protein per dollar adjusted for quality</a>.
        The raw figure next to the published DIAAS score, with the cuts that file never scored left blank, is the
        <a href="/data/protein-quality-diaas-and-cost-index/" class={linkClass} style={linkStyle}>DIAAS protein quality and cost index</a>.
      </p>
      <p>
        A gram per dollar isn't a meal plan, and it isn't a claim that the winner belongs in every cart. Dry lentils still have to be cooked. Drumsticks still have a bone the file already discounted. How a row earns its USDA record is on the
        <a href="/methodology/" class={linkClass} style={linkStyle}>methodology page</a>.
        Daily Life Hacks publishes the files. {AUTHOR_NAME} runs the checks. You're free to reuse the contribution under
        <a href={DATA_LICENSE_URL} class={linkClass} style={linkStyle} rel="license noopener" target="_blank">CC BY 4.0</a>,
        with credit. The catalog date on the data hub stays {DATA_RELEASE_DATE}. This page is the filter.
      </p>
    </section>
  </main>
  <Footer />

  <style is:global>
    .ppi-page h2 { font-size: 1.65rem; line-height: 1.2; font-weight: 700; margin: 0 0 0.7rem; color: var(--heading-color); }
    .ppi-page p { line-height: 1.7; margin: 0.7rem 0; color: var(--text-color); }
    .ppi-page .tool-label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.875rem; font-weight: 600; color: var(--text-color); }
    .ppi-page .tool-input { width: 100%; border-radius: 0.75rem; padding: 0.65rem 0.75rem; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); }
    .ppi-page .table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 1rem; background: var(--card-bg); }
    .ppi-page table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .ppi-page caption { caption-side: bottom; text-align: left; padding: 0.75rem 1rem; color: var(--muted-color); font-size: 0.8rem; }
    .ppi-page th, .ppi-page td { text-align: left; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--border-color); vertical-align: top; }
    .ppi-page th { color: var(--heading-color); }
    .ppi-page .food-meta { display: block; margin-top: 0.2rem; font-weight: 500; font-size: 0.75rem; color: var(--muted-color); }
    .ppi-page .count-line { font-weight: 700; color: var(--heading-color); }
  </style>

  <script is:inline>
    (function () {
      function boot() {
        var root = document.getElementById('protein-index');
        if (!root || root.dataset.booted) return;
        root.dataset.booted = '1';
        var category = root.querySelector('#ppi-category');
        var sort = root.querySelector('#ppi-sort');
        var count = root.querySelector('#ppi-count');
        var body = root.querySelector('#ppi-rows');
        var rows = Array.prototype.slice.call(body.querySelectorAll('tr'));
        function num(value) {
          var parsed = parseFloat(value);
          return isFinite(parsed) ? parsed : 0;
        }
        function render() {
          var mode = sort.value;
          var chosen = category.value;
          var sorted = rows.slice().sort(function (a, b) {
            if (mode === 'price') return num(a.dataset.price) - num(b.dataset.price);
            if (mode === 'name') return a.dataset.name.localeCompare(b.dataset.name);
            return num(b.dataset.value) - num(a.dataset.value);
          });
          sorted.forEach(function (row) { body.appendChild(row); });
          var visible = 0;
          rows.forEach(function (row) {
            var hide = chosen !== 'all' && row.dataset.category !== chosen;
            row.hidden = hide;
            if (!hide) visible += 1;
          });
          var label = chosen === 'all' ? 'every category' : chosen;
          count.textContent = visible + ' of ' + rows.length + ' foods in ' + label + '.';
        }
        category.addEventListener('change', render);
        sort.addEventListener('change', render);
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
