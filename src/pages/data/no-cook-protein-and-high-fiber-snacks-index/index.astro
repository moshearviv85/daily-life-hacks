---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import {
  DATA_LICENSE_URL,
  DATA_RELEASE_DATE,
  DATA_VERSION,
  DATASET_ORGANIZATION,
  DATASET_PERSON_CREATOR,
} from "../../../content/datasets";
import { parseCsv } from "../../../content/price-basis.mjs";

const PAGE_PATH = "/data/no-cook-protein-and-high-fiber-snacks-index/";
const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}${PAGE_PATH}`;
const chartSrc = "/images/no-cook-protein-and-high-fiber-snacks-index-chart.jpg";
const chartAlt =
  "Horizontal bar chart of protein grams per dollar and fiber grams per dollar for peanut butter, popcorn kernels, dry roasted peanuts, Greek yogurt, cottage cheese, canned tuna, and carrots";

const FILES = [
  "no-cook-protein-per-dollar-2026.csv",
  "high-fiber-snacks-per-dollar-2026.csv",
];

const FRIDGE = new Set([
  "Whole milk",
  "Greek yogurt (plain, nonfat)",
  "Rotisserie chicken (whole, cooked)",
  "Cottage cheese (4%)",
  "Cheddar cheese",
  "Carrots (whole, bagged)",
]);

const SHELF = new Set([
  "Peanut butter",
  "Dry roasted peanuts",
  "Sunflower seed kernels",
  "Canned black beans",
  "Canned kidney beans",
  "Canned tuna (chunk light, in water)",
  "Canned chickpeas",
  "Canned pink salmon",
  "Sardines (canned in oil, drained)",
  "Almonds",
  "Popcorn kernels",
  "Bananas",
  "Prunes (dried plums)",
  "Apples (gala)",
  "Raisins",
]);

type Cells = Record<string, string>;

function rowsFrom(fileName: string): Cells[] {
  const parsed = parseCsv(readFileSync(join(process.cwd(), "public/data", fileName), "utf8"));
  return parsed.rows.map((cells) =>
    Object.fromEntries(parsed.header.map((name, index) => [name, cells[index] ?? ""])),
  );
}

function round1(value: number) {
  return (Math.round(value * 10) / 10).toFixed(1);
}

type Food = {
  food: string;
  storage: "shelf" | "fridge";
  storageLabel: string;
  protein: string;
  fiber: string;
  combined: string;
  packageLabel: string;
  price: string;
  fdc: string;
};

const proteinRows = rowsFrom("no-cook-protein-per-dollar-2026.csv");
const fiberRows = rowsFrom("high-fiber-snacks-per-dollar-2026.csv");
if (proteinRows.length !== 15) throw new Error(`no-cook file has ${proteinRows.length} rows`);
if (fiberRows.length !== 10) throw new Error(`snack file has ${fiberRows.length} rows`);

const proteinByName = new Map(proteinRows.map((row) => [row.food, row]));
const fiberByName = new Map(fiberRows.map((row) => [row.food, row]));
const names = [...new Set([...proteinByName.keys(), ...fiberByName.keys()])];
const known = new Set([...FRIDGE, ...SHELF]);
if (known.size !== 21 || FRIDGE.size !== 6 || SHELF.size !== 15) {
  throw new Error("storage lists drifted");
}
if (names.length !== 21) throw new Error(`expected 21 foods, got ${names.length}`);
for (const name of names) {
  if (!known.has(name)) throw new Error(`unclassified food ${name}`);
}
for (const name of known) {
  if (!proteinByName.has(name) && !fiberByName.has(name)) throw new Error(`missing ${name}`);
}

const foods: Food[] = names.map((name) => {
  const protein = proteinByName.get(name);
  const fiber = fiberByName.get(name);
  const sample = protein ?? fiber;
  if (!sample) throw new Error(`missing ${name}`);
  if (protein && fiber) {
    if (protein.package !== fiber.package || protein.package_price_usd !== fiber.package_price_usd) {
      throw new Error(`package drift ${name}`);
    }
    if ((protein.fdc_id || "") !== (fiber.fdc_id || "")) throw new Error(`fdc drift ${name}`);
  }
  const storage = FRIDGE.has(name) ? "fridge" : "shelf";
  return {
    food: name,
    storage,
    storageLabel: storage === "fridge" ? "Fridge-ready" : "Shelf-stable / Dorm",
    protein: protein?.value ?? "",
    fiber: fiber?.value ?? "",
    combined: protein && fiber ? round1(Number(protein.value) + Number(fiber.value)) : "",
    packageLabel: sample.package,
    price: Number(sample.package_price_usd).toFixed(2),
    fdc: sample.fdc_id || "",
  };
});

function mustFood(name: string, protein: string, fiber: string, combined: string) {
  const food = foods.find((item) => item.food === name);
  if (!food) throw new Error(`missing ${name}`);
  if (food.protein !== protein || food.fiber !== fiber || food.combined !== combined) {
    throw new Error(`${name} rates drifted`);
  }
  return food;
}

const peanutButter = mustFood("Peanut butter", "50.7", "11.4", "62.1");
const popcorn = mustFood("Popcorn kernels", "", "51.3", "");
const peanuts = mustFood("Dry roasted peanuts", "39.8", "13.7", "53.5");
const yogurt = mustFood("Greek yogurt (plain, nonfat)", "27.5", "", "");
const cottage = mustFood("Cottage cheese (4%)", "26.3", "", "");
const tuna = mustFood("Canned tuna (chunk light, in water)", "22.4", "", "");
const carrots = mustFood("Carrots (whole, bagged)", "", "16.1", "");
const milk = mustFood("Whole milk", "28.5", "", "");
mustFood("Sunflower seed kernels", "31.7", "13.1", "44.8");
mustFood("Almonds", "14.8", "8.8", "23.6");

const eggs = rowsFrom("protein-per-dollar-2026.csv").find((row) => row.food === "Eggs (large)");
if (!eggs || eggs.protein_g_per_dollar !== "34.4") throw new Error("eggs rate drifted");
if (proteinByName.has("Eggs (large)") || fiberByName.has("Eggs (large)")) {
  throw new Error("eggs unexpectedly landed on the snack files");
}

const bothCount = foods.filter((food) => food.combined).length;
if (bothCount !== 4) throw new Error(`expected 4 foods on both files, got ${bothCount}`);
const shelfCount = foods.filter((food) => food.storage === "shelf").length;
const fridgeCount = foods.filter((food) => food.storage === "fridge").length;
if (shelfCount !== 15 || fridgeCount !== 6) throw new Error("storage counts drifted");

function fdcHref(id: string) {
  return /^\d+$/.test(id) ? `https://fdc.nal.usda.gov/food-details/${id}/nutrients` : "";
}

const title = "No-Cook Protein and High-Fiber Snacks Cost Explorer";
const description =
  "Filter 15 no-cook protein foods and 10 high-fiber snacks by dorm shelf or fridge, then by protein per dollar, fiber per dollar, or both.";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  author: DATASET_PERSON_CREATOR,
  mainEntity: { "@id": `${pageUrl}#dataset` },
  datePublished: "2026-11-26",
  dateModified: "2026-11-26",
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: `${siteUrl}${chartSrc}`,
    caption: chartAlt,
  },
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": `${pageUrl}#dataset`,
  name: "No-cook protein and high-fiber snack costs",
  description:
    "Fifteen no-cook protein foods and ten high-fiber snacks, with grams per dollar, package price, and a shelf-stable or fridge-ready flag. Four foods appear on both files. Eggs are not one of them.",
  url: pageUrl,
  identifier: `${pageUrl}#dataset`,
  version: DATA_VERSION,
  isAccessibleForFree: true,
  license: DATA_LICENSE_URL,
  creator: DATASET_PERSON_CREATOR,
  publisher: DATASET_ORGANIZATION,
  includedInDataCatalog: { "@id": `${siteUrl}/data/#catalog` },
  keywords: ["no cook protein", "high fiber snacks", "dorm food cost", "protein per dollar", "fiber per dollar"],
  variableMeasured: ["protein grams per dollar", "fiber grams per dollar", "package price (USD)"],
  spatialCoverage: "United States",
  measurementTechnique: `${siteUrl}/methodology/`,
  dateModified: DATA_RELEASE_DATE,
  distribution: FILES.map((file) => ({
    "@type": "DataDownload",
    name: file,
    encodingFormat: "text/csv",
    contentUrl: `${siteUrl}/data/${file}`,
    license: DATA_LICENSE_URL,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Data", item: `${siteUrl}/data/` },
    { "@type": "ListItem", position: 3, name: "No-cook snacks", item: pageUrl },
  ],
};

const linkClass = "underline font-semibold";
const linkStyle = "color:#F29B30;";
const sortedFoods = [...foods].sort(
  (a, b) => Number(b.protein || 0) - Number(a.protein || 0) || Number(b.fiber || 0) - Number(a.fiber || 0) || a.food.localeCompare(b.food),
);
---

<BaseLayout
  title={title}
  description={description}
  image={chartSrc}
  canonicalURL={pageUrl}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[webPageSchema, datasetSchema, breadcrumbSchema]}
>
  <Header />
  <main id="no-cook-snacks" class="ncs-page max-w-5xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/" class={linkClass} style={linkStyle}>Home</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / </span>
      <a href="/data/" class={linkClass} style={linkStyle}>Data</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / No-cook snacks</span>
    </nav>

    <p class="text-sm font-bold uppercase tracking-wider mb-3" style="color:#a85e00;">
      By <a href="/author/david-miller/" class={linkClass} style={linkStyle}>{AUTHOR_NAME}</a>
      <span aria-hidden="true"> · </span>
      {proteinRows.length} protein foods, {fiberRows.length} fiber snacks, v{DATA_VERSION}
    </p>
    <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">
      What Fits on a Dorm Shelf, and What Needs the Fridge
    </h1>
    <p class="text-lg max-w-3xl mb-4" style="color:var(--text-color);">
      Peanut butter leads the no-cook protein file at {peanutButter.protein} g per dollar. Popcorn kernels lead the snack fiber file at {popcorn.fiber} g per dollar. Same kind of question, two different jars, and neither one is a hot plate.
    </p>
    <p class="text-lg max-w-3xl mb-8" style="color:var(--text-color);">
      {shelfCount} foods can live without a fridge. {fridgeCount} want one. Bananas and apples sit in the dorm bucket because a counter is enough. Carrots don't. Eggs (large) are {eggs.protein_g_per_dollar} g of protein per dollar on protein-per-dollar-2026.csv, and they aren't one of these {proteinRows.length} no-cook rows, so this filter can't select them.
    </p>

    <figure class="mb-10">
      <img src={chartSrc} alt={chartAlt} width="1200" height="675" class="w-full h-auto rounded-2xl" />
      <figcaption class="mt-3 text-sm" style="color:var(--muted-color);">
        Not a photograph, and not an AI illustration.
        Bar length is grams per dollar. Orange is protein from no-cook-protein-per-dollar-2026.csv. Slate is fiber from high-fiber-snacks-per-dollar-2026.csv.
        Peanut butter is {peanutButter.protein} g of protein. Popcorn kernels are {popcorn.fiber} g of fiber. Dry roasted peanuts show up twice: {peanuts.protein} g of protein and {peanuts.fiber} g of fiber.
        Greek yogurt is {yogurt.protein}. Cottage cheese is {cottage.protein}. Canned tuna is {tuna.protein}. Carrots are {carrots.fiber} g of fiber.
      </figcaption>
    </figure>

    <section class="mb-12" aria-label="Snack explorer">
      <h2>Filter by where it sits, then by the score</h2>
      <p>
        Protein per dollar is the {proteinRows.length} rows in no-cook-protein-per-dollar-2026.csv. Fiber per dollar is the {fiberRows.length} rows in high-fiber-snacks-per-dollar-2026.csv. Combined is the sum, and only the {bothCount} foods on both files get one. A blank score means that file doesn't list the food. It doesn't mean the grams are zero.
      </p>
      <div class="mode-row" role="group" aria-label="Storage">
        <button type="button" class="mode-button" id="ncs-storage-all" data-storage-choice="all" aria-pressed="true">All storage</button>
        <button type="button" class="mode-button" id="ncs-storage-shelf" data-storage-choice="shelf" aria-pressed="false">Shelf-stable / Dorm</button>
        <button type="button" class="mode-button" id="ncs-storage-fridge" data-storage-choice="fridge" aria-pressed="false">Fridge-ready</button>
      </div>
      <div class="mode-row" role="group" aria-label="Metric">
        <button type="button" class="mode-button" id="ncs-metric-protein" data-metric-choice="protein" aria-pressed="true">Protein per dollar</button>
        <button type="button" class="mode-button" id="ncs-metric-fiber" data-metric-choice="fiber" aria-pressed="false">Fiber per dollar</button>
        <button type="button" class="mode-button" id="ncs-metric-combined" data-metric-choice="combined" aria-pressed="false">Combined</button>
      </div>
      <p id="ncs-result" class="result-box" aria-live="polite">
        Peanut butter: {peanutButter.protein} g of protein per dollar, from a {peanutButter.packageLabel} at ${peanutButter.price}. Shelf-stable. Popcorn kernels aren't on the protein file.
      </p>
      <p class="text-xs" style="color:var(--muted-color);">
        The filter stays in this browser tab. Nothing you click is saved or sent.
      </p>
    </section>

    <section class="mb-12">
      <h2>The {names.length} foods, with the rate each file actually publishes</h2>
      <p>
        Whole milk leads the fridge proteins at {milk.protein} g per dollar. Greek yogurt is {yogurt.protein}, the rotisserie chicken is just under that, and cottage cheese is {cottage.protein}. On the fiber side, carrots are the fridge row at {carrots.fiber} g per dollar. Popcorn kernels at {popcorn.fiber} don't need a cold shelf. They also have no FDC id on the snack row.
      </p>
      <div class="table-wrap">
        <table>
          <caption>
            {proteinRows.length} no-cook protein foods and {fiberRows.length} high-fiber snacks.
            Combined is protein grams per dollar plus fiber grams per dollar, and only when both files list the food.
          </caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Storage</th>
              <th scope="col">Protein g per $1</th>
              <th scope="col">Fiber g per $1</th>
              <th scope="col">Combined</th>
              <th scope="col">Package</th>
              <th scope="col">Record</th>
            </tr>
          </thead>
          <tbody id="ncs-rows">
            {sortedFoods.map((food) => (
              <tr
                data-food={food.food}
                data-storage={food.storage}
                data-protein={food.protein}
                data-fiber={food.fiber}
                data-combined={food.combined}
                data-package={food.packageLabel}
                data-price={food.price}
              >
                <th scope="row">{food.food}</th>
                <td>{food.storageLabel}</td>
                <td>{food.protein || "not listed"}</td>
                <td>{food.fiber || "not listed"}</td>
                <td>{food.combined || "one file only"}</td>
                <td>{food.packageLabel} at ${food.price}</td>
                <td>
                  {fdcHref(food.fdc) ? (
                    <a href={fdcHref(food.fdc)} class={linkClass} style={linkStyle} rel="noopener" target="_blank">FDC {food.fdc}</a>
                  ) : (
                    "no FDC id on this row"
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-4">
      <h2>Where the same snacks get a longer look</h2>
      <p>
        A full no-cook grocery list, not this filter, is the
        <a href="/no-cook-emergency-protein-and-fiber-grocery-list/" class={linkClass} style={linkStyle}>no-cook emergency protein and fiber grocery list</a>.
        Portable protein, eggs included, is
        <a href="/cheapest-high-protein-snacks-and-portable-foods/" class={linkClass} style={linkStyle}>the cheapest high-protein snacks</a>.
        The fiber snack ranking is
        <a href="/cheapest-high-fiber-snacks-per-dollar/" class={linkClass} style={linkStyle}>the cheapest high-fiber snacks per dollar</a>.
        Popcorn against chips, calories and fiber together, is
        <a href="/popcorn-vs-potato-chips-fiber-comparison/" class={linkClass} style={linkStyle}>popcorn versus potato chips</a>.
      </p>
      <p>
        Peanut butter at {peanutButter.protein} g of protein and {peanutButter.fiber} g of fiber is the combined leader at {peanutButter.combined}. Dry roasted peanuts are next at {peanuts.combined}. That's four foods. The other {names.length - bothCount} don't get a blended score, because blending a missing number with a real one is how a ranking starts lying.
      </p>
      <p>
        How a row earns its price is on the
        <a href="/methodology/" class={linkClass} style={linkStyle}>methodology page</a>.
        Daily Life Hacks publishes the files. {AUTHOR_NAME} runs the checks. You're free to reuse the contribution under
        <a href={DATA_LICENSE_URL} class={linkClass} style={linkStyle} rel="license noopener" target="_blank">CC BY 4.0</a>,
        with credit. The catalog date on the data hub stays {DATA_RELEASE_DATE}. This page is the shelf filter.
      </p>
    </section>
  </main>
  <Footer />

  <style is:global>
    .ncs-page h2 { font-size: 1.65rem; line-height: 1.2; font-weight: 700; margin: 0 0 0.7rem; color: var(--heading-color); }
    .ncs-page p { line-height: 1.7; margin: 0.7rem 0; color: var(--text-color); }
    .ncs-page .mode-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1rem 0; }
    .ncs-page .mode-button { border-radius: 999px; padding: 0.55rem 0.9rem; font-weight: 700; background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); }
    .ncs-page .mode-button[aria-pressed="true"] { background: #F29B30; color: #1c1917; border-color: #F29B30; }
    .ncs-page .result-box { font-weight: 700; border-radius: 1rem; padding: 1rem 1.1rem; background: rgba(242,155,48,.10); border: 2px solid #F29B30; color: var(--heading-color); }
    .ncs-page .table-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 1rem; background: var(--card-bg); }
    .ncs-page table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .ncs-page caption { caption-side: bottom; text-align: left; padding: 0.75rem 1rem; color: var(--muted-color); font-size: 0.8rem; }
    .ncs-page th, .ncs-page td { text-align: left; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--border-color); vertical-align: top; }
    .ncs-page th { color: var(--heading-color); }
  </style>

  <script is:inline>
    (function () {
      function boot() {
        var root = document.getElementById('no-cook-snacks');
        if (!root || root.dataset.booted) return;
        root.dataset.booted = '1';
        var storageButtons = Array.prototype.slice.call(root.querySelectorAll('[data-storage-choice]'));
        var metricButtons = Array.prototype.slice.call(root.querySelectorAll('[data-metric-choice]'));
        var result = root.querySelector('#ncs-result');
        var rows = Array.prototype.slice.call(root.querySelectorAll('#ncs-rows tr'));
        var storage = 'all';
        var metric = 'protein';
        function num(value) {
          var parsed = parseFloat(value);
          return isFinite(parsed) ? parsed : 0;
        }
        function labelFor(kind) {
          if (kind === 'protein') return 'protein';
          if (kind === 'fiber') return 'fiber';
          return 'combined protein plus fiber';
        }
        function leader(visible, kind) {
          var best = null;
          visible.forEach(function (row) {
            var value = num(row.dataset[kind]);
            if (!row.dataset[kind]) return;
            if (!best || value > num(best.dataset[kind])) best = row;
          });
          return best;
        }
        function render() {
          storageButtons.forEach(function (button) {
            button.setAttribute('aria-pressed', button.dataset.storageChoice === storage ? 'true' : 'false');
          });
          metricButtons.forEach(function (button) {
            button.setAttribute('aria-pressed', button.dataset.metricChoice === metric ? 'true' : 'false');
          });
          var visible = [];
          rows.forEach(function (row) {
            var storageOk = storage === 'all' || row.dataset.storage === storage;
            var metricOk = metric === 'combined' ? Boolean(row.dataset.combined) : Boolean(row.dataset[metric]);
            var show = storageOk && metricOk;
            row.hidden = !show;
            if (show) visible.push(row);
          });
          var best = leader(visible, metric);
          if (!best) {
            result.textContent = 'No food in this storage bucket is on both files, so the combined score stays blank. Switch to protein per dollar or fiber per dollar. Whole milk and carrots are still in the table when you do.';
            return;
          }
          var sentence = best.dataset.food + ': ' + num(best.dataset[metric]).toFixed(1) + ' g of ' + labelFor(metric) + ' per dollar, from a ' + best.dataset.package + ' at $' + best.dataset.price + '.';
          if (metric === 'combined') {
            sentence += ' That sum is ' + best.dataset.protein + ' g protein plus ' + best.dataset.fiber + ' g fiber. Foods on one file only stay out of this view.';
          } else if (!best.dataset[metric === 'protein' ? 'fiber' : 'protein']) {
            sentence += ' The other file doesn\'t list this food, so the missing score stays blank.';
          }
          sentence += ' ' + visible.length + (visible.length === 1 ? ' food matches' : ' foods match') + ' this filter.';
          result.textContent = sentence;
        }
        storageButtons.forEach(function (button) {
          button.addEventListener('click', function () { storage = button.dataset.storageChoice; render(); });
        });
        metricButtons.forEach(function (button) {
          button.addEventListener('click', function () { metric = button.dataset.metricChoice; render(); });
        });
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
