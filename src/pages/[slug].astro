---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Newsletter from "../components/Newsletter.astro";
import RecipeMetaBar from "../components/RecipeMetaBar.astro";
import RecipeServingScaler from "../components/RecipeServingScaler.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import ArticleTableOfContents from "../components/ArticleTableOfContents.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import OptImage from "../components/OptImage.astro";
import { formatReleaseDate, isReleased } from "../content/release";
import {
  DATASETS,
  DATA_LICENSE_URL,
  DATA_TERMS_URL,
  DATA_VERSION,
  findChartInBody,
} from "../content/datasets";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { buildArticleToc } from "../content/article-toc.mjs";

function inlineMd(text: string): string {
  return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

function durationToIso(value?: string): string | undefined {
  if (!value) return undefined;
  const text = value.toLowerCase();
  const hours = Number(text.match(/(\d+)\s*h(?:ours?)?/)?.[1] ?? 0);
  const minutes = Number(text.match(/(\d+)\s*m(?:in(?:ute)?s?)?/)?.[1] ?? 0);
  const hasExplicitZeroDuration = /\b0\s*(?:h(?:ours?)?|m(?:in(?:ute)?s?)?)\b/.test(text);
  if (!hours && !minutes) return hasExplicitZeroDuration ? "PT0M" : undefined;
  return `PT${hours ? `${hours}H` : ""}${minutes ? `${minutes}M` : ""}`;
}

/**
 * Checkpoint 2 Phase B: build canonical article pages only.
 * Pin destinations / legacy aliases are runtime 301s via
 * public/data/pin-destinations-flat.json + functions/[[path]].js.
 */
export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const tableOfContents = buildArticleToc(headings, article.body ?? "");
const releaseDate = article.data.publishAt ?? article.data.date;
/** True once publishAt (or date) is in the past; drives index/noindex at build time. */
const released = isReleased(article);
/** Future-dated publishAt only: show gate + noindex until released (next deploy after date removes noindex). */
const pendingRelease = Boolean(article.data.publishAt) && !released;
const releaseIso = article.data.publishAt?.toISOString();
const formattedReleaseDate = article.data.publishAt
  ? formatReleaseDate(article.data.publishAt)
  : null;
const publishedDate = releaseDate.toISOString();

const isRecipe =
  article.data.category === "recipes" &&
  article.data.ingredients &&
  article.data.steps;

/**
 * Google lists `recipeCategory` and `recipeCuisine` as recommended Recipe
 * properties and no article declares them. Rather than invent a value, derive
 * one ONLY from an explicit authored tag — the tag is the author's own claim
 * about the dish. Anything without a matching tag emits nothing.
 */
const MEAL_TYPE_BY_TAG: Record<string, string> = {
  breakfast: "Breakfast",
  brunch: "Brunch",
  lunch: "Lunch",
  dinner: "Dinner",
  dinners: "Dinner",
  supper: "Dinner",
  dessert: "Dessert",
  desserts: "Dessert",
  snack: "Snack",
  snacks: "Snack",
  appetizer: "Appetizer",
  appetizers: "Appetizer",
  "side dish": "Side Dish",
  "side dishes": "Side Dish",
  sides: "Side Dish",
  salad: "Salad",
  salads: "Salad",
  soup: "Soup",
  soups: "Soup",
  "main course": "Main Course",
  drinks: "Beverage",
  beverages: "Beverage",
  smoothies: "Beverage",
  bread: "Bread",
  breads: "Bread",
};

const CUISINE_BY_TAG: Record<string, string> = {
  mexican: "Mexican",
  italian: "Italian",
  asian: "Asian",
  mediterranean: "Mediterranean",
  american: "American",
  indian: "Indian",
  thai: "Thai",
  greek: "Greek",
  chinese: "Chinese",
  japanese: "Japanese",
  french: "French",
  korean: "Korean",
  "middle eastern": "Middle Eastern",
  "tex-mex": "Tex-Mex",
  southern: "Southern",
  filipino: "Filipino",
  spanish: "Spanish",
};

const normalizedTags = (article.data.tags ?? []).map((t: string) =>
  t.trim().toLowerCase(),
);
const firstMatch = (map: Record<string, string>) => {
  for (const tag of normalizedTags) if (map[tag]) return map[tag];
  return undefined;
};
const recipeCategory = article.data.recipeCategory ?? firstMatch(MEAL_TYPE_BY_TAG);
const recipeCuisine = article.data.recipeCuisine ?? firstMatch(CUISINE_BY_TAG);

const siteUrl = "https://www.daily-life-hacks.com";
const articleUrl = `${siteUrl}/${article.id}/`;
const webPageId = `${articleUrl}#webpage`;
const articleEntityId = `${articleUrl}#${isRecipe ? "recipe" : "article"}`;
const breadcrumbId = `${articleUrl}#breadcrumb`;
const imageUrl = article.data.image.startsWith("http")
  ? article.data.image
  : `${siteUrl}${article.data.image}`;
const hasArticleImage =
  article.data.image.startsWith("http") ||
  existsSync(join(process.cwd(), "public", article.data.image.replace(/^\/+/, "")));
const ingredientsImagePath = `/images/${article.id}-ingredients.jpg`;
const hasIngredientsImage = existsSync(
  join(process.cwd(), "public", ingredientsImagePath.replace(/^\/+/, "")),
);
const ingredientsImageUrl = `${siteUrl}${ingredientsImagePath}`;
const structuredImageUrls = [
  ...(hasArticleImage ? [imageUrl] : []),
  ...(hasIngredientsImage ? [ingredientsImageUrl] : []),
];
const modifiedDateObj = article.data.dateModified ?? releaseDate;
const modifiedDate = modifiedDateObj.toISOString();

/**
 * Freshness is one of the strongest measured correlates of AI citation, and an
 * extractor reads the page text, not the JSON-LD. Both dates therefore have to
 * be VISIBLE and machine-readable in the body, not schema-only.
 */
const longDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
const isoDay = (d: Date) => d.toISOString().slice(0, 10);
const publishedLabel = longDate(releaseDate);
const modifiedLabel = longDate(modifiedDateObj);
const wasUpdated = modifiedLabel !== publishedLabel;

const publisherSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "Daily Life Hacks",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/logo.png`,
  },
};

const authorName = article.data.author ?? "David Miller";
const articleAuthor = authorName === "Daily Life Hacks Team"
  ? {
      "@type": "Organization",
      name: authorName,
      url: `${siteUrl}/about/`,
    }
  : {
      "@type": "Person",
      "@id": `${siteUrl}/about/#david-miller`,
      name: authorName,
      url: `${siteUrl}/about/`,
    };

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": breadcrumbId,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    {
      "@type": "ListItem",
      position: 2,
      name:
        article.data.category === "recipes"
          ? "Recipes"
          : article.data.category === "tips"
            ? "Tips"
            : "Nutrition",
      item: `${siteUrl}/${article.data.category}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: article.data.title,
      item: articleUrl,
    },
  ],
};

const jsonLd = isRecipe
  ? {
      "@context": "https://schema.org",
      "@type": "Recipe",
      "@id": articleEntityId,
      mainEntityOfPage: { "@id": webPageId },
      isPartOf: { "@id": webPageId },
      url: articleUrl,
      name: article.data.title,
      headline: article.data.title,
      description: article.data.excerpt,
      image: structuredImageUrls.length ? structuredImageUrls : undefined,
      thumbnailUrl: hasArticleImage ? imageUrl : undefined,
      inLanguage: "en-US",
      datePublished: publishedDate,
      dateModified: modifiedDate,
      prepTime: durationToIso(article.data.prepTime),
      cookTime: durationToIso(article.data.cookTime),
      totalTime: durationToIso(article.data.totalTime),
      recipeYield: article.data.servings
        ? `${article.data.servings} servings`
        : undefined,
      recipeCategory,
      recipeCuisine,
      nutrition: article.data.calories
        ? {
            "@type": "NutritionInformation",
            calories: `${article.data.calories} calories`,
          }
        : undefined,
      keywords: article.data.tags?.join(", "),
      recipeIngredient: article.data.ingredients,
      recipeInstructions: article.data.steps?.map(
        (step: string, i: number) => {
          const plain = step.replace(/\*\*(.+?)\*\*/g, '$1');
          const firstSentence = plain.split(/\.\s/)[0];
          return {
            "@type": "HowToStep",
            position: i + 1,
            name: firstSentence.length > 80 ? firstSentence.slice(0, 77) + "..." : firstSentence,
            text: plain,
            url: `${articleUrl}#step-${i + 1}`,
          };
        },
      ),
      author: articleAuthor,
      publisher: publisherSchema,
      publishingPrinciples: `${siteUrl}/editorial-policy/`,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": articleEntityId,
      mainEntityOfPage: { "@id": webPageId },
      isPartOf: { "@id": webPageId },
      url: articleUrl,
      headline: article.data.title,
      name: article.data.title,
      description: article.data.excerpt,
      image: structuredImageUrls.length ? structuredImageUrls : undefined,
      thumbnailUrl: hasArticleImage ? imageUrl : undefined,
      inLanguage: "en-US",
      keywords: article.data.tags?.join(", "),
      datePublished: publishedDate,
      dateModified: modifiedDate,
      author: articleAuthor,
      publisher: publisherSchema,
      publishingPrinciples: `${siteUrl}/editorial-policy/`,
    };



const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": webPageId,
  url: articleUrl,
  name: article.data.title,
  description: article.data.excerpt,
  inLanguage: "en-US",
  datePublished: publishedDate,
  dateModified: modifiedDate,
  breadcrumb: { "@id": breadcrumbId },
  primaryImageOfPage: structuredImageUrls.length
    ? { "@type": "ImageObject", url: structuredImageUrls[0] }
    : undefined,
  mainEntity: { "@id": articleEntityId },
  /** Resolves because BaseLayout emits the #website node on every page. */
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
};

const allSchemas: any[] = [webPageSchema, jsonLd, breadcrumbSchema];

const dataset = DATASETS[article.id];
if (dataset) {
  allSchemas.push({
    "@context": "https://schema.org",
    "@type": "Dataset",
    "@id": `${articleUrl}#dataset`,
    name: dataset.name,
    /** The coined index name (method #60), so mentions stay attributable. */
    ...(dataset.alternateName ? { alternateName: dataset.alternateName } : {}),
    description: dataset.description,
    url: articleUrl,
    identifier: `${articleUrl}#dataset`,
    version: DATA_VERSION,
    isAccessibleForFree: true,
    creator: publisherSchema,
    publisher: publisherSchema,
    /**
     * Defined inline, not a bare `{"@id": ...}` pointer. Google resolves @id
     * per page: the DataCatalog node only exists on /data/, so a pointer alone
     * dangles on all 22 study pages and Dataset Search sees no catalog.
     */
    includedInDataCatalog: {
      "@type": "DataCatalog",
      "@id": `${siteUrl}/data/#catalog`,
      name: "Daily Life Hacks Food Value Data",
      url: `${siteUrl}/data/`,
      publisher: { "@id": `${siteUrl}/#organization` },
    },
    license: DATA_LICENSE_URL,
    usageInfo: DATA_TERMS_URL,
    datePublished: publishedDate,
    dateModified: modifiedDate,
    keywords: article.data.tags?.join(", "),
    variableMeasured: dataset.variables,
    temporalCoverage: dataset.temporal,
    spatialCoverage: "United States",
    measurementTechnique: `${siteUrl}/methodology/`,
    distribution: {
      "@type": "DataDownload",
      name: dataset.csv.split("/").pop(),
      encodingFormat: "text/csv",
      contentUrl: `${siteUrl}${dataset.csv}`,
    },
  });
}

/**
 * Embeddable chart (growth method #18). Data studies with a chart get a
 * standalone /embed/{slug}/ page plus a copy-paste snippet here.
 *
 * The snippet deliberately keeps the credit `<a>` OUTSIDE the iframe: iframe
 * `src` passes no link equity, the visible anchor does. Do not "simplify"
 * the snippet by dropping the paragraph.
 */
const chart = dataset ? findChartInBody(article.body ?? "") : null;
const embedUrl = `${siteUrl}/embed/${article.id}/`;
const embedSnippet = chart
  ? `<iframe src="${embedUrl}" width="100%" height="520" style="border:0" loading="lazy" title="${dataset!.name.replace(/"/g, "&quot;")}"></iframe>\n<p>Chart: <a href="${articleUrl}">Daily Life Hacks</a> - free to reuse with credit</p>`
  : null;

/**
 * "Cite this dataset" block (growth method #3).
 *
 * People already want to cite the numbers; without a ready string they invent a
 * mangled one or skip the link. This hands them the exact wording, with the
 * absolute URL, so the citation lands correctly and points at the study page
 * (where the caveats live) rather than at a naked CSV.
 */
const citationYear = releaseDate.getFullYear();
const citationText = dataset
  ? `Daily Life Hacks. "${dataset.name}." ${citationYear}. ${articleUrl}. Please credit Daily Life Hacks with a link.`
  : null;

const citationCopyScript = `(function(){
  var btn = document.getElementById("citation-copy-btn");
  var box = document.getElementById("citation-text");
  if (!btn || !box) return;
  btn.addEventListener("click", function () {
    var label = btn.textContent;
    var done = function () {
      btn.textContent = "Copied";
      setTimeout(function () { btn.textContent = label; }, 2000);
    };
    var fallback = function () {
      box.focus();
      box.select();
      try { document.execCommand("copy"); done(); } catch (e) {}
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(box.value).then(done, fallback);
    } else {
      fallback();
    }
  });
})();`;

const embedCopyScript = `(function(){
  var btn = document.getElementById("embed-copy-btn");
  var box = document.getElementById("embed-snippet");
  var block = document.getElementById("embed-block");
  var status = document.getElementById("embed-copy-status");
  var datasetId = ${JSON.stringify(article.id)};
  if (!btn || !box || !block) return;

  function trackCopy() {
    if (typeof window.gtag !== "function") return;
    window.gtag("event", "chart_embed_code_copied", {
      dataset_id: datasetId,
      interaction_type: "copy_code",
      source_page: location.pathname
    });
  }

  // The chart is rendered from markdown, so the block cannot be authored next
  // to it server-side. Move it there on load; without JS it stays at the end
  // of the article, which is still a valid place for it.
  var chart = document.querySelector('.article-content img[src*="-chart.jpg"]');
  if (chart) {
    var anchor = chart.closest("figure, p") || chart;
    if (anchor.parentNode) {
      anchor.parentNode.insertBefore(block, anchor.nextSibling);
      block.classList.add("mb-8");
    }
  }

  btn.addEventListener("click", function () {
    var label = btn.textContent;
    var done = function () {
      btn.textContent = "Copied";
      if (status) status.textContent = "Embed code copied.";
      trackCopy();
      setTimeout(function () { btn.textContent = label; }, 2000);
    };
    var fallback = function () {
      box.focus();
      box.select();
      try {
        if (document.execCommand("copy")) {
          done();
        } else if (status) {
          status.textContent = "Copy failed. Select the code and copy it manually.";
        }
      } catch (e) {
        if (status) status.textContent = "Copy failed. Select the code and copy it manually.";
      }
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(box.value).then(done, fallback);
    } else {
      fallback();
    }
  });
})();`;

if (article.data.faq && article.data.faq.length > 0) {
  allSchemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${articleUrl}#faq`,
    isPartOf: { "@id": webPageId },
    mainEntity: article.data.faq.map((item: any) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}

const currentSlug = Astro.params.slug;
/** Built pages are canonical-only (CP2 Phase B); keep guard if path ever drifts. */
const isVariant = Boolean(currentSlug && currentSlug !== article.id);
const robotsMeta = (!released || isVariant) ? "noindex, follow" : undefined;
/** Do not advertise rich-result entities for hidden or non-canonical pages. */
const publishedSchemas = released && !isVariant ? allSchemas : undefined;
---

<BaseLayout
  title={article.data.title}
  description={article.data.excerpt}
  image={hasArticleImage ? article.data.image : "/logo.png"}
  canonicalURL={articleUrl}
  jsonLd={publishedSchemas}
  robots={robotsMeta}
  ogType="article"
>
  <Header />
  <main
    class="max-w-3xl mx-auto px-4 py-10 flex flex-col"
    data-base-slug={article.id}
    data-article-title={article.data.title}
    data-release-root={pendingRelease ? "true" : "false"}
    data-release-at={pendingRelease ? releaseIso : undefined}
  >
    <!-- Breadcrumb -->
    <nav class="mb-6 flex flex-col gap-4 relative z-10">
      <div
        class="text-sm flex items-center gap-1 flex-wrap"
        style="color: var(--muted-color);"
      >
        <a href="/" class="hover:text-[#F29B30] transition-colors">Home</a>
        <span>/</span>
        <a
          href={`/${article.data.category}/`}
          class="hover:text-[#F29B30] capitalize transition-colors"
          >{article.data.category}</a
        >
        <span>/</span>
        <span
          class="truncate max-w-[200px] md:max-w-none"
          style="color: var(--text-color);">{article.data.title}</span
        >
      </div>
    </nav>

    {
      pendingRelease && (
        <section
          id="release-notice"
          class="mb-8 rounded-2xl border p-5"
          style="background-color: var(--card-bg); border-color: var(--border-color);"
        >
          <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color: #F29B30;">
            Scheduled Release
          </p>
          <h2 class="text-2xl font-bold mb-2" style="color: var(--heading-color);">
            This post unlocks on {formattedReleaseDate}
          </h2>
          <p class="text-sm leading-relaxed" style="color: var(--muted-color);">
            The page is already prepared. It will become visible automatically on the release date.
          </p>
        </section>
      )
    }

    <div id="release-content" style={pendingRelease ? "display: none;" : undefined}>

    <!-- Featured Image — top of article -->
    {hasArticleImage && (() => {
      const featuredPageUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
      const featuredMediaUrl = new URL(article.data.image, Astro.site || Astro.url.origin).href;
      const featuredDesc = `${article.data.title} - ${article.data.excerpt} | Daily Life Hacks`;
      const featuredPinBuilderUrl = `https://www.pinterest.com/pin-builder/?media=${encodeURIComponent(featuredMediaUrl)}&url=${encodeURIComponent(featuredPageUrl)}&is_video=false&description=${encodeURIComponent(featuredDesc)}&method=bookmarklet`;
      return (
        <div class="relative mb-8 group rounded-2xl overflow-hidden shadow-md">
          <OptImage
            src={article.data.image}
            alt={article.data.imageAlt}
            width={768}
            height={432}
            sizes="(max-width: 768px) 100vw, 768px"
            fetchpriority="high"
            loading="eager"
            decoding="sync"
            data-pin-description={featuredDesc}
            data-pin-url={featuredPageUrl}
            data-pin-media={featuredMediaUrl}
            data-pin-nopin="true"
            class="w-full aspect-video object-cover"
          />
          <a
            href={featuredPinBuilderUrl}
            target="_blank"
            rel="noopener nofollow"
            aria-label="Save to Pinterest"
            title="Save to Pinterest"
            class="dlh-pin-save absolute top-4 right-4 z-10 inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold text-white shadow-md hover:shadow-lg transition-all duration-200"
            style="background-color: #E60023;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.94-.2-2.4.04-3.43.22-.93 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.2.6 2.17 1.78 2.17 2.14 0 3.78-2.26 3.78-5.52 0-2.88-2.07-4.9-5.03-4.9-3.43 0-5.44 2.57-5.44 5.23 0 1.04.4 2.15.9 2.76.1.11.11.21.08.33l-.34 1.37c-.05.22-.17.27-.4.16-1.48-.7-2.4-2.86-2.4-4.6 0-3.75 2.72-7.19 7.84-7.19 4.12 0 7.32 2.94 7.32 6.87 0 4.09-2.58 7.39-6.17 7.39-1.2 0-2.33-.62-2.72-1.36l-.74 2.83c-.27 1.04-1 2.34-1.49 3.14A12 12 0 1 0 12 0Z"/>
            </svg>
            <span>Save</span>
          </a>
        </div>
      );
    })()}

    <!-- Article Header -->
    <header class="mb-8">
      <span
        class="inline-block px-3 py-1 text-xs font-bold rounded uppercase tracking-widest mb-4 text-white"
        style="background-color: #F29B30;"
      >
        {article.data.category}
      </span>
      <h1
        class="text-3xl md:text-4xl font-bold leading-tight mb-4"
        style="color: var(--heading-color);"
      >
        {article.data.title}
      </h1>
      <p class="text-lg leading-relaxed" style="color: var(--muted-color);">
        {article.data.excerpt}
      </p>
      <p
        class="text-sm mt-3 flex items-center gap-2"
        style="color: var(--label-color);"
      >
        {
          article.data.author && (
            <>
              <a
                href="/about/"
                rel="author"
                class="font-medium text-[var(--text-color)] hover:text-[#F29B30] transition-colors"
              >
                {article.data.author}
              </a>
              <span>•</span>
            </>
          )
        }
        <span>
          Published <time datetime={isoDay(releaseDate)}>{publishedLabel}</time>
        </span>
        {
          wasUpdated && (
            <>
              <span>&bull;</span>
              <span>
                Updated{" "}
                <time datetime={isoDay(modifiedDateObj)} class="font-medium">
                  {modifiedLabel}
                </time>
              </span>
            </>
          )
        }
      </p>
      {
        dataset && (
          <p class="text-sm mt-2 leading-relaxed" style="color: var(--label-color);">
            Source: Daily Life Hacks {dataset.name} ({dataset.rows} rows,
            prices observed {dataset.temporal}, United States). Nutrition values
            from USDA FoodData Central. Full{" "}
            <a href="/methodology/" class="underline">methodology</a> and the{" "}
            <a href={dataset.csv} class="underline">raw CSV</a> are public.
          </p>
        )
      }
    </header>

    <!-- Quick Answer Block -->
    {article.data.quickAnswer && (
      <div class="mb-8 rounded-xl border-l-4 border-[#F29B30] p-5" style="background-color: var(--input-bg);">
