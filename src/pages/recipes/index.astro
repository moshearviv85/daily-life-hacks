---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryTopicHub from "../../components/CategoryTopicHub.astro";
import { getCollection } from "astro:content";
import { isReleased } from "../../content/release";
import {
  CATEGORY_HUB_BY_CATEGORY,
  assembleHub,
  itemListSchema,
} from "../../content/category-hubs";

const hub = CATEGORY_HUB_BY_CATEGORY.get("recipes")!;
const allArticles = await getCollection("articles");
const records = allArticles
  .filter((article) => isReleased(article))
  .map((article) => ({
    slug: article.id,
    title: article.data.title,
    category: article.data.category,
  }));
const { topics, alphabetical } = assembleHub(hub, records);

const title = "Easy Recipes With Adjustable Servings | Daily Life Hacks";
const description = hub.intro;
const categoryUrl = "https://www.daily-life-hacks.com/recipes/";
const listName = "Easy Recipes With Adjustable Servings";
const itemList = itemListSchema(`${categoryUrl}#item-list`, listName, alphabetical);
const topicLists = topics.map((topic) =>
  itemListSchema(`${categoryUrl}#${topic.id}`, topic.title, topic.articles),
);
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: listName,
  url: categoryUrl,
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "Daily Life Hacks",
    url: "https://www.daily-life-hacks.com/",
  },
  mainEntity: { "@id": `${categoryUrl}#item-list` },
};
---

<BaseLayout title={title} description={description} jsonLd={[collectionPageSchema, itemList, ...topicLists]}>
  <Header />
  <div class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--heading-color)]">
        Recipes
      </h1>
      <p class="text-xl max-w-2xl mx-auto" style="color: var(--muted-color);">
        {description}
      </p>
    </header>

    <aside
      class="mb-10 rounded-2xl p-5 md:p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
      style="background:rgba(242,155,48,.09);border:1px solid rgba(242,155,48,.35);"
    >
      <div>
        <h2 class="text-xl font-bold mb-1" style="color:var(--heading-color);">
          Cooking for two instead of six?
        </h2>
        <p style="color:var(--text-color);">
          Open any recipe and change the servings inside the ingredient card. The cups, cans, and tablespoons update before dinner turns into a fraction worksheet.
        </p>
      </div>
      <span class="shrink-0 rounded-full px-4 py-2 text-sm font-bold text-white" style="background:#F29B30;">
        All {alphabetical.length} recipes scale
      </span>
    </aside>

    <p class="mb-10 text-base sm:text-lg leading-relaxed max-w-3xl" style="color: var(--text-color);">
      Discard grams, dried-bean conversions, and recipe cost each have a calculator on the
      <a
        href="/tools/"
        class="font-bold underline underline-offset-4 decoration-[#F29B30]"
        style="color:#F29B30;"
      >tools page</a>.
    </p>

    <CategoryTopicHub topics={topics} articles={alphabetical} />
  </div>
  <Footer />
</BaseLayout>
