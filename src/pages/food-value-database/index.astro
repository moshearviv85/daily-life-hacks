---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DataProvenance from "../../components/DataProvenance.astro";
import dataIndex from "../../../public/data/api-index-v1.json";
import { DATA_RELEASE_DATE, DATA_VERSION } from "../../content/datasets";

type SourceRow = {
  dataset: string;
  food: string;
  category: string;
  package: string | null;
  price_basis: string | null;
  fields: Record<string, string | number | null>;
};

type FoodRow = {
  id: string;
  food: string;
  category: string;
  package: string;
  packagePrice: number | null;
  pricePer100g: number | null;
  priceBasis: string;
  proteinPer100g: number | null;
  fiberPer100g: number | null;
  proteinPerDollar: number | null;
  fiberPerDollar: number | null;
  proteinMeasured: boolean;
  fiberMeasured: boolean;
};

const sourceRows = (dataIndex.rows as SourceRow[]).filter((row) =>
  row.dataset === "fiber-per-dollar-2026" || row.dataset === "protein-per-dollar-2026"
);

const broadCategory = (sourceCategory: string, food: string) => {
  const category = sourceCategory.toLowerCase();
  const name = food.toLowerCase();

  if (
    category.includes("beans") ||
    category.includes("lentils") ||
    category.includes("peas") ||
    (category === "canned" && /(bean|chickpea)/.test(name))
  ) return "Beans and legumes";
  if (category.includes("fruit")) return "Fruit";
  if (category.includes("vegetable") || (category === "canned" && name.includes("pumpkin"))) {
    return "Vegetables";
  }
  if (category.includes("grain") || category.includes("pantry")) return "Grains and pantry";
  if (category.includes("nuts") || category.includes("seeds")) return "Nuts and seeds";
  if (category.includes("eggs") || category.includes("dairy")) return "Dairy and eggs";
  if (category.includes("fish")) return "Fish and seafood";
  if (category.includes("meat") || category.includes("poultry")) return "Meat and poultry";
  if (category.includes("soy") || category.includes("plant proteins")) return "Plant proteins";
  return "Other";
};

const numberOrNull = (value: unknown) => {
  const parsed = Number(value);
  return value === "" || value === null || value === undefined || !Number.isFinite(parsed)
    ? null
    : parsed;
};

const byFood = new Map<string, FoodRow>();

for (const row of sourceRows) {
  const key = row.food.trim().toLowerCase();
  const existing = byFood.get(key) ?? {
    id: key.replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
    food: row.food,
    category: broadCategory(row.category, row.food),
    package: row.package ?? String(row.fields.package ?? ""),
    packagePrice: numberOrNull(row.fields.package_price_usd),
    pricePer100g: numberOrNull(row.fields.price_per_100g_usd),
    priceBasis: row.price_basis ?? String(row.fields.price_basis ?? ""),
    proteinPer100g: null,
    fiberPer100g: null,
    proteinPerDollar: null,
    fiberPerDollar: null,
    proteinMeasured: false,
    fiberMeasured: false,
  };

  if (row.dataset === "protein-per-dollar-2026") {
    existing.proteinPer100g = numberOrNull(row.fields.protein_g_per_100g);
    existing.proteinPerDollar = numberOrNull(row.fields.protein_g_per_dollar);
    existing.proteinMeasured = true;
  }
  if (row.dataset === "fiber-per-dollar-2026") {
    existing.fiberPer100g = numberOrNull(row.fields.fiber_g_per_100g);
    existing.fiberPerDollar = numberOrNull(row.fields.fiber_g_per_dollar);
    existing.fiberMeasured = true;
  }

  byFood.set(key, existing);
}

const foods = Array.from(byFood.values()).sort((a, b) => a.food.localeCompare(b.food));
const categories = Array.from(new Set(foods.map((food) => food.category))).sort();
const proteinRowCount = sourceRows.filter((row) => row.dataset === "protein-per-dollar-2026").length;
const fiberRowCount = sourceRows.filter((row) => row.dataset === "fiber-per-dollar-2026").length;
const bothCount = foods.filter((food) => food.proteinMeasured && food.fiberMeasured).length;
const serializedFoods = JSON.stringify(foods).replace(/</g, "\\u003c");

const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}/food-value-database/`;
const title = `Food Value Database: Compare ${foods.length} Grocery Foods`;
const description =
  `Search ${foods.length} grocery foods by price, protein, fiber, and grams per dollar. Compare up to four foods using our July 2026 US price data.`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#webpage`,
    name: title,
    url: pageUrl,
    description,
    inLanguage: "en-US",
    dateModified: DATA_RELEASE_DATE,
    isPartOf: { "@id": `${siteUrl}/#website` },
    publisher: { "@id": `${siteUrl}/#organization` },
    breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    about: [
      { "@type": "Thing", name: "Grocery prices" },
      { "@type": "Thing", name: "Protein per dollar" },
      { "@type": "Thing", name: "Fiber per dollar" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Food Value Database", item: pageUrl },
    ],
  },
];

const metric = (value: number | null, suffix = "g") =>
  value === null ? null : `${value.toFixed(1)}${suffix}`;
---

<BaseLayout title={title} description={description} canonicalURL={pageUrl} jsonLd={schemas}>
  <Header />
  <main class="max-w-7xl mx-auto px-4 py-12 md:py-16">
    <nav class="text-sm mb-6" style="color:var(--muted-color);" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#F29B30] transition-colors">Home</a>
      <span aria-hidden="true" class="mx-1">/</span>
      <span style="color:var(--text-color);">Food Value Database</span>
    </nav>

    <section class="max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] mb-3" style="color:#F29B30;">
        {foods.length} foods. Two audited rankings. One useful table.
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-5" style="color:var(--heading-color);">
        Search Grocery Foods by Price, Protein, Fiber, and Value
      </h1>
      <p class="text-xl leading-relaxed" style="color:var(--text-color);">
        This database compares {foods.length} unique grocery foods from our July 2026 US price
        snapshot. Search lentils, yogurt, broccoli, or the bag of flour quietly winning two
        rankings, then put up to four foods side by side.
      </p>
      <p class="mt-4 leading-relaxed" style="color:var(--muted-color);">
        It combines {fiberRowCount} fiber-study rows with {proteinRowCount} protein-study rows.
        {bothCount} foods appear in both studies, so those get both nutrient columns. A blank
        measurement isn't secretly zero. It means that food wasn't measured in that ranking.
        Spreadsheets are already bossy enough without making up numbers.
      </p>
    </section>

    <section class="grid sm:grid-cols-3 gap-4 my-9" aria-label="Database coverage">
      <article class="coverage-card">
        <strong>{foods.length}</strong>
        <span>unique foods with recorded prices</span>
      </article>
      <article class="coverage-card">
        <strong>{bothCount}</strong>
        <span>foods measured for both nutrients</span>
      </article>
      <article class="coverage-card">
        <strong>July 2026</strong>
        <span>US national price snapshot</span>
      </article>
    </section>

    <section
      id="food-value-database-app"
      class="rounded-2xl border p-4 md:p-6"
      style="background:var(--card-bg);border-color:var(--border-color);"
      aria-labelledby="database-controls-heading"
    >
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-5">
        <div>
          <h2 id="database-controls-heading" class="text-2xl md:text-3xl font-bold" style="color:var(--heading-color);">
            Find the Food Before the Table Wins
          </h2>
          <p class="mt-1 text-sm" style="color:var(--muted-color);">
            Search and filters stay in this browser tab. Analytics records the action and result
            count, never the words you type or the foods you compare.
          </p>
        </div>
        <button id="fvd-reset" type="button" class="reset-button">Clear filters</button>
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4" role="search">
        <div>
          <label class="control-label" for="fvd-search">Search foods</label>
          <input
            id="fvd-search"
            class="control-input"
            type="search"
            placeholder="Try lentils, yogurt, or broccoli"
            autocomplete="off"
          />
        </div>
        <div>
          <label class="control-label" for="fvd-category">Grocery category</label>
          <select id="fvd-category" class="control-input">
            <option value="all">All categories</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </div>
        <div>
          <label class="control-label" for="fvd-coverage">Measured data</label>
          <select id="fvd-coverage" class="control-input">
            <option value="all">Any measured value</option>
            <option value="both">Both protein and fiber</option>
            <option value="protein">Protein measured</option>
            <option value="fiber">Fiber measured</option>
          </select>
        </div>
        <div>
          <label class="control-label" for="fvd-sort">Sort by</label>
          <select id="fvd-sort" class="control-input">
            <option value="food-asc">Food name, A to Z</option>
            <option value="pricePer100g-asc">Price per 100g, lowest first</option>
            <option value="packagePrice-asc">Package price, lowest first</option>
            <option value="proteinPer100g-desc">Protein per 100g, highest first</option>
            <option value="fiberPer100g-desc">Fiber per 100g, highest first</option>
            <option value="proteinPerDollar-desc">Protein per $1, highest first</option>
            <option value="fiberPerDollar-desc">Fiber per $1, highest first</option>
          </select>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 my-5">
        <p id="fvd-result-count" class="font-bold" style="color:var(--heading-color);" aria-live="polite">
          Showing all {foods.length} foods.
        </p>
        <p class="text-sm" style="color:var(--muted-color);">
          Select 2 to 4 foods for one honest side-by-side comparison.
        </p>
      </div>

      <section id="fvd-compare" class="compare-panel" aria-labelledby="fvd-compare-heading" hidden>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <h3 id="fvd-compare-heading" class="text-xl font-bold" style="color:var(--heading-color);">
              Your Comparison
            </h3>
            <p id="fvd-compare-help" class="text-sm" style="color:var(--muted-color);">
              Add one more food to make this a comparison.
            </p>
          </div>
          <button id="fvd-clear-compare" type="button" class="reset-button">Clear comparison</button>
        </div>
        <div id="fvd-compare-table" class="overflow-x-auto"></div>
      </section>

      <p id="fvd-empty" class="empty-state" hidden>
        Nothing matches those filters. The spreadsheet checked twice and still couldn't find it.
        Clear a filter or try a broader food name.
      </p>

      <div id="fvd-table-wrap" class="relative overflow-x-auto rounded-xl border" style="border-color:var(--border-color);">
        <table id="fvd-table" class="food-table">
          <caption>
            {foods.length} unique grocery foods from the Daily Life Hacks fiber-per-dollar and
            protein-per-dollar studies, with July 2026 US price data.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="sticky-food">Food</th>
              <th scope="col">Category</th>
              <th scope="col" class="number-cell">Package price</th>
              <th scope="col" class="number-cell">Price / 100g</th>
              <th scope="col" class="number-cell">Protein / 100g</th>
              <th scope="col" class="number-cell">Fiber / 100g</th>
              <th scope="col" class="number-cell">Protein / $1</th>
              <th scope="col" class="number-cell">Fiber / $1</th>
              <th scope="col">Compare</th>
            </tr>
          </thead>
          <tbody id="fvd-tbody">
            {foods.map((food) => (
              <tr
                data-food-id={food.id}
                data-search={`${food.food} ${food.category}`.toLowerCase()}
                data-category={food.category}
                data-protein={String(food.proteinMeasured)}
                data-fiber={String(food.fiberMeasured)}
                data-price-per-100g={food.pricePer100g ?? ""}
                data-package-price={food.packagePrice ?? ""}
                data-protein-per-100g={food.proteinPer100g ?? ""}
                data-fiber-per-100g={food.fiberPer100g ?? ""}
                data-protein-per-dollar={food.proteinPerDollar ?? ""}
                data-fiber-per-dollar={food.fiberPerDollar ?? ""}
              >
                <th scope="row" class="sticky-food">
                  <span class="block font-bold">{food.food}</span>
                  <span class="block package-note">{food.package || "Package not recorded"}</span>
                  <span class="block source-note">Price basis: {food.priceBasis || "See source CSV"}</span>
                </th>
                <td>{food.category}</td>
                <td class="number-cell">{food.packagePrice === null ? <span class="not-measured">Not measured</span> : `$${food.packagePrice.toFixed(2)}`}</td>
                <td class="number-cell">{food.pricePer100g === null ? <span class="not-measured">Not measured</span> : `$${food.pricePer100g.toFixed(2)}`}</td>
                <td class="number-cell">{metric(food.proteinPer100g) ?? <span class="not-measured">Not measured</span>}</td>
                <td class="number-cell">{metric(food.fiberPer100g) ?? <span class="not-measured">Not measured</span>}</td>
                <td class="number-cell value-cell">{metric(food.proteinPerDollar) ?? <span class="not-measured">Not measured</span>}</td>
                <td class="number-cell value-cell">{metric(food.fiberPerDollar) ?? <span class="not-measured">Not measured</span>}</td>
                <td>
                  <button
                    type="button"
                    class="compare-button"
                    data-compare-food={food.id}
                    aria-pressed="false"
                    aria-label={`Add ${food.food} to comparison`}
                  >
                    Add
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <script id="fvd-data" type="application/json" set:html={serializedFoods}></script>
    </section>

    <section class="grid lg:grid-cols-2 gap-6 mt-10">
      <article class="info-card">
        <h2>What does “value” mean in this database?</h2>
        <p>
          Protein per dollar and fiber per dollar answer one narrow question: how many measured
          grams does $1 buy at the recorded price? They don't score taste, cooking time, calories,
          or whether you want split peas four nights in a row. Use the
          <a href="/tools/fiber-per-dollar-calculator/">value calculator</a> when you want to turn
          one of these rankings into a weekly target or grocery basket.
        </p>
      </article>
      <article class="info-card">
        <h2>Why are some nutrient cells blank?</h2>
        <p>
          The fiber study follows 53 foods and the protein study follows 49. This directory joins
          exact food names and keeps missing measurements visible instead of borrowing a number
          from somewhere else. “Not measured” means exactly that. It doesn't mean zero, bad, or
          banished from dinner.
        </p>
      </article>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color:var(--heading-color);">
        Read the measured answer, not a mystery score
      </h2>
      <p class="max-w-4xl mb-5" style="color:var(--text-color);">
        The database handles lookup and comparison. These studies and answer pages explain what
        the numbers mean when you actually have to buy breakfast, choose beans, or feed people.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a class="answer-link" href="/fiber-per-dollar-cheapest-high-fiber-foods/">The 53-food fiber-per-dollar study</a>
        <a class="answer-link" href="/protein-per-dollar-cheapest-protein-sources/">The 49-food protein-per-dollar study</a>
        <a class="answer-link" href="/foods-highest-in-protein-per-100-grams/">Which foods have the most protein per 100g?</a>
        <a class="answer-link" href="/which-dried-beans-have-the-most-protein/">Which dried beans have the most protein?</a>
        <a class="answer-link" href="/canned-beans-vs-dried-beans-nutrition/">Canned beans versus dried beans</a>
        <a class="answer-link" href="/how-much-protein-in-oatmeal/">How much protein is in oatmeal?</a>
      </div>
    </section>

    <section class="download-strip">
      <div>
        <h2>Want the rows instead of the interface?</h2>
        <p>
          Download both source files, inspect the assumptions, or use the JSON API. No signup.
          The CSV doesn't need your email address to remember how commas work.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          class="download-button"
          href="/data/fiber-per-dollar-2026.csv"
          download
          data-dataset-download
          data-dataset-id="fiber-per-dollar-2026"
        >Fiber CSV</a>
        <a
          class="download-button"
          href="/data/protein-per-dollar-2026.csv"
          download
          data-dataset-download
          data-dataset-id="protein-per-dollar-2026"
        >Protein CSV</a>
        <a class="download-button secondary" href="/data/">All datasets</a>
        <a class="download-button secondary" href="/api-docs/">API docs</a>
      </div>
    </section>

    <DataProvenance
      datasets={["fiber-per-dollar-2026", "protein-per-dollar-2026"]}
      heading="Where the database gets its numbers"
    />

    <p class="mt-6 text-sm leading-relaxed" style="color:var(--muted-color);">
      Data version {DATA_VERSION}. Nutrition values use USDA FoodData Central. Prices use BLS
      Average Price data where available and dated national retail listings otherwise. Read the
      <a class="text-link" href="/methodology/">methodology and correction policy</a>. This isn't a
      live quote for your store, ZIP code, sale, or package size.
    </p>
  </main>
  <Footer />

  <style>
    .coverage-card{padding:1.1rem 1.25rem;border-radius:1rem;background:var(--card-bg);border:1px solid var(--border-color)}
    .coverage-card strong{display:block;font-size:1.6rem;line-height:1.15;color:#F29B30}
    .coverage-card span{display:block;margin-top:.35rem;font-size:.9rem;color:var(--muted-color)}
    .control-label{display:block;margin-bottom:.4rem;font-size:.82rem;font-weight:700;color:var(--heading-color)}
    .control-input{width:100%;min-height:2.8rem;border-radius:.75rem;padding:.65rem .8rem;background:var(--page-bg);border:1px solid var(--border-color);color:var(--text-color);outline:none}
    .control-input:focus{border-color:#F29B30;box-shadow:0 0 0 3px rgba(242,155,48,.2)}
    .reset-button,.compare-button{border-radius:999px;padding:.55rem .9rem;font-size:.82rem;font-weight:700;color:#a85e00;border:1px solid #F29B30;background:transparent}
    .reset-button:hover,.compare-button:hover,.compare-button[aria-pressed="true"]{background:#F29B30;color:#fff}
    .reset-button:focus-visible,.compare-button:focus-visible{outline:3px solid rgba(242,155,48,.35);outline-offset:2px}
    .compare-button:disabled{cursor:not-allowed;opacity:.45;background:transparent;color:var(--muted-color);border-color:var(--border-color)}
    .compare-panel{margin-bottom:1.25rem;padding:1rem;border-radius:1rem;background:rgba(242,155,48,.08);border:1px solid rgba(242,155,48,.35)}
    .empty-state{padding:1.5rem;text-align:center;border-radius:1rem;background:var(--page-bg);color:var(--muted-color)}
    .food-table{width:100%;min-width:76rem;border-collapse:separate;border-spacing:0;font-size:.83rem}
    .food-table caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .food-table th,.food-table td{padding:.72rem .75rem;text-align:left;border-bottom:1px solid var(--border-color);vertical-align:top;background:var(--card-bg)}
    .food-table thead th{position:sticky;top:0;z-index:3;white-space:nowrap;color:var(--heading-color);background:var(--input-bg)}
    .food-table .sticky-food{position:sticky;left:0;z-index:2;min-width:13rem;max-width:16rem;color:var(--heading-color)}
    .food-table thead .sticky-food{z-index:4;background:var(--input-bg)}
    .food-table .number-cell{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
    .food-table .value-cell{font-weight:700;color:var(--heading-color)}
    .package-note{margin-top:.2rem;font-size:.72rem;font-weight:400;color:var(--muted-color)}
    .source-note{margin-top:.18rem;font-size:.68rem;font-weight:400;line-height:1.3;color:var(--muted-color)}
    .not-measured{font-size:.72rem;font-weight:400;color:var(--muted-color)}
    .info-card{padding:1.25rem;border-radius:1rem;background:var(--card-bg);border:1px solid var(--border-color)}
    .info-card h2{font-size:1.35rem;font-weight:700;color:var(--heading-color)}
    .info-card p{margin-top:.55rem;line-height:1.7;color:var(--text-color)}
    .info-card a,.text-link{font-weight:700;text-decoration:underline;text-decoration-color:#F29B30;text-underline-offset:3px}
    .answer-link{display:block;padding:1rem;border-radius:.9rem;font-weight:700;color:var(--heading-color);background:var(--card-bg);border:1px solid var(--border-color)}
    .answer-link:hover{color:#a85e00;border-color:#F29B30}
    .download-strip{display:flex;flex-direction:column;gap:1rem;margin:3rem 0 1.5rem;padding:1.25rem;border-radius:1rem;background:rgba(242,155,48,.1);border:1px solid rgba(242,155,48,.35)}
    .download-strip h2{font-size:1.4rem;font-weight:700;color:var(--heading-color)}
    .download-strip p{margin-top:.35rem;max-width:52rem;color:var(--text-color)}
    .download-button{display:inline-block;border-radius:999px;padding:.65rem 1rem;font-size:.85rem;font-weight:700;color:#fff;background:#a85e00;border:1px solid #a85e00}
    .download-button.secondary{color:#a85e00;background:transparent;border-color:#F29B30}
    @media (min-width: 900px){.download-strip{flex-direction:row;align-items:center;justify-content:space-between}}
  </style>

  <script is:inline>
    (function () {
      "use strict";

      function boot() {
        var root = document.getElementById("food-value-database-app");
        if (!root || root.dataset.booted === "true") return;
        root.dataset.booted = "true";

        var dataNode = document.getElementById("fvd-data");
        var foods = JSON.parse((dataNode && dataNode.textContent) || "[]");
        var byId = Object.create(null);
        foods.forEach(function (food) { byId[food.id] = food; });

        var search = root.querySelector("#fvd-search");
        var category = root.querySelector("#fvd-category");
        var coverage = root.querySelector("#fvd-coverage");
        var sort = root.querySelector("#fvd-sort");
        var tbody = root.querySelector("#fvd-tbody");
        var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr[data-food-id]"));
        var count = root.querySelector("#fvd-result-count");
        var empty = root.querySelector("#fvd-empty");
        var tableWrap = root.querySelector("#fvd-table-wrap");
        var comparePanel = root.querySelector("#fvd-compare");
        var compareTable = root.querySelector("#fvd-compare-table");
        var compareHelp = root.querySelector("#fvd-compare-help");
        var selected = [];
        var searchTracked = false;

        function esc(value) {
          return String(value).replace(/[&<>"']/g, function (char) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char];
          });
        }

        function display(value, type) {
          return value === null || value === undefined
            ? "Not measured"
            : type === "money"
              ? "$" + Number(value).toFixed(2)
              : Number(value).toFixed(1) + "g";
        }

        function track(action, details) {
          if (typeof window.gtag !== "function") return;
          var payload = {
            database_name: "food_value_2026",
            action: action,
            result_count: visibleRows().length
          };
          Object.keys(details || {}).forEach(function (key) { payload[key] = details[key]; });
          window.gtag("event", "food_database_action", payload);
        }

        function coverageMatches(row) {
          var protein = row.dataset.protein === "true";
          var fiber = row.dataset.fiber === "true";
          if (coverage.value === "both") return protein && fiber;
          if (coverage.value === "protein") return protein;
          if (coverage.value === "fiber") return fiber;
          return true;
        }

        function visibleRows() {
          var query = search.value.trim().toLowerCase();
          return rows.filter(function (row) {
            return (!query || row.dataset.search.indexOf(query) >= 0) &&
              (category.value === "all" || row.dataset.category === category.value) &&
              coverageMatches(row);
          });
        }

        function sortRows(list) {
          var parts = sort.value.split("-");
          var key = parts.slice(0, -1).join("-");
          var direction = parts[parts.length - 1] === "desc" ? -1 : 1;
          var dataKey = {
            pricePer100g: "pricePer100g",
            packagePrice: "packagePrice",
            proteinPer100g: "proteinPer100g",
            fiberPer100g: "fiberPer100g",
            proteinPerDollar: "proteinPerDollar",
            fiberPerDollar: "fiberPerDollar"
          }[key];

          return list.sort(function (a, b) {
            var foodA = byId[a.dataset.foodId];
            var foodB = byId[b.dataset.foodId];
            if (key === "food") return foodA.food.localeCompare(foodB.food) * direction;
            var valueA = foodA[dataKey];
            var valueB = foodB[dataKey];
            if (valueA === null && valueB === null) return foodA.food.localeCompare(foodB.food);
            if (valueA === null) return 1;
            if (valueB === null) return -1;
            return (Number(valueA) - Number(valueB)) * direction || foodA.food.localeCompare(foodB.food);
          });
        }

        function render() {
          var visible = sortRows(visibleRows());
          var visibleIds = Object.create(null);
          visible.forEach(function (row) {
            visibleIds[row.dataset.foodId] = true;
            tbody.appendChild(row);
          });
          rows.forEach(function (row) { row.hidden = !visibleIds[row.dataset.foodId]; });
          count.textContent = visible.length === foods.length
            ? "Showing all " + foods.length + " foods."
            : "Showing " + visible.length + " of " + foods.length + " foods.";
          empty.hidden = visible.length > 0;
          tableWrap.hidden = visible.length === 0;
        }

        function renderCompare() {
          comparePanel.hidden = selected.length === 0;
          compareHelp.textContent = selected.length < 2
            ? "Add one more food to make this a comparison."
            : selected.length + " foods selected. You can compare up to 4.";

          root.querySelectorAll("[data-compare-food]").forEach(function (button) {
            var active = selected.indexOf(button.dataset.compareFood) >= 0;
            button.setAttribute("aria-pressed", String(active));
            button.textContent = active ? "Remove" : "Add";
            button.disabled = !active && selected.length >= 4;
            var food = byId[button.dataset.compareFood];
            button.setAttribute("aria-label", (active ? "Remove " : "Add ") + food.food + (active ? " from" : " to") + " comparison");
          });

          if (!selected.length) {
            compareTable.innerHTML = "";
            return;
          }

          var chosen = selected.map(function (id) { return byId[id]; });
          var measures = [
            ["Category", function (food) { return food.category; }],
            ["Priced as", function (food) { return food.package || "Not recorded"; }],
            ["Price basis", function (food) { return food.priceBasis || "See source CSV"; }],
            ["Package price", function (food) { return display(food.packagePrice, "money"); }],
            ["Price per 100g", function (food) { return display(food.pricePer100g, "money"); }],
            ["Protein per 100g", function (food) { return display(food.proteinPer100g); }],
            ["Fiber per 100g", function (food) { return display(food.fiberPer100g); }],
            ["Protein per $1", function (food) { return display(food.proteinPerDollar); }],
            ["Fiber per $1", function (food) { return display(food.fiberPerDollar); }]
          ];

          compareTable.innerHTML =
            '<table class="compare-table"><caption class="sr-only">Selected grocery food comparison</caption><thead><tr><th scope="col">Measure</th>' +
            chosen.map(function (food) { return '<th scope="col">' + esc(food.food) + '</th>'; }).join("") +
            "</tr></thead><tbody>" +
            measures.map(function (measure) {
              return '<tr><th scope="row">' + esc(measure[0]) + "</th>" +
                chosen.map(function (food) { return "<td>" + esc(measure[1](food)) + "</td>"; }).join("") +
                "</tr>";
            }).join("") +
            "</tbody></table>";
        }

        search.addEventListener("input", function () {
          render();
          if (!searchTracked && search.value.trim().length >= 2) {
            searchTracked = true;
            track("search", {});
          }
        });

        category.addEventListener("change", function () {
          render();
          track("filter", { filter_type: "category" });
        });
        coverage.addEventListener("change", function () {
          render();
          track("filter", { filter_type: "coverage" });
        });
        sort.addEventListener("change", function () {
          render();
          track("sort", { sort_field: sort.value.split("-").slice(0, -1).join("-") });
        });

        root.addEventListener("click", function (event) {
          var button = event.target.closest("[data-compare-food]");
          if (button) {
            var id = button.dataset.compareFood;
            var index = selected.indexOf(id);
            if (index >= 0) selected.splice(index, 1);
            else if (selected.length < 4) selected.push(id);
            renderCompare();
            track("compare", { selected_count: selected.length });
          }

          if (event.target.closest("#fvd-clear-compare")) {
            selected = [];
            renderCompare();
            track("compare_clear", { selected_count: 0 });
          }

          if (event.target.closest("#fvd-reset")) {
            search.value = "";
            category.value = "all";
            coverage.value = "all";
            sort.value = "food-asc";
            render();
            search.focus();
            track("reset", {});
          }
        });

        render();
        renderCompare();
      }

      document.addEventListener("astro:page-load", boot);
      if (document.readyState !== "loading") boot();
    })();
  </script>

  <style is:global>
    #fvd-compare-table table{width:100%;min-width:42rem;border-collapse:collapse;font-size:.88rem}
    #fvd-compare-table th,#fvd-compare-table td{padding:.65rem .75rem;text-align:left;border-top:1px solid var(--border-color)}
    #fvd-compare-table thead th{border-top:0;color:var(--heading-color)}
    #fvd-compare-table tbody th{color:var(--muted-color);white-space:nowrap}
  </style>
</BaseLayout>
