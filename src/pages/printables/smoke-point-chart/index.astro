---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import {
  SMOKE_POINT_NOTES,
  SMOKE_POINT_PATH,
  SMOKE_POINT_ROWS,
} from "../../../content/lead-magnet-data.mjs";

const title = "Smoke Point Chart";
const description =
  "22 cooking-oil smoke points copied from the lab table on the cooking oils page, plus the two rows those labs don't list.";
const pageUrl = "https://www.daily-life-hacks.com/printables/smoke-point-chart/";
const labCount = SMOKE_POINT_ROWS.filter((row) => row.point.includes("°F")).length;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: title,
    description,
    url: pageUrl,
    inLanguage: "en-US",
    isPartOf: { "@id": "https://www.daily-life-hacks.com/#website" },
    publisher: { "@id": "https://www.daily-life-hacks.com/#organization" },
  },
];
---

<BaseLayout title={title} description={description} robots="noindex, follow" jsonLd={schemas}>
  <Header />
  <main class="sheet-wrap">
    <article class="sheet">
      <p class="kicker">Printable. {labCount} lab readings.</p>
      <h1>Smoke Point Chart</h1>
      <p class="lede">
        Copied from <a href={SMOKE_POINT_PATH}>the cooking oil smoke point page</a>.
        Same rows, same labs. Avocado and butter stay "Not listed" because that is what the page's table says.
        The pan is this chart. The window is a different list: <a href="/cheapest-fast-food-protein-under-5-dollars/">fast-food protein under $5</a>.
        A pale crust is a dough problem, not an oil problem: <a href="/sourdough-discard-pizza-and-bread-troubleshooting/">sourdough discard pizza and no-yeast bread troubleshooting</a>.
        A second grocery store is a mileage problem, not an oil problem: <a href="/is-splitting-grocery-trips-worth-the-gas/">is splitting grocery trips worth the gas</a>.
      </p>
      <p class="print-row no-print">
        <a href="/downloads/smoke-point-chart.pdf" download="smoke-point-chart.pdf">Download the PDF</a>
        <button type="button" onclick="window.print()">Print this page</button>
      </p>
      <table>
        <thead>
          <tr>
            <th scope="col">Oil</th>
            <th scope="col">Smoke point</th>
            <th scope="col">Where it comes from</th>
          </tr>
        </thead>
        <tbody>
          {SMOKE_POINT_ROWS.map((row) => (
            <tr>
              <th scope="row">{row.oil}</th>
              <td>{row.point}</td>
              <td>{row.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <h2>Lab notes from that page</h2>
      <ul>
        {SMOKE_POINT_NOTES.map((note) => <li>{note}</li>)}
      </ul>
      <p class="note">
        Refined numbers are not the cold-pressed bottle. The second table on the source page is the unrefined one.
      </p>
    </article>
  </main>
  <Footer signup="none" />
  <style>
    .sheet-wrap { background: #f4f1ea; padding: 2rem 1rem 3rem; }
    .sheet { max-width: 820px; margin: 0 auto; background: #fff; color: #1c1915; border: 1px solid #e4d8c4; border-radius: 12px; padding: 1.75rem 1.5rem 1.25rem; }
    .kicker { margin: 0 0 0.35rem; color: #a85e00; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
    h1 { margin: 0 0 0.6rem; font-size: 1.85rem; line-height: 1.1; }
    h2 { margin: 1.1rem 0 0.4rem; font-size: 1rem; letter-spacing: 0.04em; text-transform: uppercase; color: #a85e00; }
    .lede, .note, li { font-size: 0.92rem; line-height: 1.45; }
    a, button { color: #a85e00; }
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    th, td { text-align: left; padding: 0.28rem 0.4rem; border-bottom: 1px solid #eadfce; vertical-align: top; }
    thead th { font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: #6b5b45; }
    .print-row { display: flex; gap: 0.75rem; align-items: center; margin: 0.8rem 0 1rem; }
    button, .print-row a { background: #F29B30; color: #fff; border: 0; border-radius: 999px; padding: 0.7rem 1.1rem; font-weight: 800; text-decoration: none; }
    @media print {
      .sheet-wrap { background: #fff; padding: 0; }
      .sheet { max-width: none; border: 0; box-shadow: none; padding: 0; }
      .no-print, header, footer { display: none !important; }
      a { color: inherit; text-decoration: none; }
      @page { size: letter; margin: 0.5in; }
    }
  </style>
</BaseLayout>
