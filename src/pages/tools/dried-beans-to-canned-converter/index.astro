---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import DataProvenance from "../../../components/DataProvenance.astro";
import { parseCsv, num, usd, round, breadcrumb, webAppSchema, toolPageSchema, SOURCE_LINE } from "../_lib/data";
import {
  CANS_PER_DRY_POUND,
  CROWD_HEADCOUNTS,
  CUPS_COOKED_PER_CAN,
  CUPS_COOKED_PER_POUND,
  CUPS_DRY_PER_CAN,
  CUPS_DRY_PER_CAN_LABEL,
  DISH_DEFAULTS,
  DRY_CUPS_PER_POUND,
  GRAMS_DRY_PER_CAN_HIGH,
  GRAMS_DRY_PER_CAN_LOW,
  GRAMS_DRY_PER_CAN_MID,
  GRAMS_PER_POUND,
  MILK_STREET_YIELDS,
  crowdCost,
  crowdPlan,
  formatCups,
  formatDryCupLabel,
  formatGramRange,
  formatLbRange,
  testedYield,
} from "../../../lib/bean-crowd-math.js";

const PATH = "/tools/dried-beans-to-canned-converter/";

/**
 * Two answers, on purpose.
 *
 * The headline yield is the shared kitchen measure in bean-crowd-math.js:
 * 1 can (15 oz) is about 1/2 cup+ dried and 1 1/2 cups drained, and 1 lb dried
 * cooks to about 6 cups, or 3 1/2 to 4 cans. Milk Street's 90-100 g band is the
 * weighed half cup behind that "about 1/2 cup+" label.
 *
 * The nutrition-matched grams are a second figure. Protein survives soaking,
 * cooking, and canning, so grams of dry bean that carry the same protein as
 * one can are (can weight x canned protein per 100 g) / (dry protein per 100 g).
 * Both nutrition figures and both prices come from the audited CSVs.
 *
 * Fiber gives a second, slightly higher nutrition estimate because USDA
 * measures fiber in canned and dry legumes by different methods.
 */
const proteinRows = parseCsv("/data/protein-per-dollar-2026.csv");
const fiberRows = parseCsv("/data/fiber-per-dollar-2026.csv");

const fiberBy = new Map(fiberRows.map((r) => [r.food, r]));

type Bean = {
  food: string;
  short: string;
  pkg: string;
  pkgPrice: number;
  weightG: number;
  proteinPer100: number;
  fiberPer100: number;
  pricePer100g: number;
};

function toBean(r: Record<string, string>): Bean {
  const f = fiberBy.get(r.food);
  return {
    food: r.food,
    short: r.food.replace(/^Canned /, "").replace(/ \(dry\)$/, ""),
    pkg: r.package,
    pkgPrice: num(r.package_price_usd),
    weightG: num(r.package_weight_g),
    proteinPer100: num(r.protein_g_per_100g),
    fiberPer100: f ? num(f.fiber_g_per_100g) : 0,
    pricePer100g: num(r.price_per_100g_usd),
  };
}

const cannedBeans = proteinRows
  .filter((r) => r.category === "Canned beans")
  .map(toBean);

const dryBeans = proteinRows
  .filter((r) => r.category === "Dried beans & lentils")
  .map(toBean);

/** Grams of dry bean that carry the same protein as one whole can. */
const dryGramsPerCan = (can: Bean, dry: Bean) =>
  (can.weightG * can.proteinPer100) / 100 / (dry.proteinPer100 / 100);

const fiberGramsPerCan = (can: Bean, dry: Bean) =>
  dry.fiberPer100 > 0
    ? (can.weightG * can.fiberPer100) / 100 / (dry.fiberPer100 / 100)
    : 0;

function convert(can: Bean, dry: Bean, cans: number) {
  const grams = dryGramsPerCan(can, dry) * cans;
  const dryCost = (grams / 100) * dry.pricePer100g;
  const canCost = can.pkgPrice * cans;
  return {
    grams,
    dryCost,
    canCost,
    saving: canCost - dryCost,
    savingPct: canCost > 0 ? ((canCost - dryCost) / canCost) * 100 : 0,
    cups: grams / 200, // dry beans run ~200 g per US cup across these varieties
    fiberGrams: fiberGramsPerCan(can, dry) * cans,
    proteinTotal: (can.weightG * can.proteinPer100) / 100 * cans,
  };
}

// Server-rendered default so the page answers the question with zero JS.
const defCan = cannedBeans.find((b) => b.food === "Canned black beans") ?? cannedBeans[0];
const defDry = dryBeans.find((b) => b.food === "Black beans (dry)") ?? dryBeans[0];
const def = convert(defCan, defDry, 1);

// Full matrix: every canned bean against its cheapest sensible dry counterpart.
const matrix = cannedBeans.map((can) => ({
  can,
  rows: dryBeans.map((dry) => ({ dry, ...convert(can, dry, 1) })),
}));

const oneCanYield = testedYield(1);
if (!oneCanYield) throw new Error("tested yield for one can failed");
const crowdRows = CROWD_HEADCOUNTS.map((people) => {
  const plan = crowdPlan({ people, cupsPerPerson: DISH_DEFAULTS.chili });
  if (!plan) throw new Error(`crowd plan failed for ${people}`);
  return plan;
});
const defaultCrowd = crowdPlan({ people: 50, cupsPerPerson: DISH_DEFAULTS.chili });
if (!defaultCrowd) throw new Error("default crowd plan failed");
const defaultCrowdPrice = crowdCost(defaultCrowd.cans, {
  canPrice: defCan.pkgPrice,
  dryPricePer100g: defDry.pricePer100g,
});
if (!defaultCrowdPrice) throw new Error("default crowd cost failed");

const title = "How Many Dried Beans Equal a 15.5 oz Can?";
const description =
  "Convert dried beans to canned and back. See exactly how many grams or cups of dry beans replace a 15.5 oz can, and what each one costs at real July 2026 US prices.";

const schemas = [
  toolPageSchema({ path: PATH, name: title, description }),
  webAppSchema({
    path: PATH,
    name: "Dried Beans to Canned Beans Converter",
    description,
    featureList: [
      "Convert a 15-oz can to about 1/2 cup+ of dried beans",
      "Count 3 1/2 to 4 cans and about 6 cooked cups in a pound of dried beans",
      "Count cans and dry pounds for a crowd",
      "Compare the cost of dried beans against canned at real US grocery prices",
      "Show a nutrition-matched gram figure beside the tested kitchen yield",
      "Shareable result links",
    ],
  }),
  breadcrumb(PATH, "Dried Beans to Canned Converter"),
];
---

<BaseLayout title={title} description={description} jsonLd={schemas}>
  <Header />
  <main class="max-w-4xl mx-auto px-4 py-12 md:py-16">
    <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color: var(--heading-color);">
      How Many Dried Beans Equal a Can?
    </h1>

    <p class="text-lg mb-8" style="color: var(--text-color);">
      1 can (15.5 oz) ≈ {CUPS_DRY_PER_CAN_LABEL} dried ≈ 1½ cups cooked, drained.
      One pound of dried beans cooks to about {CUPS_COOKED_PER_POUND} cups, which is {CANS_PER_DRY_POUND} cans.
      The calculator below scales one can for a crowd and prices the swap from our July 2026
      {" "}<a href="/protein-per-dollar-adjusted-for-quality/" class="underline" style="color:#F29B30;">protein per dollar</a>
      {" "}and{" "}
      <a href="/what-30-grams-of-fiber-costs-per-day/" class="underline" style="color:#F29B30;">fiber per dollar</a>
      {" "}grocery studies.
      A half-cup cooked serving across a week, for a family rather than a crowd pot, is the
      {" "}<a href="/how-many-pounds-of-dried-beans-for-a-week/" class="underline" style="color:#F29B30;">dried bean week planner</a>.
    </p>

    <!--
      Default result is rendered on the server. JS upgrades it; JS is not
      required to read it. Crawlers, screen readers and people on a train all
      get the same numbers.
    -->
    <section
      id="bean-tool"
      class="rounded-xl p-5 md:p-6 mb-8"
      style="background-color: var(--card-bg); border: 1px solid var(--border-color);"
    >
      <div class="flex flex-wrap gap-2 mb-5" role="tablist" aria-label="Converter mode">
        <button type="button" class="bean-tab" id="bean-tab-swap" role="tab" aria-selected="true" aria-controls="bean-panel-swap">One can, or a few</button>
        <button type="button" class="bean-tab" id="bean-tab-crowd" role="tab" aria-selected="false" aria-controls="bean-panel-crowd">Beans for a crowd</button>
      </div>

      <div id="bean-panel-swap" role="tabpanel" aria-labelledby="bean-tab-swap">
      <h2 class="text-2xl font-bold mb-4" style="color: var(--heading-color);">
        Swap the cans for the bag
      </h2>

      <form id="bean-form" class="grid sm:grid-cols-3 gap-3 mb-5">
        <label class="flex flex-col gap-1">
          <span class="text-sm font-semibold" style="color: var(--heading-color);">How many cans?</span>
          <input
            type="number" id="bean-cans" name="cans" value="1" min="0.5" max="50" step="0.5"
            class="bean-input" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-sm font-semibold" style="color: var(--heading-color);">Cans of</span>
          <select id="bean-canned" name="canned" class="bean-input">
            {cannedBeans.map((b) => (
              <option value={b.food} selected={b.food === defCan.food}>{b.short}</option>
            ))}
          </select>
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-sm font-semibold" style="color: var(--heading-color);">Replaced with dry</span>
          <select id="bean-dry" name="dry" class="bean-input">
            {dryBeans.map((b) => (
              <option value={b.food} selected={b.food === defDry.food}>{b.short}</option>
            ))}
          </select>
        </label>
      </form>

      <div id="bean-result" class="rounded-xl p-5" style="background: var(--page-bg); border: 1px solid var(--border-color);">
        <p class="text-sm font-bold uppercase tracking-widest mb-2" style="color:#F29B30;">The answer</p>
        <p class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
          <span id="bean-cans-out">1</span> can (15.5 oz) ≈ <span id="bean-yield-cups">{formatDryCupLabel(1)}</span> dried ≈ <span id="bean-yield-grams">{formatGramRange(oneCanYield.gramsLow, oneCanYield.gramsHigh)}</span> g dry ≈ <span id="bean-yield-cooked">{formatCups(oneCanYield.cupsCooked)}</span> cups cooked, drained
        </p>
        <p class="mb-4" style="color: var(--text-color);">
          That's the tested kitchen yield:
          {" "}<a href="https://www.177milkstreet.com/stories/bean-counting-dried-vs-canned" class="underline" style="color:#F29B30;">Milk Street</a>
          {" "}weighed 11 varieties and landed on about ½ cup dry per 15.5 oz can.
          Nutrition-matched, this can of <span id="bean-canned-out">{defCan.short}</span>
          equals <span id="bean-grams-out">{round(def.grams, 0)}</span> g of dry
          <span id="bean-dry-out">{defDry.short.toLowerCase()}</span>,
          about <strong><span id="bean-cups-out">{round(def.cups, 2)}</span> US cups</strong>,
          with the same <span id="bean-protein-out">{round(def.proteinTotal, 0)}</span> g of protein.
          Use {CUPS_DRY_PER_CAN_LABEL} when you're cooking. Use the nutrition-matched grams when you want the protein to line up.
        </p>
        <dl class="grid sm:grid-cols-3 gap-3 text-sm">
          <div class="bean-stat">
            <dt>Canned cost</dt>
            <dd id="bean-cancost-out">{usd(def.canCost)}</dd>
          </div>
          <div class="bean-stat">
            <dt>Dry cost</dt>
            <dd id="bean-drycost-out">{usd(def.dryCost)}</dd>
          </div>
          <div class="bean-stat" style="border-color:#F29B30;">
            <dt>You keep</dt>
            <dd id="bean-saving-out">{usd(def.saving)} ({round(def.savingPct, 0)}%)</dd>
          </div>
        </dl>
        <p class="mt-4 text-sm" style="color: var(--muted-color);">
          <a id="bean-share" href={PATH} data-result-share="link" class="underline font-semibold" style="color:#F29B30;">Link to this result</a>
          &mdash; the numbers travel in the URL.
        </p>
      </div>

      <p class="mt-4 text-sm" style="color: var(--muted-color);">
        The nutrition-matched cups use 200 g of dry beans per US cup. The {CUPS_DRY_PER_CAN_LABEL} headline is the tested volume, about 90 to 100 g, which is a little lighter than that 200 g cup.
      </p>
      </div>

      <div id="bean-panel-crowd" role="tabpanel" aria-labelledby="bean-tab-crowd">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--heading-color);">Beans for a crowd</h2>
        <p class="mb-4 text-sm" style="color: var(--muted-color);">
          Chili defaults to ½ cup of cooked beans per person, a side to ⅓ cup, and a mixed soup to ¼ cup.
          One can stands in for 1½ cups cooked and drained. Cans round up so the pot doesn't come up short.
        </p>
        <form id="crowd-form" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-5">
          <label class="flex flex-col gap-1">
            <span class="text-sm font-semibold" style="color: var(--heading-color);">People</span>
            <input class="bean-input" id="crowd-people" name="people" type="number" min="1" max="500" step="1" inputmode="numeric" value="50" />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-semibold" style="color: var(--heading-color);">Dish</span>
            <select class="bean-input" id="crowd-dish" name="dish">
              <option value="chili" selected>Chili</option>
              <option value="side">Side</option>
              <option value="soup">Soup</option>
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-semibold" style="color: var(--heading-color);">Cooked beans per person (cups)</span>
            <input class="bean-input" id="crowd-serving" name="serving" type="number" min="0.05" max="3" step="0.01" inputmode="decimal" value={DISH_DEFAULTS.chili} />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-semibold" style="color: var(--heading-color);">Price the cans as</span>
            <select class="bean-input" id="crowd-canned" name="crowdCanned">
              {cannedBeans.map((b) => (
                <option value={b.food} selected={b.food === defCan.food}>{b.short}</option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-semibold" style="color: var(--heading-color);">Price the dry beans as</span>
            <select class="bean-input" id="crowd-dry" name="crowdDry">
              {dryBeans.map((b) => (
                <option value={b.food} selected={b.food === defDry.food}>{b.short}</option>
              ))}
            </select>
          </label>
        </form>
        <div id="bean-crowd-result" class="rounded-xl p-5" style="background: var(--page-bg); border: 1px solid var(--border-color);" aria-live="polite">
          <p class="text-sm font-bold uppercase tracking-widest mb-2" style="color:#F29B30;">For the pot</p>
          <p class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
            <span id="crowd-cans-out">{defaultCrowd.cans}</span> cans
            (<span id="crowd-exact-out">{round(defaultCrowd.exactCans, 1)}</span> before rounding up)
          </p>
          <p class="mb-4" style="color: var(--text-color);">
            <span id="crowd-people-out">{defaultCrowd.people}</span> people at
            <span id="crowd-serving-out">{formatCups(defaultCrowd.cupsPerPerson)}</span> cup cooked beans each is
            <span id="crowd-cooked-out">{formatCups(defaultCrowd.cookedCups)}</span> cups cooked.
            That's <span id="crowd-lb-out">{formatLbRange(defaultCrowd.dryLbLow, defaultCrowd.dryLbHigh)}</span> dry,
            using 90 to 100 g per can.
          </p>
          <dl class="grid sm:grid-cols-2 gap-3 text-sm">
            <div class="bean-stat">
              <dt>Canned cost</dt>
              <dd id="crowd-cancost-out">{usd(defaultCrowdPrice.canCost ?? 0)}</dd>
            </div>
            <div class="bean-stat" style="border-color:#F29B30;">
              <dt>Dry cost at 95 g per can</dt>
              <dd id="crowd-drycost-out">{usd(defaultCrowdPrice.dryCost ?? 0)}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="crowd-table" class="mt-14">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
        Cans and dry pounds for a crowd
      </h2>
      <p class="mb-4" style="color: var(--text-color);">
        Bean-heavy chili, at ½ cup of cooked beans per person. Each can covers 1½ cups cooked, and the can count rounds up.
        Dry weight is 90 to 100 g for each of those cans, which is about {formatLbRange(crowdRows[0].dryLbLow, crowdRows[0].dryLbHigh)} at the small end of this table and {formatLbRange(crowdRows[crowdRows.length - 1].dryLbLow, crowdRows[crowdRows.length - 1].dryLbHigh)} at 100 people.
      </p>
      <div class="overflow-x-auto rounded-xl mb-12" style="border: 1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width: 520px; border-collapse: collapse;">
          <caption class="sr-only">
            15.5 oz cans and dry bean weight for 10 to 100 people at one half cup of cooked beans each.
          </caption>
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color); color: var(--heading-color);">
              <th scope="col" class="bean-th">People</th>
              <th scope="col" class="bean-th bean-num">Cooked beans</th>
              <th scope="col" class="bean-th bean-num">15.5 oz cans</th>
              <th scope="col" class="bean-th bean-num">Dry weight</th>
            </tr>
          </thead>
          <tbody>
            {crowdRows.map((row) => (
              <tr style="border-bottom: 1px solid var(--border-color);">
                <th scope="row" class="bean-td">{row.people}</th>
                <td class="bean-td bean-num">{formatCups(row.cookedCups)} cups</td>
                <td class="bean-td bean-num" style="font-weight:700;">{row.cans}</td>
                <td class="bean-td bean-num">{formatLbRange(row.dryLbLow, row.dryLbHigh)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="cans-per-pound" class="mt-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
        How many cans are in 1 lb dry
      </h2>
      <p class="mb-4" style="color: var(--text-color);">
        1 lb dried is {DRY_CUPS_PER_POUND} cups dry and cooks to about {CUPS_COOKED_PER_POUND} cups, which is {CANS_PER_DRY_POUND} (15-oz) cans.
        One can is about {formatCups(CUPS_COOKED_PER_CAN)} cups drained, or {CUPS_DRY_PER_CAN_LABEL} dried.
        Milk Street's cooked yield still changes by variety. The dry measure stays near ½ cup, a little over, across the ones they tested.
      </p>
      <div class="overflow-x-auto rounded-xl mb-4" style="border: 1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width: 560px; border-collapse: collapse;">
          <caption class="sr-only">
            Milk Street cooked yield per cup of dry beans, and about how many 15.5 oz cans are in one dry pound.
          </caption>
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color); color: var(--heading-color);">
              <th scope="col" class="bean-th">Variety</th>
              <th scope="col" class="bean-th bean-num">Cups cooked per cup dry</th>
              <th scope="col" class="bean-th bean-num">Dry per 15.5 oz can</th>
              <th scope="col" class="bean-th bean-num">Cans in 1 lb dry</th>
            </tr>
          </thead>
          <tbody>
            {MILK_STREET_YIELDS.map((row) => (
              <tr style="border-bottom: 1px solid var(--border-color);">
                <th scope="row" class="bean-td">{row.variety}</th>
                <td class="bean-td bean-num">{row.cookedCupsPerCupDry}</td>
                <td class="bean-td bean-num">{CUPS_DRY_PER_CAN_LABEL} (90 to 100 g)</td>
                <td class="bean-td bean-num">{CANS_PER_DRY_POUND}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm mb-8" style="color: var(--muted-color);">
        Cooked cups per cup dry: Milk Street,
        {" "}<a href="https://www.177milkstreet.com/stories/bean-counting-dried-vs-canned" class="underline" style="color:#F29B30;">bean counting, dried vs canned</a>.
        Chickpeas 2¾, black 2½, pinto 2¾, kidney 3, navy 2¾, cannellini 3¼.
        A second check against USDA portions is at
        {" "}<a href="https://earthtoveg.com/calc/beans/" class="underline" style="color:#F29B30;">earthtoveg</a>.
      </p>
    </section>

    <!-- Static matrix. Outside the interactive block, always in the HTML. -->
    <section id="conversion-table" class="mt-14">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
        Every can, every bean, already worked out
      </h2>
      <p class="mb-2" style="color: var(--text-color);">
        One 15.5 oz can replaced by each dry legume we've priced. Grams are what you measure
        out dry before soaking. The cost columns are what that quantity costs you at the
        register, which is where dried beans stop being a lifestyle choice and start being
        a rounding error on the grocery bill.
      </p>
      <p class="text-sm mb-8" style="color: var(--muted-color);">
        {SOURCE_LINE} Method described on the
        <a href="/methodology/" class="underline" style="color:#F29B30;">methodology page</a>.
        Free to reuse with credit and a link.
      </p>

      {matrix.map((m) => (
        <div class="mb-12">
          <h3 class="text-xl font-bold mb-3" style="color: var(--heading-color);">
            1 can of {m.can.short} ({m.can.pkg}, {usd(m.can.pkgPrice)}) becomes
          </h3>
          <div class="overflow-x-auto rounded-xl" style="border: 1px solid var(--border-color);">
            <table class="w-full text-sm" style="min-width: 620px; border-collapse: collapse;">
              <caption class="sr-only">
                Dry legume quantity and cost equivalent to one {m.can.pkg} of {m.can.short},
                matched on protein content, at July 2026 US grocery prices.
              </caption>
              <thead>
                <tr style="border-bottom: 2px solid var(--border-color); color: var(--heading-color);">
                  <th scope="col" class="bean-th">Dry legume</th>
                  <th scope="col" class="bean-th bean-num">Grams dry</th>
                  <th scope="col" class="bean-th bean-num">Cups dry</th>
                  <th scope="col" class="bean-th bean-num">Dry cost</th>
                  <th scope="col" class="bean-th bean-num">Canned cost</th>
                  <th scope="col" class="bean-th bean-num">Saved</th>
                </tr>
              </thead>
              <tbody>
                {m.rows.map((r) => (
                  <tr style="border-bottom: 1px solid var(--border-color);">
                    <th scope="row" class="bean-td" style="font-weight:600;text-align:left;">{r.dry.short}</th>
                    <td class="bean-td bean-num" style="font-weight:700;">{round(r.grams, 0)} g</td>
                    <td class="bean-td bean-num">{round(r.cups, 2)}</td>
                    <td class="bean-td bean-num">{usd(r.dryCost)}</td>
                    <td class="bean-td bean-num">{usd(r.canCost)}</td>
                    <td class="bean-td bean-num" style="font-weight:700;color:#F29B30;">
                      {usd(r.saving)} ({round(r.savingPct, 0)}%)
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--heading-color);">
        What these numbers actually mean
      </h2>

      <h3 class="text-xl font-bold mt-6 mb-2" style="color: var(--heading-color);">Why we match on protein instead of guessing a ratio</h3>
      <p class="mb-4 leading-relaxed" style="color: var(--text-color);">
        The headline answer is the kitchen yield, {CUPS_DRY_PER_CAN_LABEL} per can and about 1½ cups cooked, drained. Milk Street's weighed scoop behind that label is about ½ cup dry. The number in this section is a second figure, the nutrition-matched grams. Most charts stop at the half cup and never say where it came from. Protein doesn't disappear
        when you soak, boil or can a bean, so it works as a tracer. One {defCan.pkg} of
        {" "}{defCan.short.toLowerCase()} carries {round(def.proteinTotal, 0)} g of protein.
        Dry {defDry.short.toLowerCase()} run {defDry.proteinPer100} g of protein per 100 g.
        Divide one by the other and you get {round(def.grams, 0)} g of dry beans, which is
        the number in the box above. No folklore involved.
      </p>

      <h3 class="text-xl font-bold mt-6 mb-2" style="color: var(--heading-color);">The honest wobble in that number</h3>
      <p class="mb-4 leading-relaxed" style="color: var(--text-color);">
        Run the same math on fiber instead of protein and you'd get
        {" "}{round(fiberGramsPerCan(defCan, defDry), 0)} g rather than {round(def.grams, 0)} g.
        That gap isn't a mistake, it's USDA measuring fiber in canned and dry legumes with
        different methods. So treat the nutrition-matched grams as a working figure, not a lab result.
        The cooking measure stays {CUPS_DRY_PER_CAN_LABEL}.
        For cooking it makes no difference. A pot of chili has never once cared about
        fifteen grams of dry bean.
      </p>

      <h3 class="text-xl font-bold mt-6 mb-2" style="color: var(--heading-color);">Where the prices come from</h3>
      <p class="mb-4 leading-relaxed" style="color: var(--text-color);">
        Both sides are priced from the same audited study: {defCan.pkg} of
        {" "}{defCan.short.toLowerCase()} at {usd(defCan.pkgPrice)}, and dry
        {" "}{defDry.short.toLowerCase()} at {usd(defDry.pkgPrice)} for the {defDry.pkg}.
        Prices are US national grocery observations from July 2026, nutrition is USDA
        FoodData Central, and the whole method is written up on the
        {" "}<a href="/methodology/" class="underline" style="color:#F29B30;">methodology page</a>.
        When we re-run the price study this page changes by itself, because it reads the
        same CSV you can download below.
      </p>

      <h3 class="text-xl font-bold mt-6 mb-2" style="color: var(--heading-color);">So should you just buy dry?</h3>
      <p class="mb-4 leading-relaxed" style="color: var(--text-color);">
        On price it isn't close, and the table says so. What the table can't price is the
        soak and the ninety minutes of simmering, and some nights that's the whole ballgame.
        A reasonable middle: cook a big pot of dry beans when you're home anyway, freeze
        them in can-sized portions, and keep a few actual cans for the nights when dinner
        needs to happen in twenty minutes. You can also see how beans stack up against
        everything else in the
        {" "}<a href="/tools/fiber-per-dollar-calculator/" class="underline" style="color:#F29B30;">fiber and protein per dollar calculator</a>.
        A sealed can is also the backup when nobody is boiling anything. The
        {" "}<a href="/no-cook-emergency-protein-and-fiber-grocery-list/" class="underline" style="color:#F29B30;">no-cook emergency grocery list</a>
        prices canned black beans next to peanut butter, and it marks which of those foods still need a fridge.
      </p>
    </section>

    <DataProvenance
      datasets={["protein-per-dollar-2026", "fiber-per-dollar-2026"]}
      heading="The price snapshot behind this converter"
    />
  </main>
  <Footer />

  <style>
    .bean-input {
      width: 100%;
      border-radius: 0.75rem;
      padding: 0.55rem 0.75rem;
      font-size: 0.95rem;
      background: var(--page-bg);
      color: var(--text-color);
      border: 1px solid var(--border-color);
    }
    .bean-input:focus-visible {
      outline: 3px solid #f29b30;
      outline-offset: 2px;
    }
    .bean-stat {
      padding: 0.75rem 0.9rem;
      border-radius: 0.75rem;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
    }
    .bean-stat dt {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted-color);
      margin-bottom: 0.2rem;
    }
    .bean-stat dd {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--heading-color);
    }
    .bean-th {
      padding: 0.6rem 0.75rem;
      text-align: left;
      font-weight: 600;
      white-space: nowrap;
    }
    .bean-th.bean-num,
    .bean-td.bean-num {
      text-align: right;
      white-space: nowrap;
    }
    .bean-td {
      padding: 0.5rem 0.75rem;
      vertical-align: top;
    }
    .bean-tab {
      border-radius: 999px;
      padding: 0.45rem 0.9rem;
      font-size: 0.9rem;
      font-weight: 700;
      background: var(--page-bg);
      color: var(--heading-color);
      border: 1px solid var(--border-color);
    }
    .bean-tab[aria-selected="true"] {
      background: #F29B30;
      color: #fff;
      border-color: #F29B30;
    }
    #bean-share:focus-visible,
    .bean-input:focus-visible,
    .bean-tab:focus-visible {
      outline: 3px solid #f29b30;
      outline-offset: 2px;
    }
    caption.sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  </style>

  <script
    is:inline
    data-astro-rerun
    define:vars={{
      CANNED: cannedBeans,
      DRY: dryBeans,
      PATH,
      DISH_DEFAULTS,
      CUPS_COOKED_PER_CAN,
      CUPS_DRY_PER_CAN,
      GRAMS_DRY_PER_CAN_LOW,
      GRAMS_DRY_PER_CAN_HIGH,
      GRAMS_DRY_PER_CAN_MID,
      GRAMS_PER_POUND,
    }}
  >
    (function () {
      "use strict";
      var root = document.getElementById("bean-tool");
      if (!root || root.dataset.booted) return;
      root.dataset.booted = "1";

      var cansEl = document.getElementById("bean-cans");
      var cannedEl = document.getElementById("bean-canned");
      var dryEl = document.getElementById("bean-dry");
      var peopleEl = document.getElementById("crowd-people");
      var dishEl = document.getElementById("crowd-dish");
      var servingEl = document.getElementById("crowd-serving");
      var crowdCannedEl = document.getElementById("crowd-canned");
      var crowdDryEl = document.getElementById("crowd-dry");
      if (!cansEl || !cannedEl || !dryEl || !peopleEl || !dishEl || !servingEl || !crowdCannedEl || !crowdDryEl) return;

      var out = {
        cans: document.getElementById("bean-cans-out"),
        yieldCups: document.getElementById("bean-yield-cups"),
        yieldGrams: document.getElementById("bean-yield-grams"),
        yieldCooked: document.getElementById("bean-yield-cooked"),
        canned: document.getElementById("bean-canned-out"),
        dry: document.getElementById("bean-dry-out"),
        grams: document.getElementById("bean-grams-out"),
        cups: document.getElementById("bean-cups-out"),
        protein: document.getElementById("bean-protein-out"),
        cancost: document.getElementById("bean-cancost-out"),
        drycost: document.getElementById("bean-drycost-out"),
        saving: document.getElementById("bean-saving-out"),
        share: document.getElementById("bean-share"),
        crowdCans: document.getElementById("crowd-cans-out"),
        crowdExact: document.getElementById("crowd-exact-out"),
        crowdPeople: document.getElementById("crowd-people-out"),
        crowdServing: document.getElementById("crowd-serving-out"),
        crowdCooked: document.getElementById("crowd-cooked-out"),
        crowdLb: document.getElementById("crowd-lb-out"),
        crowdCanCost: document.getElementById("crowd-cancost-out"),
        crowdDryCost: document.getElementById("crowd-drycost-out"),
      };
      var mode = "swap";

      function find(list, food) {
        for (var i = 0; i < list.length; i++) if (list[i].food === food) return list[i];
        return list[0];
      }
      function usd(n) {
        return "$" + n.toFixed(2);
      }
      function round(n, p) {
        var f = Math.pow(10, p);
        return Math.round(n * f) / f;
      }
      function formatCups(n) {
        var fractions = [[0, ""], [0.25, "¼"], [1 / 3, "⅓"], [0.5, "½"], [2 / 3, "⅔"], [0.75, "¾"]];
        var abs = Math.abs(n);
        var whole = Math.floor(abs + 1e-9);
        var frac = abs - whole;
        var best = null;
        for (var i = 0; i < fractions.length; i++) {
          var diff = Math.abs(frac - fractions[i][0]);
          if (diff < 0.02 && (best === null || diff < best.diff)) best = { label: fractions[i][1], diff: diff };
        }
        if (!best) return String(round(abs, 2));
        if (whole === 0) return best.label || "0";
        if (!best.label) return String(whole);
        return String(whole) + best.label;
      }
      function formatDryCupLabel(cans) {
        var cups = cans * CUPS_DRY_PER_CAN;
        var unit = cups > 1 ? "cups" : "cup";
        return "about " + formatCups(cups) + " " + unit + "+";
      }
      function formatLb(low, high) {
        var lo = (Math.round(low * 10) / 10).toFixed(1);
        var hi = (Math.round(high * 10) / 10).toFixed(1);
        return lo === hi ? lo + " lb" : lo + " to " + hi + " lb";
      }
      function showMode(next) {
        mode = next === "crowd" ? "crowd" : "swap";
        var swapPanel = document.getElementById("bean-panel-swap");
        var crowdPanel = document.getElementById("bean-panel-crowd");
        if (swapPanel) swapPanel.hidden = mode !== "swap";
        if (crowdPanel) crowdPanel.hidden = mode !== "crowd";
        var swapTab = document.getElementById("bean-tab-swap");
        var crowdTab = document.getElementById("bean-tab-crowd");
        if (swapTab) swapTab.setAttribute("aria-selected", mode === "swap" ? "true" : "false");
        if (crowdTab) crowdTab.setAttribute("aria-selected", mode === "crowd" ? "true" : "false");
      }

      function render() {
        showMode(mode);
        var cans = parseFloat(cansEl.value);
        if (!isFinite(cans) || cans <= 0) cans = 1;
        var can = find(CANNED, cannedEl.value);
        var dry = find(DRY, dryEl.value);

        var proteinTotal = ((can.weightG * can.proteinPer100) / 100) * cans;
        var grams = proteinTotal / (dry.proteinPer100 / 100);
        var dryCost = (grams / 100) * dry.pricePer100g;
        var canCost = can.pkgPrice * cans;
        var saving = canCost - dryCost;
        var pct = canCost > 0 ? (saving / canCost) * 100 : 0;
        var gramsLow = cans * GRAMS_DRY_PER_CAN_LOW;
        var gramsHigh = cans * GRAMS_DRY_PER_CAN_HIGH;

        out.cans.textContent = String(cans);
        out.yieldCups.textContent = formatDryCupLabel(cans);
        out.yieldGrams.textContent = Math.round(gramsLow) + " to " + Math.round(gramsHigh);
        out.yieldCooked.textContent = formatCups(cans * CUPS_COOKED_PER_CAN);
        out.canned.textContent = can.short;
        out.dry.textContent = dry.short.toLowerCase();
        out.grams.textContent = String(round(grams, 0));
        out.cups.textContent = String(round(grams / 200, 2));
        out.protein.textContent = String(round(proteinTotal, 0));
        out.cancost.textContent = usd(canCost);
        out.drycost.textContent = usd(dryCost);
        out.saving.textContent = usd(saving) + " (" + round(pct, 0) + "%)";

        var people = parseFloat(peopleEl.value);
        if (!isFinite(people) || people <= 0) people = 1;
        var serving = parseFloat(servingEl.value);
        if (!isFinite(serving) || serving <= 0) serving = DISH_DEFAULTS.chili;
        var cookedCups = people * serving;
        var exactCans = cookedCups / CUPS_COOKED_PER_CAN;
        var crowdCans = Math.ceil(exactCans - 1e-9);
        var crowdCan = find(CANNED, crowdCannedEl.value);
        var crowdDry = find(DRY, crowdDryEl.value);
        var crowdGramsMid = crowdCans * GRAMS_DRY_PER_CAN_MID;
        out.crowdCans.textContent = String(crowdCans);
        out.crowdExact.textContent = String(round(exactCans, 1));
        out.crowdPeople.textContent = String(people);
        out.crowdServing.textContent = formatCups(serving);
        out.crowdCooked.textContent = formatCups(cookedCups);
        out.crowdLb.textContent = formatLb(
          (crowdCans * GRAMS_DRY_PER_CAN_LOW) / GRAMS_PER_POUND,
          (crowdCans * GRAMS_DRY_PER_CAN_HIGH) / GRAMS_PER_POUND,
        );
        out.crowdCanCost.textContent = usd(crowdCan.pkgPrice * crowdCans);
        out.crowdDryCost.textContent = usd((crowdGramsMid / 100) * crowdDry.pricePer100g);

        var qs = new URLSearchParams({
          mode: mode,
          cans: String(cans),
          canned: can.food,
          dry: dry.food,
          people: peopleEl.value,
          dish: dishEl.value,
          serving: servingEl.value,
          crowdCanned: crowdCan.food,
          crowdDry: crowdDry.food,
        });
        var url = PATH + "?" + qs.toString();
        out.share.setAttribute("href", url);
        history.replaceState(null, "", url);
      }

      var params = new URLSearchParams(location.search);
      if (params.get("mode") === "crowd" || params.get("mode") === "swap") mode = params.get("mode");
      if (params.get("cans")) cansEl.value = params.get("cans");
      if (params.get("canned")) cannedEl.value = params.get("canned");
      if (params.get("dry")) dryEl.value = params.get("dry");
      if (params.get("people")) peopleEl.value = params.get("people");
      if (params.get("dish") && DISH_DEFAULTS[params.get("dish")] !== undefined) dishEl.value = params.get("dish");
      if (params.get("serving")) servingEl.value = params.get("serving");
      if (params.get("crowdCanned")) crowdCannedEl.value = params.get("crowdCanned");
      if (params.get("crowdDry")) crowdDryEl.value = params.get("crowdDry");

      ["input", "change"].forEach(function (evt) {
        cansEl.addEventListener(evt, render);
        cannedEl.addEventListener(evt, render);
        dryEl.addEventListener(evt, render);
        peopleEl.addEventListener(evt, render);
        servingEl.addEventListener(evt, render);
        crowdCannedEl.addEventListener(evt, render);
        crowdDryEl.addEventListener(evt, render);
      });
      dishEl.addEventListener("change", function () {
        var next = DISH_DEFAULTS[dishEl.value];
        if (typeof next === "number") servingEl.value = String(next);
        render();
      });
      document.getElementById("bean-tab-swap").addEventListener("click", function () {
        mode = "swap";
        render();
      });
      document.getElementById("bean-tab-crowd").addEventListener("click", function () {
        mode = "crowd";
        render();
      });
      document.getElementById("bean-form").addEventListener("submit", function (e) {
        e.preventDefault();
      });
      document.getElementById("crowd-form").addEventListener("submit", function (e) {
        e.preventDefault();
      });
      render();
    })();
  </script>
</BaseLayout>
