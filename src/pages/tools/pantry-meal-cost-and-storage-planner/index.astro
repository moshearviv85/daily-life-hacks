---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_ID, AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import {
  BEANS_FILE,
  MEAT_FILE,
  PANTRY_FILE,
  REFERENCE,
  chartPoints,
  fridgeLabel,
  loadPlannerFoods,
  money,
  quote,
} from "../../../lib/pantry-meal-storage.mjs";

const foods = loadPlannerFoods();
const points = chartPoints(foods);
const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}/tools/pantry-meal-cost-and-storage-planner/`;
const title = "Pantry Meal Cost and Storage Planner";
const description =
  "Price a week of protein against fridge days for meat, beans, rice, and opened cans. Your entries stay in this browser tab.";
const chart = "/images/pantry-meal-cost-and-storage-planner-chart.jpg";
const chartAlt =
  "Bar chart comparing a 7-day protein batch cost with the fridge days for raw meat, cooked leftovers, and the longer FoodKeeper rows for pasta and rice. Not a photograph.";
const defaultFood = foods.find((food) => food.id === "drumsticks");
const defaultMode = defaultFood?.modes.find((mode) => mode.id === "cooked");
const starter = quote(defaultFood, defaultMode, REFERENCE.people, REFERENCE.gramsPerPerson, REFERENCE.days);

const person = {
  "@type": "Person",
  "@id": AUTHOR_ID,
  name: AUTHOR_NAME,
  url: AUTHOR_URL,
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${pageUrl}#webapp`,
  name: "Pantry Meal Cost and Storage Planner",
  url: pageUrl,
  description,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript for the day and people controls. The reference table is in the page.",
  isAccessibleForFree: true,
  inLanguage: "en-US",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: person,
  publisher: { "@id": `${siteUrl}/#organization` },
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools/` },
    { "@type": "ListItem", position: 3, name: "Pantry meal cost and storage planner", item: pageUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={chart}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[appSchema, breadcrumbSchema]}
>
  <Header />
  <main class="max-w-6xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/tools/" class="underline" style="color:#F29B30;">Tools</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Pantry meal cost and storage planner</span>
    </nav>

    <div class="max-w-4xl mb-8">
      <p class="text-sm font-bold uppercase tracking-widest mb-3" style="color:#F29B30;">By {AUTHOR_NAME}. The week is longer than the fridge row.</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">Price the batch, then check the clock</h1>
      <p class="text-lg leading-relaxed" style="color:var(--text-color);">
        Drumsticks are the cheap protein. Cook seven days of them on Sunday and Thursday is already past the cooked-poultry row. The row is 3 to 4 days at 40°F or below. The receipt doesn't extend it.
      </p>
      <p class="text-lg leading-relaxed mt-4" style="color:var(--text-color);">
        The planner divides the protein you asked for by the protein-per-dollar figure in {PANTRY_FILE}, {MEAT_FILE}, and the matching bean rows in {BEANS_FILE}. Then it holds that cost up to the fridge days already published for that food. A dry bag and a cooked pot are not the same state.
      </p>
    </div>

    <figure class="mb-10">
      <img src={chart} width="1200" height="675" alt={chartAlt} />
      <figcaption class="mt-3 text-sm leading-relaxed" style="color:var(--muted-color);">
        Not a photograph. Each bar is {REFERENCE.people * REFERENCE.gramsPerPerson * REFERENCE.days} grams of protein, four people at 50 grams for seven days, divided by the file's protein per dollar. Day 5 on spaghetti and day 6 on rice are the FoodKeeper upper days. The warning below still uses day 4 for those cooked foods, because the leftovers row and the pantry page say 3 to 4.
      </figcaption>
    </figure>

    <section id="pantry-planner" class="rounded-2xl p-5 md:p-7 mb-12" style="background:var(--card-bg);border:1px solid var(--border-color);">
      <h2 class="text-xl md:text-2xl font-bold mb-4" style="color:var(--heading-color);">Set the household, then pick the state the food is actually in</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        <label class="tool-label">People eating<input id="people" class="tool-input" type="number" min="1" max="12" step="1" value={REFERENCE.people} inputmode="numeric" /></label>
        <label class="tool-label">Protein grams per person<input id="grams" class="tool-input" type="number" min="10" max="200" step="1" value={REFERENCE.gramsPerPerson} inputmode="numeric" /></label>
        <label class="tool-label">Days in the batch<input id="days" class="tool-input" type="number" min="1" max="14" step="1" value={REFERENCE.days} inputmode="numeric" /></label>
        <label class="tool-label">Food and state
          <select id="food" class="tool-input tool-select">
            {foods.flatMap((food) => food.modes.map((mode) => (
              <option
                value={`${food.id}:${mode.id}`}
                selected={food.id === "drumsticks" && mode.id === "cooked"}
                data-protein={food.proteinPerDollar}
                data-fridge-min={mode.fridgeMin ?? ""}
                data-fridge-max={mode.fridgeMax ?? ""}
                data-note={mode.note}
              >
                {food.food}: {mode.label}
              </option>
            )))}
          </select>
        </label>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4" aria-live="polite">
        <div class="metric highlight"><span>Batch cost</span><strong id="out-cost">{money(starter.cost)}</strong></div>
        <div class="metric"><span>Protein in the batch</span><strong id="out-protein">{starter.protein} g</strong></div>
        <div class="metric"><span>Days past the fridge row</span><strong id="out-risk">{starter.riskDays}</strong></div>
        <div class="metric"><span>Cost past that row</span><strong id="out-risk-cost">{money(starter.riskCost)}</strong></div>
      </div>
      <p id="out-note" class="text-sm leading-relaxed" style="color:var(--text-color);">{defaultMode?.note}</p>
      <p class="mt-3 text-xs" style="color:var(--muted-color);">
        People, grams, days, and the food you picked stay in this browser tab. The page can record that the tool was used. It doesn't send the values you typed.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color:var(--heading-color);">The reference week, before you change a number</h2>
      <p class="mb-6 leading-relaxed" style="color:var(--text-color);">
        Four people, 50 grams of protein each, seven days. That's {REFERENCE.people * REFERENCE.gramsPerPerson * REFERENCE.days} grams. Cost is that weight divided by protein per dollar. Thirty grams of drumsticks is still {money(30 / foods.find((food) => food.id === "drumsticks").proteinPerDollar)}. Thirty grams of 80/20 ground beef is {money(30 / foods.find((food) => food.id === "ground-beef").proteinPerDollar)}. The chart uses the same division.
      </p>
      <div class="overflow-x-auto rounded-xl" style="border:1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width:760px;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--page-bg);border-bottom:1px solid var(--border-color);color:var(--heading-color);">
              <th scope="col" class="cell text-left">Food and state</th>
              <th scope="col" class="cell text-right">Protein per $1</th>
              <th scope="col" class="cell text-right">7-day cost</th>
              <th scope="col" class="cell text-left">Fridge row</th>
            </tr>
          </thead>
          <tbody>
            {foods.flatMap((food) => food.modes.map((mode) => {
              const priced = quote(food, mode, REFERENCE.people, REFERENCE.gramsPerPerson, REFERENCE.days);
              return (
                <tr style="border-bottom:1px solid var(--border-color);">
                  <th scope="row" class="cell text-left" style="font-weight:600;">{food.food}: {mode.label}</th>
                  <td class="cell text-right">{food.valueLabel} g</td>
                  <td class="cell text-right" style="font-weight:700;">{money(priced.cost)}</td>
                  <td class="cell text-left">{fridgeLabel(mode)}</td>
                </tr>
              );
            }))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm leading-relaxed" style="color:var(--muted-color);">
        {points.length} of those states are the bars. Cupboard states stay in the table because a dry lentil bag isn't a fridge problem until you cook it. Package prices are the ones in the files, not a promise about your store this week.
      </p>
    </section>

    <article class="prose-like max-w-4xl">
      <h2>The clocks don't agree, and the planner doesn't pretend they do</h2>
      <p>
        Cooked meat and poultry are 3 to 4 days. Raw poultry and raw ground meat are 1 to 2. Raw pork roasts are 3 to 5, and that ends when the roast is cooked. Those rows are on <a href="/how-long-do-cooked-meat-and-poultry-last-in-the-fridge/" class="underline" style="color:#F29B30;">how long cooked meat and poultry last in the fridge</a>. Freezer months on that page are quality at 0°F. They aren't extra fridge days.
      </p>
      <p>
        Plain cooked beans are 3 to 4 days. Cooked pasta's named FoodKeeper row is 3 to 5, and cooked rice is 4 to 6. The leftovers page still says 3 to 4. Read both on <a href="/how-long-do-cooked-grains-and-beans-last-in-the-fridge/" class="underline" style="color:#F29B30;">how long cooked grains and beans last</a>. This tool warns at the shorter end. The chart marks the named upper day so it isn't deleted.
      </p>
      <p>
        Unopened low-acid canned beans are 2 to 5 years on the shelf, then 3 to 4 days after opening. Dry rice and dried pasta are 2 years, then 3 to 4 days after cooking. Flour needs no fridge, and it doesn't get a made-up loaf clock. That's <a href="/cheapest-shelf-stable-pantry-foods-for-protein/" class="underline" style="color:#F29B30;">the shelf-stable pantry ranking</a>. A pot that is rice plus beans, instead of a protein-gram target, is the <a href="/tools/rice-and-beans-portion-and-cost-calculator/" class="underline" style="color:#F29B30;">rice and beans portion calculator</a>. Fiber, rather than protein, is the <a href="/data/produce-and-grain-fiber-index/" class="underline" style="color:#F29B30;">produce and whole-grain fiber index</a>. The price rules are on the <a href="/methodology/" class="underline" style="color:#F29B30;">methodology page</a>.
      </p>
      <h2>What I do with a seven-day pot</h2>
      <p>
        If the batch is longer than the row, the dollars past that row are the ones I'd freeze the same night or just not cook yet. A dry bag of lentils can wait. A pot of drumsticks can't. The cheap cut is still the cheap cut. It just doesn't get Thursday for free. The bone is already out of that drumstick price, which is what <a href="/boneless-vs-bone-in-chicken-and-beef-protein-cost/" class="underline" style="color:#F29B30;">bone-in versus boneless chicken and ground beef</a> counts.
      </p>
      <h2>Questions the planner actually gets</h2>
      <div class="faq-list">
        <details><summary>What does the pantry meal cost and storage planner calculate?</summary><p>It divides the protein you asked for by the protein-per-dollar figure in the published pantry, meat, and bean files, then compares your day count with the fridge row for that state of the food. A 7-day pot of cooked chicken gets a price. It doesn't get 7 fridge days.</p></details>
        <details><summary>Why doesn't a cheaper cut last longer in the fridge?</summary><p>Cooked meat and poultry are 3 to 4 days at 40°F or below. Drumsticks are about $0.60 for 30 grams of protein and 80/20 ground beef is about $2.65, both from the meat file. The cold-storage chart doesn't read the receipt. Raw poultry and raw ground meat are a shorter row, 1 to 2 days.</p></details>
        <details><summary>Where do the fridge days come from?</summary><p>Cooked meat, raw poultry, and raw roasts come from the cooked meat and poultry page. Cooked beans, and the longer named rows for pasta and rice, come from the grains and beans page. Unopened cans, dry pasta, and dry rice come from the shelf-stable pantry page. The warning uses the shorter leftovers row when those pages disagree.</p></details>
        <details><summary>What if I plan more days than the fridge row allows?</summary><p>You still see the full batch cost. You also see the dollars sitting past the cited row. Freeze that portion, or cook a shorter batch. The planner doesn't stretch the row because the week is long, and it doesn't store a new fridge time of its own.</p></details>
        <details><summary>Does the planner save what I type?</summary><p>No. People, grams, days, and the food you picked stay in this browser tab. The site can record that the tool was used. It doesn't send the household numbers or the result.</p></details>
      </div>
    </article>
  </main>
  <Footer />

  <style>
    .tool-label{display:flex;flex-direction:column;gap:.4rem;font-size:.875rem;font-weight:700;color:var(--text-color)}
    .tool-input{width:100%;border-radius:.75rem;padding:.65rem .75rem;background:var(--page-bg);border:1px solid var(--border-color);color:var(--text-color)}
    .tool-select{max-width:100%}
    .metric{display:flex;flex-direction:column;gap:.25rem;padding:1rem;border-radius:.8rem;background:var(--page-bg);border:1px solid var(--border-color);color:var(--muted-color);font-size:.78rem}
    .metric strong{font-size:1.35rem;color:var(--heading-color)}
    .metric.highlight{border:2px solid #F29B30}
    .metric.highlight strong{color:#F29B30}
    .cell{padding:.65rem}
    img{width:100%;height:auto;border-radius:1rem;border:1px solid var(--border-color)}
    .prose-like h2{font-size:1.65rem;line-height:1.2;font-weight:800;margin:2.25rem 0 .7rem;color:var(--heading-color)}
    .prose-like p{line-height:1.75;margin:.7rem 0;color:var(--text-color)}
    .prose-like a{color:#F29B30;text-decoration:underline;font-weight:700}
    .faq-list details{margin:.65rem 0;border:1px solid var(--border-color);border-radius:.75rem;background:var(--card-bg);padding:0 1rem}
    .faq-list summary{cursor:pointer;font-weight:800;padding:1rem 0;color:var(--heading-color)}
    .faq-list p{margin:0 0 1rem;line-height:1.6}
  </style>

  <script is:inline>
    (function () {
      function clamp(value, min, max, fallback) {
        var number = Math.round(Number(value));
        if (!isFinite(number)) return fallback;
        return Math.max(min, Math.min(max, number));
      }
      function money(amount) {
        var cents = Math.round((amount + Number.EPSILON) * 100);
        return "$" + (cents / 100).toFixed(2);
      }
      function boot() {
        var root = document.getElementById("pantry-planner");
        if (!root || root.dataset.booted) return;
        root.dataset.booted = "1";
        var people = root.querySelector("#people");
        var grams = root.querySelector("#grams");
        var days = root.querySelector("#days");
        var food = root.querySelector("#food");
        function render() {
          var option = food.options[food.selectedIndex];
          var perDollar = Number(option.dataset.protein);
          var fridgeMax = option.dataset.fridgeMax === "" ? null : Number(option.dataset.fridgeMax);
          var eaters = clamp(people.value, 1, 12, 4);
          var each = clamp(grams.value, 10, 200, 50);
          var batch = clamp(days.value, 1, 14, 7);
          people.value = String(eaters);
          grams.value = String(each);
          days.value = String(batch);
          var protein = eaters * each * batch;
          var riskDays = fridgeMax === null ? 0 : Math.max(0, batch - fridgeMax);
          root.querySelector("#out-cost").textContent = money(protein / perDollar);
          root.querySelector("#out-protein").textContent = protein + " g";
          root.querySelector("#out-risk").textContent = String(riskDays);
          root.querySelector("#out-risk-cost").textContent = money((eaters * each * riskDays) / perDollar);
          root.querySelector("#out-note").textContent = option.dataset.note || "";
        }
        root.addEventListener("input", render);
        root.addEventListener("change", render);
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
