---
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_ID, AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import { isIndexPruned } from "../../../content/index-prune.js";
import { isReleased } from "../../../content/release";

const pageUrl = "https://www.daily-life-hacks.com/tools/protein-per-dollar-calculator/";
const chartSrc = "/images/protein-per-dollar-calculator-chart.jpg";
const title = "Protein per Dollar Calculator: Raw vs DIAAS Daily Cost";
const description =
  "Price 50 to 150 grams of protein from audited staples. Compare raw grams per dollar with the DIAAS-adjusted cost for the same foods.";

function parseCsv(path: string) {
  const text = readFileSync(join(process.cwd(), path), "utf8");
  const lines = text.trim().split(/\r?\n/);
  const headers = lines[0].split(",").map((header) => header.trim());
  return lines.slice(1).map((line) => {
    const cells: string[] = [];
    let field = "";
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (inQuotes) {
        if (c === '"' && line[i + 1] === '"') {
          field += '"';
          i++;
        } else if (c === '"') inQuotes = false;
        else field += c;
      } else if (c === '"') inQuotes = true;
      else if (c === ",") {
        cells.push(field);
        field = "";
      } else field += c;
    }
    cells.push(field);
    const row: Record<string, string> = {};
    headers.forEach((header, index) => {
      row[header] = (cells[index] ?? "").trim();
    });
    return row;
  });
}

const EXPECTED: Record<string, { raw: string; score: string; capped: string; adjusted: string }> = {
  "Chicken drumsticks (bone-in)": { raw: "50.3", score: "1.08", capped: "1.00", adjusted: "50.3" },
  "Brown lentils (dry)": { raw: "77.7", score: "0.63", capped: "0.63", adjusted: "49.0" },
  "Chickpeas (dry)": { raw: "56.7", score: "0.83", capped: "0.83", adjusted: "47.1" },
  "Eggs (large)": { raw: "34.4", score: "1.13", capped: "1.00", adjusted: "34.4" },
  "Mozzarella (low-moisture part-skim)": { raw: "30.1", score: "1.14", capped: "1.00", adjusted: "30.1" },
  "Greek yogurt (plain, nonfat)": { raw: "27.5", score: "1.14", capped: "1.00", adjusted: "27.5" },
  "Chicken breast (boneless, skinless)": { raw: "24.6", score: "1.08", capped: "1.00", adjusted: "24.6" },
};

const LABELS: Record<string, string> = {
  "Chicken drumsticks (bone-in)": "Chicken drumsticks",
  "Brown lentils (dry)": "Brown lentils",
  "Chickpeas (dry)": "Chickpeas",
  "Eggs (large)": "Eggs",
  "Mozzarella (low-moisture part-skim)": "Mozzarella",
  "Greek yogurt (plain, nonfat)": "Greek yogurt",
  "Chicken breast (boneless, skinless)": "Chicken breast",
};

const quality = new Map(
  parseCsv("public/data/protein-quality-per-dollar-2026.csv").map((row) => [row.food, row]),
);
const protein = new Map(
  parseCsv("public/data/protein-per-dollar-2026.csv").map((row) => [row.food, row]),
);

const foods = Object.keys(EXPECTED).map((food) => {
  const expected = EXPECTED[food];
  const qualityRow = quality.get(food);
  const proteinRow = protein.get(food);
  if (!qualityRow || !proteinRow) throw new Error(`protein calculator: missing ${food}`);
  if (proteinRow.protein_g_per_dollar !== expected.raw) {
    throw new Error(`protein calculator: ${food} raw rate drifted`);
  }
  if (
    qualityRow.protein_g_per_dollar !== expected.raw ||
    qualityRow.diaas_score !== expected.score ||
    qualityRow.diaas_capped_for_multiplication !== expected.capped ||
    qualityRow.adjusted_g_per_dollar !== expected.adjusted
  ) {
    throw new Error(`protein calculator: ${food} DIAAS row drifted`);
  }
  return {
    food,
    label: LABELS[food],
    raw: Number(expected.raw),
    adjusted: Number(expected.adjusted),
    score: expected.score,
    capped: expected.capped,
  };
});

function money(value: number) {
  return `$${value.toFixed(2)}`;
}

function cost(grams: number, rate: number) {
  return money(grams / rate);
}

const targets = [25, 50, 100];
const chartAlt =
  "Chart of raw versus DIAAS-adjusted protein grams per dollar for chicken drumsticks, brown lentils, chickpeas, eggs, mozzarella, Greek yogurt, and chicken breast. Not a photograph.";

const PROTEIN_STUDY_SLUGS = [
  "high-protein-vs-high-fiber-satiety",
  "best-low-cost-protein-sources-large-families",
  "which-dried-beans-have-the-most-protein",
  "cheapest-dairy-and-soy-protein-per-dollar",
  "how-much-fiber-and-protein-per-dollar-at-walmart-vs-bls",
  "how-long-do-cooked-meat-and-poultry-last-in-the-fridge",
] as const;

const proteinStudyArticles = await getCollection("articles");
const proteinStudies = PROTEIN_STUDY_SLUGS.flatMap((slug) => {
  const onDisk = existsSync(join(process.cwd(), "src/data/articles", `${slug}.md`));
  const article = onDisk ? proteinStudyArticles.find((entry) => entry.id === slug) : undefined;
  if (!article || article.data.author !== "David Miller" || !isReleased(article)) return [];
  if (!isIndexPruned(article.id)) {
    return [{ slug, title: article.data.title }];
  }
  return [];
});

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${pageUrl}#webapp`,
    name: "Protein per Dollar Calculator",
    url: pageUrl,
    description,
    inLanguage: "en-US",
    isPartOf: { "@id": "https://www.daily-life-hacks.com/#website" },
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", "@id": AUTHOR_ID, name: AUTHOR_NAME, url: AUTHOR_URL },
    publisher: { "@id": "https://www.daily-life-hacks.com/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.daily-life-hacks.com/" },
      { "@type": "ListItem", position: 2, name: "Tools", item: "https://www.daily-life-hacks.com/tools/" },
      { "@type": "ListItem", position: 3, name: "Protein per Dollar Calculator", item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={chartSrc}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={schemas}
>
  <Header />
  <main class="max-w-6xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/tools/" class="underline" style="color:#F29B30;">Tools</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Protein per dollar calculator</span>
    </nav>

    <div class="max-w-4xl mb-8">
      <p class="text-sm font-bold uppercase tracking-widest mb-3" style="color:#F29B30;">Raw grams, then the quality cap.</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">What a Day of Protein Costs After the Score</h1>
      <p class="text-sm mb-4" style="color:var(--muted-color);">
        By <a href="/author/david-miller/" class="font-bold underline" style="color:#F29B30;">{AUTHOR_NAME}</a>
      </p>
      <p class="text-lg leading-relaxed" style="color:var(--text-color);">
        Brown lentils look heroic at 77.7 grams of protein per dollar. Multiply by the published DIAAS of 0.63 and the same dollar buys 49.0 grams. Chicken drumsticks stay at 50.3 either way, because a score of 1.08 gets capped at 1.00 before anyone does the multiplication. This protein per dollar calculator prices a 50 to 150 gram day on both scales.
      </p>
      <p class="text-lg leading-relaxed mt-4" style="color:var(--text-color);">
        It doesn't tell you how much protein to eat. It tells you what the audited staple costs once you pick a number. The image under this paragraph is a chart, not a photograph.
      </p>
    </div>

    <figure class="mb-10">
      <img
        src={chartSrc}
        width="1200"
        height="675"
        alt={chartAlt}
        class="w-full h-auto rounded-2xl"
        style="border:1px solid var(--border-color);"
      />
      <figcaption class="mt-3 text-sm" style="color:var(--muted-color);">
        Chart, not a photograph. Orange is raw grams per dollar. Slate is the DIAAS-adjusted figure, with every score above 1.00 capped at 1.00.
      </figcaption>
    </figure>

    <section id="protein-dollar-app" class="rounded-2xl p-5 md:p-7 mb-12" style="background:var(--card-bg);border:1px solid var(--border-color);">
      <div class="flex flex-wrap items-end gap-4 mb-4">
        <label class="tool-label">
          Daily protein target (grams)
          <input id="protein-target" class="tool-input" type="number" min="50" max="150" step="1" value="100" inputmode="numeric" />
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Protein target presets">
          <button type="button" class="preset" data-target-preset="50">50 g</button>
          <button type="button" class="preset" data-target-preset="75">75 g</button>
          <button type="button" class="preset" data-target-preset="100">100 g</button>
          <button type="button" class="preset" data-target-preset="125">125 g</button>
          <button type="button" class="preset" data-target-preset="150">150 g</button>
        </div>
      </div>
      <p id="protein-target-status" class="text-sm mb-4" style="color:var(--muted-color);">100 g of protein from each staple, raw and after the DIAAS cap.</p>
      <div class="overflow-x-auto rounded-xl" style="border:1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width:640px;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--page-bg);color:var(--heading-color);">
              <th scope="col" class="cell text-left">Staple</th>
              <th scope="col" class="cell text-right">Raw cost</th>
              <th scope="col" class="cell text-right">DIAAS-adjusted cost</th>
            </tr>
          </thead>
          <tbody id="protein-live-body">
            {foods.map((food) => (
              <tr style="border-bottom:1px solid var(--border-color);">
                <th scope="row" class="cell text-left">{food.label}</th>
                <td class="cell text-right">{cost(100, food.raw)}</td>
                <td class="cell text-right">{cost(100, food.adjusted)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs" style="color:var(--muted-color);">
        The gram target stays in this browser tab. The page records that the tool was used, not the number you typed. Daily cost is the target divided by grams per dollar.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color:var(--heading-color);">The seven staples, before you move the target</h2>
      <p class="mb-6 max-w-4xl" style="color:var(--text-color);">
        These rows are in the HTML on purpose. Lentils and chickpeas drop when the score is below 1. Eggs, mozzarella, Greek yogurt, drumsticks, and chicken breast don't, because their scores get capped at 1.00. A higher score here isn't a health claim. It's a published protein-quality multiplier, and this page stops it at 1.
      </p>
      <div class="overflow-x-auto rounded-xl mb-8" style="border:1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width:720px;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--page-bg);color:var(--heading-color);">
              <th scope="col" class="cell text-left">Food</th>
              <th scope="col" class="cell text-right">Raw g/$</th>
              <th scope="col" class="cell text-right">DIAAS</th>
              <th scope="col" class="cell text-right">Score used</th>
              <th scope="col" class="cell text-right">Adjusted g/$</th>
            </tr>
          </thead>
          <tbody>
            {foods.map((food) => (
              <tr style="border-bottom:1px solid var(--border-color);">
                <th scope="row" class="cell text-left">{food.label}</th>
                <td class="cell text-right">{food.raw.toFixed(1)}</td>
                <td class="cell text-right">{food.score}</td>
                <td class="cell text-right">{food.capped}</td>
                <td class="cell text-right">{food.adjusted.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-bold mb-3" style="color:var(--heading-color);">Cost of 25, 50, and 100 grams</h2>
      <p class="mb-4 max-w-4xl" style="color:var(--text-color);">
        Twenty-five grams is the portion people ask about. The field above still starts at 50 grams, because that's the bottom of the daily target this tool accepts, and it runs through 150. Fifty grams of brown lentils is {cost(50, 77.7)} raw and {cost(50, 49)} after the cap. The same 50 grams of drumsticks is {cost(50, 50.3)} either way. Double the grams and you double the money. There's no bulk discount hiding in a division problem.
      </p>
      <div class="overflow-x-auto rounded-xl" style="border:1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width:860px;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--page-bg);color:var(--heading-color);">
              <th scope="col" class="cell text-left">Food</th>
              {targets.map((grams) => (
                <>
                  <th scope="col" class="cell text-right">{grams} g raw</th>
                  <th scope="col" class="cell text-right">{grams} g DIAAS</th>
                </>
              ))}
            </tr>
          </thead>
          <tbody>
            {foods.map((food) => (
              <tr style="border-bottom:1px solid var(--border-color);">
                <th scope="row" class="cell text-left">{food.label}</th>
                {targets.map((grams) => (
                  <>
                    <td class="cell text-right">{cost(grams, food.raw)}</td>
                    <td class="cell text-right">{cost(grams, food.adjusted)}</td>
                  </>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <article class="prose-like max-w-4xl">
      <h2>Where do the protein per dollar rates come from?</h2>
      <p>
        Raw grams per dollar are the matching food rows in protein-per-dollar-2026.csv. DIAAS scores and the adjusted grams per dollar are the same foods in protein-quality-per-dollar-2026.csv. Both names are citations, not download buttons. Prices are the July 2026 study snapshot, Walmart listings and BLS city averages, matched to USDA FoodData Central. The <a href="/methodology/">methodology</a> is where the edible-fraction rules live. The longer write-up is the <a href="/protein-per-dollar-adjusted-for-quality/">protein per dollar ranking</a>, and the paper versions of the other kitchen benchmarks are on the <a href="/printables/">printable guides</a>.
      </p>
      <p>
        Chickpeas move from 56.7 to 47.1. Eggs stay at 34.4. Mozzarella stays at 30.1. Greek yogurt stays at 27.5. Chicken breast stays at 24.6. If your store's sticker doesn't match the package we priced, the rate moves and this page doesn't know your ZIP code. Treat it as the audited baseline, not a promise about today's shelf.
      </p>

      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        <details><summary>What does the protein per dollar calculator measure?</summary><p>It divides the gram target you pick by the published grams of protein one dollar buys. You get the consumed cost of that protein from one audited staple, raw and after the DIAAS cap. It isn't a meal plan, and it doesn't set how much protein you should eat.</p></details>
        <details><summary>How is DIAAS-adjusted protein per dollar different from the raw number?</summary><p>Raw grams per dollar count every gram the same. DIAAS multiplies by a quality score, and this site caps any score above 1.00 at 1.00 before the multiplication. Brown lentils drop from 77.7 to 49.0 because the published score is 0.63. Eggs stay at 34.4 because a score of 1.13 is capped.</p></details>
        <details><summary>How much does 50 grams or 100 grams of protein cost from these staples?</summary><p>At 50 grams, brown lentils are about $0.64 raw and $1.02 after the cap. Chicken drumsticks stay near $0.99 either way. At 100 grams, double those figures. The table also lists 25 grams, which is half of the 50 gram line. The interactive field itself runs from 50 to 150 grams.</p></details>
        <details><summary>Does the calculator save the protein target I enter?</summary><p>No. The target stays in this browser tab. The page doesn't send the grams you typed, and it doesn't build an account around a number you might change before dinner.</p></details>
        <details><summary>Where do the protein per dollar and DIAAS numbers come from?</summary><p>Raw rates are the audited rows in protein-per-dollar-2026.csv. DIAAS scores and adjusted rates are the matching rows in protein-quality-per-dollar-2026.csv. Prices are the July 2026 snapshot, matched to USDA FoodData Central. The methodology page covers the price rules. The filenames are cited in the text.</p></details>
      </div>

      {proteinStudies.length > 0 && (
        <section class="mt-10" aria-label="Related Protein Cost Studies and Family Prep Guides">
          <h2>Related Protein Cost Studies & Family Prep Guides</h2>
          <p>
            The calculator prices seven staples and then it stops. These six pages pick up the rest: satiety, a cart for a big household, which dry bean actually leads, dairy and soy, the Walmart versus BLS gap, and how long cooked meat lasts once the pan is cold.
            Eight 20-minute plates from the same pantry files are ranked on <a href="/20-minute-high-fiber-meals-from-pantry-staples/">20-minute high-fiber meals from pantry staples</a>.
          </p>
          <ul class="study-grid">
            {proteinStudies.map((item) => (
              <li>
                <a href={`/${item.slug}/`}>{item.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
  <Footer />

  <style>
    .tool-label{display:flex;flex-direction:column;gap:.4rem;font-size:.875rem;font-weight:700;color:var(--text-color)}
    .tool-input{width:8rem;border-radius:.75rem;padding:.65rem .75rem;background:var(--page-bg);border:1px solid var(--border-color);color:var(--text-color);outline:none}
    .tool-input:focus{box-shadow:0 0 0 2px #F29B30}
    .preset{border-radius:999px;padding:.55rem .85rem;font-size:.875rem;font-weight:800;background:var(--page-bg);color:var(--heading-color);border:1px solid var(--border-color)}
    .preset[aria-pressed="true"]{background:#F29B30;color:white;border-color:#F29B30}
    .cell{padding:.65rem}
    .prose-like h2{font-size:1.65rem;line-height:1.2;font-weight:800;margin:2.25rem 0 .7rem;color:var(--heading-color)}
    .prose-like p{line-height:1.75;margin:.7rem 0;color:var(--text-color)}
    .prose-like a{color:#F29B30;text-decoration:underline;font-weight:700}
    .faq-list details{margin:.65rem 0;border:1px solid var(--border-color);border-radius:.75rem;background:var(--card-bg);padding:0 1rem}
    .faq-list summary{cursor:pointer;font-weight:800;padding:1rem 0;color:var(--heading-color)}
    .faq-list p{margin:0 0 1rem}
    .study-grid{display:grid;grid-template-columns:1fr;gap:.75rem 1.25rem;list-style:none;padding:0;margin:1rem 0 0}
    @media (min-width:640px){.study-grid{grid-template-columns:1fr 1fr}}
  </style>

  <script is:inline>
    (function(){
      var foods=[
        {label:'Chicken drumsticks',raw:50.3,adjusted:50.3},
        {label:'Brown lentils',raw:77.7,adjusted:49.0},
        {label:'Chickpeas',raw:56.7,adjusted:47.1},
        {label:'Eggs',raw:34.4,adjusted:34.4},
        {label:'Mozzarella',raw:30.1,adjusted:30.1},
        {label:'Greek yogurt',raw:27.5,adjusted:27.5},
        {label:'Chicken breast',raw:24.6,adjusted:24.6}
      ];
      function money(value){return '$'+(isFinite(value)?value:0).toFixed(2)}
      function esc(value){return String(value).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
      function boot(){
        var root=document.getElementById('protein-dollar-app');
        if(!root||root.dataset.booted)return;
        root.dataset.booted='1';
        var input=root.querySelector('#protein-target');
        var status=root.querySelector('#protein-target-status');
        var body=root.querySelector('#protein-live-body');
        function render(){
          var typed=parseFloat(input.value);
          var presets=root.querySelectorAll('[data-target-preset]');
          if(!isFinite(typed)){
            status.textContent='Enter a target from 50 to 150 grams.';
            presets.forEach(function(button){button.setAttribute('aria-pressed','false')});
            return;
          }
          var target=Math.min(150,Math.max(50,typed));
          if(typed<50||typed>150) status.textContent='Targets on this tool run from 50 to 150 grams. Showing '+target+' g.';
          else status.textContent=target+' g of protein from each staple, raw and after the DIAAS cap.';
          presets.forEach(function(button){button.setAttribute('aria-pressed',String(Number(button.getAttribute('data-target-preset'))===target))});
          body.innerHTML=foods.map(function(food){
            var rawCost=target/food.raw;
            var adjustedCost=target/food.adjusted;
            return '<tr style="border-bottom:1px solid var(--border-color);"><th scope="row" class="cell text-left">'+esc(food.label)+'</th><td class="cell text-right">'+money(rawCost)+'</td><td class="cell text-right">'+money(adjustedCost)+'</td></tr>';
          }).join('');
        }
        root.addEventListener('input',render);
        root.querySelectorAll('[data-target-preset]').forEach(function(button){
          button.addEventListener('click',function(){
            input.value=button.getAttribute('data-target-preset');
            render();
          });
        });
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
