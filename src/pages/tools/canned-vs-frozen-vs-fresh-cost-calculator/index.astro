---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { AUTHOR_ID, AUTHOR_NAME, AUTHOR_URL } from "../../../content/author";
import { parseCsv } from "../../../content/price-basis.mjs";
import { CUPS_COOKED_PER_CAN, CUPS_COOKED_PER_POUND } from "../../../lib/bean-crowd-math.js";

type Row = Record<string, string>;

function rowsFrom(fileName: string): Row[] {
  const parsed = parseCsv(readFileSync(join(process.cwd(), "public/data", fileName), "utf8"));
  return parsed.rows.map((cells) =>
    Object.fromEntries(parsed.header.map((name, index) => [name, cells[index] ?? ""])),
  );
}

function must(rows: Row[], food: string, fileName: string) {
  const row = rows.find((item) => item.food === food);
  if (!row) throw new Error(`Missing ${food} in ${fileName}`);
  return row;
}

function money(value: number) {
  const cents = Math.floor(value * 100 + 0.5 + 1e-9);
  return `$${(cents / 100).toFixed(2)}`;
}

function oneDecimal(value: number) {
  return (Math.floor(value * 10 + 0.5 + 1e-9) / 10).toFixed(1);
}

function whole(value: number) {
  return String(Math.floor(value + 0.5));
}

const fiberFile = "fiber-per-dollar-2026.csv";
const beanFile = "canned-vs-dry-beans-cost-2026.csv";
const produceFile = "produce-fiber-per-dollar-ranked-2026.csv";
const proteinFile = "protein-per-dollar-2026.csv";
const sodiumFile = "sodium-per-dollar-2026.csv";
const fiber = rowsFrom(fiberFile);
const beans = rowsFrom(beanFile);
const produce = rowsFrom(produceFile);
const protein = rowsFrom(proteinFile);
const sodium = rowsFrom(sodiumFile);
const cache = JSON.parse(readFileSync(join(process.cwd(), "src/data/fdc-cache.json"), "utf8")) as {
  foods: Record<string, { portions: { modifier: string; grams: number }[] }>;
};
const peaCup = cache.foods["170016"]?.portions.find((item) => item.modifier === "cup")?.grams;
if (peaCup !== 134) throw new Error("frozen pea cup weight drifted");

function samePrice(food: string, priceRows: Row[], fileName: string) {
  const fiberRow = must(fiber, food, fiberFile);
  const priceRow = must(priceRows, food, fileName);
  if (fiberRow.package_price_usd !== priceRow.package_price_usd) {
    throw new Error(`${food} price disagrees between ${fiberFile} and ${fileName}`);
  }
  if (fiberRow.package !== priceRow.package) {
    throw new Error(`${food} package disagrees between ${fiberFile} and ${fileName}`);
  }
  return fiberRow;
}

const dryFiber = samePrice("Black beans (dry)", beans, beanFile);
const cannedFiber = samePrice("Canned black beans", beans, beanFile);
const frozenFiber = samePrice("Frozen green peas", produce, produceFile);
const freshFiber = samePrice("Green cabbage", produce, produceFile);
if (dryFiber.fiber_g_per_dollar !== "41.6" || beans.find((row) => row.food === "Black beans (dry)")?.value !== "58.0") {
  throw new Error("dry black bean rates drifted");
}
if (cannedFiber.fiber_g_per_dollar !== "34.4" || beans.find((row) => row.food === "Canned black beans")?.value !== "30.1") {
  throw new Error("canned black bean rates drifted");
}
if (frozenFiber.fiber_g_per_dollar !== "17.6" || produce.find((row) => row.food === "Frozen green peas")?.value !== "17.6") {
  throw new Error("frozen pea fiber rate drifted");
}
if (freshFiber.fiber_g_per_dollar !== "14.6" || produce.find((row) => row.food === "Green cabbage")?.value !== "14.6") {
  throw new Error("cabbage fiber rate drifted");
}

function proteinRate(food: string) {
  const row = protein.find((item) => item.food === food);
  return row?.protein_g_per_dollar ? Number(row.protein_g_per_dollar) : null;
}

function sodiumMg(food: string) {
  const row = sodium.find((item) => item.food === food);
  return row?.sodium_mg_per_100g ? row.sodium_mg_per_100g : "";
}

const cannedNote = must(protein, "Canned black beans", proteinFile).nutrition_source_note ?? "";
const cannedSodiumMatch = cannedNote.match(/sodium, (\d+) vs (\d+) mg/);
if (!cannedSodiumMatch || cannedSodiumMatch[1] !== "384") {
  throw new Error("canned black bean sodium note drifted");
}
if (sodiumMg("Black beans (dry)") !== "5" || sodiumMg("Frozen green peas") !== "108" || sodiumMg("Green cabbage") !== "18") {
  throw new Error("sodium file rates drifted");
}
if (proteinRate("Black beans (dry)") !== 58 || proteinRate("Canned black beans") !== 30.1 || proteinRate("Frozen green peas") !== 20.4) {
  throw new Error("protein per dollar drifted");
}
if (proteinRate("Green cabbage") !== null) throw new Error("cabbage gained a protein row; show it");

const poundMatch = dryFiber.package.match(/^(\d+(?:\.\d+)?) lb/);
if (!poundMatch) throw new Error("dry bean package is no longer a pound bag");
const dryCups = Number(poundMatch[1]) * CUPS_COOKED_PER_POUND;
const frozenCups = Number(frozenFiber.package_weight_g) / peaCup;
const freshGrams = Number(freshFiber.package_weight_g) * Number(freshFiber.edible_fraction);

type Slot = {
  id: string;
  format: string;
  food: string;
  file: string;
  packageLabel: string;
  price: number;
  fiberRate: number;
  proteinRate: number | null;
  sodium: string;
  yieldPackage: number;
  yieldUnit: string;
  yieldDigits: 0 | 1;
  prep: string;
};

const slots: Slot[] = [
  {
    id: "dry",
    format: "Dry",
    food: "Black beans (dry)",
    file: beanFile,
    packageLabel: dryFiber.package,
    price: Number(dryFiber.package_price_usd),
    fiberRate: Number(dryFiber.fiber_g_per_dollar),
    proteinRate: proteinRate("Black beans (dry)"),
    sodium: sodiumMg("Black beans (dry)"),
    yieldPackage: dryCups,
    yieldUnit: "cooked cups",
    yieldDigits: 1,
    prep: "Soak, then about 90 minutes of simmer.",
  },
  {
    id: "canned",
    format: "Canned",
    food: "Canned black beans",
    file: beanFile,
    packageLabel: cannedFiber.package,
    price: Number(cannedFiber.package_price_usd),
    fiberRate: Number(cannedFiber.fiber_g_per_dollar),
    proteinRate: proteinRate("Canned black beans"),
    sodium: cannedSodiumMatch[1],
    yieldPackage: CUPS_COOKED_PER_CAN,
    yieldUnit: "drained cups",
    yieldDigits: 1,
    prep: "Already cooked. Open the can.",
  },
  {
    id: "frozen",
    format: "Frozen",
    food: "Frozen green peas",
    file: produceFile,
    packageLabel: frozenFiber.package,
    price: Number(frozenFiber.package_price_usd),
    fiberRate: Number(frozenFiber.fiber_g_per_dollar),
    proteinRate: proteinRate("Frozen green peas"),
    sodium: sodiumMg("Frozen green peas"),
    yieldPackage: frozenCups,
    yieldUnit: "unprepared cups",
    yieldDigits: 1,
    prep: "Sold unprepared. This page doesn't publish a minute count.",
  },
  {
    id: "fresh",
    format: "Fresh",
    food: "Green cabbage",
    file: produceFile,
    packageLabel: freshFiber.package,
    price: Number(freshFiber.package_price_usd),
    fiberRate: Number(freshFiber.fiber_g_per_dollar),
    proteinRate: null,
    sodium: sodiumMg("Green cabbage"),
    yieldPackage: freshGrams,
    yieldUnit: "edible grams",
    yieldDigits: 0,
    prep: "No stove. You chop it.",
  },
];

function fiberCost(slot: Slot, price = slot.price) {
  return money((10 / slot.fiberRate) * (price / slot.price));
}

function proteinCost(slot: Slot, price = slot.price) {
  if (slot.proteinRate == null) return "not in the file";
  return money((20 / slot.proteinRate) * (price / slot.price));
}

function yieldText(slot: Slot, price = slot.price) {
  const perDollar = slot.yieldPackage / price;
  const shown = slot.yieldDigits === 0 ? whole(perDollar) : oneDecimal(perDollar);
  return `${shown} ${slot.yieldUnit}`;
}

if (fiberCost(slots[0]) !== "$0.24" || fiberCost(slots[1]) !== "$0.29") throw new Error("bean fiber cost drifted");
if (fiberCost(slots[2]) !== "$0.57" || fiberCost(slots[3]) !== "$0.68") throw new Error("produce fiber cost drifted");
if (proteinCost(slots[0]) !== "$0.34" || proteinCost(slots[1]) !== "$0.66" || proteinCost(slots[2]) !== "$0.98") {
  throw new Error("protein cost drifted");
}
if (yieldText(slots[0]) !== "3.6 cooked cups") throw new Error(`dry yield drifted: ${yieldText(slots[0])}`);
if (yieldText(slots[1]) !== "1.7 drained cups") throw new Error(`can yield drifted: ${yieldText(slots[1])}`);

const clientJson = JSON.stringify({
  slots: slots.map((slot) => ({
    id: slot.id,
    price: slot.price,
    fiberRate: slot.fiberRate,
    proteinRate: slot.proteinRate,
    yieldPackage: slot.yieldPackage,
    yieldUnit: slot.yieldUnit,
    yieldDigits: slot.yieldDigits,
  })),
}).replace(/</g, "\\u003c");

const siteUrl = "https://www.daily-life-hacks.com";
const pageUrl = `${siteUrl}/tools/canned-vs-frozen-vs-fresh-cost-calculator/`;
const title = "Canned vs. Frozen vs. Fresh vs. Dry Nutrition & Cost Calculator";
const description =
  "Type a shelf price for fresh cabbage, frozen peas, canned black beans, and dry black beans. See yield, fiber, protein, and sodium.";
const chart = "/images/canned-vs-frozen-vs-fresh-cost-calculator-chart.jpg";
const chartAlt =
  "Bar chart of the cost of 10 grams of fiber for dry black beans, canned black beans, frozen green peas, and fresh green cabbage at published package prices";

const person = {
  "@type": "Person",
  "@id": AUTHOR_ID,
  name: AUTHOR_NAME,
  url: AUTHOR_URL,
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${pageUrl}#webapp`,
  name: title,
  url: pageUrl,
  description,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript for the shelf-price fields. The reference table is in the page.",
  isAccessibleForFree: true,
  inLanguage: "en-US",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: person,
  publisher: { "@id": `${siteUrl}/#organization` },
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools/` },
    { "@type": "ListItem", position: 3, name: "Four-format shelf price calculator", item: pageUrl },
  ],
};

const linkClass = "underline";
const linkStyle = "color:#F29B30;";
---

<BaseLayout
  title={title}
  description={description}
  image={chart}
  canonicalURL={pageUrl}
  author={AUTHOR_NAME}
  authorUrl={AUTHOR_URL}
  jsonLd={[appSchema, breadcrumbSchema]}
>
  <Header />
  <main class="max-w-6xl mx-auto px-4 py-10 md:py-16">
    <nav class="text-sm mb-5" aria-label="Breadcrumb">
      <a href="/" class={linkClass} style={linkStyle}>Home</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / </span>
      <a href="/tools/" class={linkClass} style={linkStyle}>Tools</a>
      <span aria-hidden="true" style="color:var(--muted-color);"> / Four-format shelf price calculator</span>
    </nav>

    <div class="max-w-4xl mb-8">
      <p class="text-sm font-bold uppercase tracking-widest mb-3" style="color:#F29B30;">By <a href="/author/david-miller/" class={linkClass} style={linkStyle}>{AUTHOR_NAME}</a>. Four packages, four clocks.</p>
      <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color:var(--heading-color);">Type your shelf price for fresh, frozen, canned, and dry</h1>
      <p class="text-lg leading-relaxed" style="color:var(--text-color);">
        Dry black beans are {fiberCost(slots[0])} for 10 g of fiber and {proteinCost(slots[0])} for 20 g of protein, from the {slots[0].packageLabel} at {money(slots[0].price)}. The can is {fiberCost(slots[1])} and {proteinCost(slots[1])} at {money(slots[1].price)}. Frozen peas are {fiberCost(slots[2])} for the fiber and {proteinCost(slots[2])} for the protein. A pound of green cabbage is {fiberCost(slots[3])} for 10 g of fiber, and the protein file has no row for it.
      </p>
      <p class="text-lg leading-relaxed mt-4" style="color:var(--text-color);">
        The <a href="/data/canned-vs-dry-beans-and-pantry-cost-index/" class={linkClass} style={linkStyle}>canned versus dry pantry index</a> sorts a fixed cupboard of dry beans, cans, and other shelf-stable foods. This page takes the price printed on one fresh vegetable, one frozen bag, one can, and one dry bag, then reprices the yield, the fiber, and the protein. Sodium stays in milligrams per 100 g, because a sale tag doesn't change the can.
      </p>
    </div>

    <figure class="mb-10">
      <img src={chart} width="1200" height="675" alt={chartAlt} />
      <figcaption class="mt-3 text-sm leading-relaxed" style="color:var(--muted-color);">
        Not a photograph, and not an AI illustration.
        Bars are 10 g of fiber divided by the fiber-per-dollar rate in {fiberFile}. Dry black beans {fiberCost(slots[0])}, canned black beans {fiberCost(slots[1])}, frozen green peas {fiberCost(slots[2])}, green cabbage {fiberCost(slots[3])}. A price you type below stays off this chart.
      </figcaption>
    </figure>

    <section id="format-cost-calculator" class="rounded-2xl p-5 md:p-7 mb-12" style="background:var(--card-bg);border:1px solid var(--border-color);">
      <h2 class="text-xl md:text-2xl font-bold mb-2" style="color:var(--heading-color);">Price the published package</h2>
      <p class="mb-5 text-sm leading-relaxed" style="color:var(--text-color);">
        Each box is one package from the file: the {slots[0].packageLabel}, the {slots[1].packageLabel}, the {slots[2].packageLabel}, and cabbage {slots[3].packageLabel}. Type what that package costs at your store. A different size is a different row, and this page won't invent it.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        {slots.map((slot) => (
          <label class="tool-label">{slot.format}: {slot.food}
            <input id={`price-${slot.id}`} class="tool-input" type="number" min="0.01" max="99" step="0.01" value={slot.price.toFixed(2)} inputmode="decimal" />
          </label>
        ))}
      </div>
      <p class="mb-4">
        <button id="reset-prices" type="button">Use the file prices</button>
      </p>
      <div class="overflow-x-auto rounded-xl" style="border:1px solid var(--border-color);">
        <table class="w-full text-sm" style="min-width:760px;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--page-bg);border-bottom:1px solid var(--border-color);color:var(--heading-color);">
              <th scope="col" class="cell text-left">Format</th>
              <th scope="col" class="cell text-right">10 g fiber</th>
              <th scope="col" class="cell text-right">20 g protein</th>
              <th scope="col" class="cell text-right">Yield per $</th>
              <th scope="col" class="cell text-right">Sodium mg/100 g</th>
            </tr>
          </thead>
          <tbody>
            {slots.map((slot) => (
              <tr style="border-bottom:1px solid var(--border-color);">
                <th scope="row" class="cell text-left" style="font-weight:600;">{slot.format}</th>
                <td id={`fiber-${slot.id}`} class="cell text-right">{fiberCost(slot)}</td>
                <td id={`protein-${slot.id}`} class="cell text-right">{proteinCost(slot)}</td>
                <td id={`yield-${slot.id}`} class="cell text-right">{yieldText(slot)}</td>
                <td class="cell text-right">{slot.sodium}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="prep-note" class="mt-4 text-sm leading-relaxed" style="color:var(--text-color);">
        {slots.map((slot) => `${slot.format}: ${slot.prep}`).join(" ")}
      </p>
      <p class="mt-3 text-xs" style="color:var(--muted-color);">
        The prices you type stay in this browser tab. The page can record that the tool was used. It doesn't send the values you typed.
      </p>
    </section>

    <article class="prose-like max-w-4xl">
      <h2>Four formats, and only the beans are the same food</h2>
      <p>
        Dry black beans and the can are the same bean at two stages. Frozen green peas are a vegetable. Green cabbage is another vegetable. The chart puts one published food in each format so the dollar has somewhere to land. A cabbage leaf isn't a black bean with a different sticker.
      </p>
      <p>
        Package prices for the beans are {beanFile}. Frozen peas and cabbage are {produceFile}. Fiber grams per dollar, checked against those prices, are {fiberFile}. Protein grams per dollar are {proteinFile}. Sodium milligrams per 100 g for the dry beans, the peas, and the cabbage are {sodiumFile}. The can's 384 mg is the regular-sodium figure in the protein file's note, 384 versus 138. The sodium file doesn't carry that can, and the dry bag in the sodium file is a different sticker, so the price here stays {money(slots[0].price)}.
      </p>
      <h2>The yield unit changes with the format</h2>
      <p>
        Two pounds of dry beans cook to about {oneDecimal(dryCups)} cups, at {CUPS_COOKED_PER_POUND} cups per pound. That's {yieldText(slots[0])} at the file price. One can is {CUPS_COOKED_PER_CAN} drained cups, {yieldText(slots[1])} at {money(slots[1].price)}. The fiber on that can is the undrained 439 g, solids and liquids. The cup is the drained kitchen measure. Rinsing the liquid doesn't rewrite either number.
      </p>
      <p>
        Frozen peas are priced unprepared. USDA's cup on FDC 170016 is {peaCup} g, so the {slots[2].packageLabel} is {oneDecimal(frozenCups)} cups and {yieldText(slots[2])} at {money(slots[2].price)}. Cabbage is {whole(freshGrams)} edible grams in the {slots[3].packageLabel}, {yieldText(slots[3])} at {money(slots[3].price)}. Cups and grams stay labeled. I won't rank them as if they were the same scoop.
      </p>
      <h2>Where the longer comparisons live</h2>
      <p>
        Dry bags, frozen peas, and cans on one published chart are <a href="/how-much-protein-and-fiber-in-canned-vs-frozen-vs-dry-staples/" class={linkClass} style={linkStyle}>canned, frozen, and dry staples</a>. The freezer aisle on its own is <a href="/cheapest-frozen-vegetables-for-fiber-and-protein/" class={linkClass} style={linkStyle}>the cheapest frozen vegetables for fiber and protein</a>. Fresh produce ranked by fiber per dollar is <a href="/cheapest-high-fiber-fruits-and-vegetables/" class={linkClass} style={linkStyle}>high-fiber fruits and vegetables per dollar</a>. The bean markup, sodium included, is <a href="/canned-vs-dry-beans-cost-and-sodium-per-serving/" class={linkClass} style={linkStyle}>canned versus dry beans, cost and sodium per serving</a>. The price rules are on the <a href="/methodology/" class={linkClass} style={linkStyle}>methodology page</a>.
      </p>
      <h2>Questions the calculator actually gets</h2>
      <div class="faq-list">
        <details>
          <summary>How is this different from the canned versus dry pantry index?</summary>
          <p>The pantry index sorts published dry, canned, and shelf-stable rows and leaves the sticker alone. This calculator takes a shelf price for fresh cabbage, frozen peas, canned black beans, and dry black beans, then reprices 10 g of fiber, 20 g of protein, and the yield. Fresh and frozen are on this page. The index's job is the cupboard sort.</p>
        </details>
        <details>
          <summary>What changes when I type my store's price?</summary>
          <p>The package weight, the nutrient density, and the sodium stay put. The dollar rates scale with the price. Dry black beans at {money(slots[0].price)} are {fiberCost(slots[0])} for 10 g of fiber. At twice that sticker they are {fiberCost(slots[0], slots[0].price * 2)}. Protein moves the same way, from {proteinCost(slots[0])} to {proteinCost(slots[0], slots[0].price * 2)}.</p>
        </details>
        <details>
          <summary>Why is there no protein cost for green cabbage?</summary>
          <p>{proteinFile} has no green cabbage row, and {sodiumFile} leaves that protein cell blank. The 20 g protein line stays "not in the file." Carrots lead the fresh rows in {produceFile} at 16.1 g of fiber per dollar, and they don't get a borrowed protein number either.</p>
        </details>
        <details>
          <summary>Why is the can's cup drained while the fiber is undrained?</summary>
          <p>The kitchen yield on this site is {CUPS_COOKED_PER_CAN} drained cups per 15.5 oz can. The fiber and protein rows price the whole can, 439 g, solids and liquids. FDC 175188 is that undrained basis. Draining the liquid changes the plate. It doesn't change the file.</p>
        </details>
        <details>
          <summary>Does the calculator save the prices I type?</summary>
          <p>No. The four prices stay in this browser tab. The site can record that the tool was used. It doesn't receive the sticker or the result.</p>
        </details>
      </div>
    </article>
  </main>
  <Footer />

  <style>
    .tool-label{display:flex;flex-direction:column;gap:.4rem;font-size:.875rem;font-weight:700;color:var(--text-color)}
    .tool-input{width:100%;border-radius:.75rem;padding:.65rem .75rem;background:var(--page-bg);border:1px solid var(--border-color);color:var(--text-color)}
    .cell{padding:.65rem}
    img{width:100%;height:auto;border-radius:1rem;border:1px solid var(--border-color)}
    button{background:#F29B30;color:#fff;border:0;border-radius:999px;padding:.65rem 1rem;font-weight:800;cursor:pointer}
    .prose-like h2{font-size:1.65rem;line-height:1.2;font-weight:800;margin:2.25rem 0 .7rem;color:var(--heading-color)}
    .prose-like p{line-height:1.75;margin:.7rem 0;color:var(--text-color)}
    .faq-list details{margin:.65rem 0;border:1px solid var(--border-color);border-radius:.75rem;background:var(--card-bg);padding:0 1rem}
    .faq-list summary{cursor:pointer;font-weight:800;padding:1rem 0;color:var(--heading-color)}
    .faq-list p{margin:0 0 1rem;line-height:1.6}
  </style>

  <script id="format-cost-data" type="application/json" set:html={clientJson}></script>
  <script is:inline>
    (function () {
      function money(amount) {
        var cents = Math.floor(amount * 100 + 0.5 + 1e-9);
        var whole = Math.floor(cents / 100);
        var frac = String(cents % 100).padStart(2, "0");
        return "$" + whole + "." + frac;
      }
      function one(value) {
        var tenths = Math.floor(value * 10 + 0.5 + 1e-9);
        return (tenths / 10).toFixed(1);
      }
      function whole(value) {
        return String(Math.floor(value + 0.5));
      }
      function clamp(value, fallback) {
        var number = Number(value);
        if (!isFinite(number)) return fallback;
        return Math.max(0.01, Math.min(99, number));
      }
      function boot() {
        var root = document.getElementById("format-cost-calculator");
        if (!root || root.getAttribute("data-booted") === "1") return;
        var dataNode = document.getElementById("format-cost-data");
        if (!dataNode) return;
        root.setAttribute("data-booted", "1");
        var data = JSON.parse(dataNode.textContent);
        function render() {
          data.slots.forEach(function (slot) {
            var input = root.querySelector("#price-" + slot.id);
            var price = clamp(input.value, slot.price);
            input.value = price.toFixed(2);
            var fiber = (10 / slot.fiberRate) * (price / slot.price);
            root.querySelector("#fiber-" + slot.id).textContent = money(fiber);
            var proteinCell = root.querySelector("#protein-" + slot.id);
            if (slot.proteinRate == null) proteinCell.textContent = "not in the file";
            else proteinCell.textContent = money((20 / slot.proteinRate) * (price / slot.price));
            var perDollar = slot.yieldPackage / price;
            var shown = slot.yieldDigits === 0 ? whole(perDollar) : one(perDollar);
            root.querySelector("#yield-" + slot.id).textContent = shown + " " + slot.yieldUnit;
          });
        }
        root.addEventListener("input", render);
        root.querySelector("#reset-prices").addEventListener("click", function () {
          data.slots.forEach(function (slot) {
            root.querySelector("#price-" + slot.id).value = slot.price.toFixed(2);
          });
          render();
        });
        render();
      }
      boot();
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</BaseLayout>
