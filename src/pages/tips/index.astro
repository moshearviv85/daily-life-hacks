---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { isReleased, getReleaseTimestamp } from "../../content/release";

const allArticles = await getCollection("articles");
const articles = allArticles
    .filter((article: any) => isReleased(article))
    .filter((article: any) => article.data.category === "tips")
    .sort((a: any, b: any) => getReleaseTimestamp(b) - getReleaseTimestamp(a));

const BATCH_SIZE = 12;
const title = "Kitchen Tips, Storage Hacks & Money Savers | Daily Life Hacks";
const description =
    "Practical kitchen tips, food storage hacks, and budget-friendly tricks to make your daily life easier and more efficient.";
const categoryUrl = "https://www.daily-life-hacks.com/tips/";
const itemListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${categoryUrl}#item-list`,
    name: "Kitchen Tips, Storage Hacks, and Money Savers",
    numberOfItems: articles.length,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    itemListElement: articles.map((article: any, index: number) => ({
        "@type": "ListItem",
        position: index + 1,
        name: article.data.title,
        url: `https://www.daily-life-hacks.com/${article.id}/`,
    })),
};
const collectionPageSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${categoryUrl}#webpage`,
    name: "Kitchen Tips, Storage Hacks, and Money Savers",
    url: categoryUrl,
    description,
    inLanguage: "en-US",
    isPartOf: { "@id": "https://www.daily-life-hacks.com/#website" },
    publisher: { "@id": "https://www.daily-life-hacks.com/#organization" },
    breadcrumb: { "@id": `${categoryUrl}#breadcrumb` },
    mainEntity: { "@id": `${categoryUrl}#item-list` },
};
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${categoryUrl}#breadcrumb`,
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.daily-life-hacks.com/" },
        { "@type": "ListItem", position: 2, name: "Tips", item: categoryUrl },
    ],
};
---

<BaseLayout
    title={title}
    description={description}
    jsonLd={[collectionPageSchema, itemListSchema, breadcrumbSchema]}
>
    <Header />
    <div class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-12 text-center">
            <h1
                class="text-4xl md:text-5xl font-bold mb-4 text-[var(--heading-color)]"
            >
                Tips
            </h1>
            <p
                class="text-xl max-w-2xl mx-auto"
                style="color: var(--muted-color);"
            >
                {description}
            </p>
        </header>

        <!-- ArticleCard renders an h3. Without this h2 the outline jumps h1 -> h3. -->
        <h2 class="text-2xl font-bold mb-6 text-[var(--heading-color)]">
            All kitchen and money-saving tips ({articles.length})
        </h2>

        <div
            id="articles-grid"
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
        >
            {
                articles.map((article: any, i: number) => (
                    <div
                        class="article-item"
                        data-index={i}
                        style={i >= BATCH_SIZE ? "display:none" : ""}
                    >
                        <ArticleCard
                            title={article.data.title}
                            excerpt={article.data.excerpt}
                            image={article.data.image}
                            imageAlt={article.data.imageAlt}
                            category={article.data.category}
                            slug={article.id}
                            date={article.data.date}
                            fillHeight={true}
                        />
                    </div>
                ))
            }
        </div>

        {
            articles.length === 0 && (
                <div class="text-center py-12">
                    <p class="text-lg" style="color: var(--label-color);">
                        No tips found yet. Check back soon!
                    </p>
                </div>
            )
        }

        <div id="load-sentinel" class="h-4"></div>
        <div
            id="loading-spinner"
            class="hidden text-center py-6 text-sm"
            style="color: var(--muted-color);"
        >
            Loading more...
        </div>
    </div>
    <Footer />
</BaseLayout>

<!-- Infinite scroll handled by shared script in BaseLayout -->
