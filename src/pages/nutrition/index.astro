---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CategoryTopicHub from "../../components/CategoryTopicHub.astro";
import { getCollection } from "astro:content";
import { isReleased } from "../../content/release";
import {
  CATEGORY_HUB_BY_CATEGORY,
  assembleHub,
  itemListSchema,
} from "../../content/category-hubs";

const hub = CATEGORY_HUB_BY_CATEGORY.get("nutrition")!;
const allArticles = await getCollection("articles");
const records = allArticles
  .filter((article) => isReleased(article))
  .map((article) => ({
    slug: article.id,
    title: article.data.title,
    category: article.data.category,
  }));
const { topics, alphabetical } = assembleHub(hub, records);

const title = "Nutrition Tips & Science-Backed Advice | Daily Life Hacks";
const description = hub.intro;
const categoryUrl = "https://www.daily-life-hacks.com/nutrition/";
const listName = "Nutrition Tips and Science-Backed Advice";
const itemList = itemListSchema(`${categoryUrl}#item-list`, listName, alphabetical);
const topicLists = topics.map((topic) =>
  itemListSchema(`${categoryUrl}#${topic.id}`, topic.title, topic.articles),
);
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${categoryUrl}#webpage`,
  name: listName,
  url: categoryUrl,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": "https://www.daily-life-hacks.com/#website" },
  publisher: { "@id": "https://www.daily-life-hacks.com/#organization" },
  breadcrumb: { "@id": `${categoryUrl}#breadcrumb` },
  mainEntity: { "@id": `${categoryUrl}#item-list` },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${categoryUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.daily-life-hacks.com/" },
    { "@type": "ListItem", position: 2, name: "Nutrition", item: categoryUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[collectionPageSchema, itemList, ...topicLists, breadcrumbSchema]}
>
  <Header />
  <div class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--heading-color)]">
        Nutrition
      </h1>
      <p class="text-xl max-w-2xl mx-auto" style="color: var(--muted-color);">
        {description}
      </p>
    </header>

    <CategoryTopicHub topics={topics} articles={alphabetical} />
  </div>
  <Footer />
</BaseLayout>
