---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { isReleased } from "../../content/release";
import {
  CONTENT_CLUSTERS,
  inferLegacyCluster,
  type ContentClusterId,
} from "../../content/clusters";
import { resolveArticleCluster } from "../../content/relatedArticleScoring.js";
import { isGuideHubSpoke } from "../../content/guideHubSpokes.js";
import { HUGGINGFACE_DATASET_URL } from "../../content/datasets";

const title = "Complete Guides | Daily Life Hacks";
const description =
  "Start with four complete guides on fiber, protein, grocery budgets, and meal prep, then use the supporting articles and free calculators.";

const allArticles = await getCollection("articles");
const released = allArticles.filter((a) => isReleased(a));

const spokesByCluster = CONTENT_CLUSTERS.reduce(
  (groups, cluster) => {
    groups[cluster.id] = [];
    return groups;
  },
  {} as Record<ContentClusterId, { id: string; title: string }[]>,
);

const pillarIds = new Set<string>(
  CONTENT_CLUSTERS.map((cluster) => cluster.parentPillar),
);

for (const article of released) {
  if (pillarIds.has(article.id)) continue;
  if (!isGuideHubSpoke(article.id)) continue;
  const hay = [article.data.title, ...article.data.tags, article.id].join(" ");
  const resolution = resolveArticleCluster({
    articleId: article.id,
    explicitCluster: article.data.cluster,
    explicitParentPillar: article.data.parentPillar,
    clusters: CONTENT_CLUSTERS,
    inferLegacy: inferLegacyCluster,
    legacyText: hay,
  });
  if (!resolution) continue;
  const clusterId = resolution.cluster.id as ContentClusterId;
  spokesByCluster[clusterId].push({
    id: article.id,
    title: article.data.title,
  });
}

for (const key of Object.keys(spokesByCluster) as Array<keyof typeof spokesByCluster>) {
  spokesByCluster[key].sort((a, b) => a.title.localeCompare(b.title));
}

const guidesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Complete Guides",
  url: "https://www.daily-life-hacks.com/guides/",
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "Daily Life Hacks",
    url: "https://www.daily-life-hacks.com",
  },
};
---

<BaseLayout title={title} description={description} jsonLd={guidesSchema}>
  <Header />
  <main class="max-w-4xl mx-auto px-4 py-12 md:py-16">
    <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--heading-color);">
      Guides
    </h1>
    <p class="text-lg mb-5" style="color: var(--text-color);">
      Four complete playbooks. Pick the job you care about, then use the linked
      articles for the next step.
    </p>
    <p class="text-lg mb-5" style="color: var(--text-color);">
      The fiber and protein playbooks keep landing on the same July 2026 grocery math:
      {" "}
      <a href="/fiber-per-dollar-cheapest-high-fiber-foods/" class="underline" style="color: #F29B30;">53 foods ranked by fiber per dollar</a>
      {" "}and the{" "}
      <a href="/cheapest-protein-per-gram/" class="underline" style="color: #F29B30;">cheapest protein per gram ranking</a>
      {" "}of the 49-food protein table. If you want to cite or reuse the rows, start at the
      {" "}
      <a href="/data/fiber-per-dollar-2026/" class="underline" style="color: #F29B30;">fiber CSV</a>,
      {" "}the{" "}
      <a href="/data/protein-per-dollar-2026/" class="underline" style="color: #F29B30;">protein CSV</a>,
      {" "}or the{" "}
      <a href={HUGGINGFACE_DATASET_URL} class="underline" style="color: #F29B30;" rel="noopener" target="_blank">Hugging Face mirror</a>.
    </p>
    <p class="text-lg mb-10" style="color: var(--text-color);">
      Grocery nutrition generally comes from USDA FoodData Central;
      restaurant comparisons use chain-published nutrition, and three published datasets carry the
      same recorded TVP product-label value. USDA publishes no textured vegetable protein record, so
      that row cites the manufacturer's own label and is labelled as such. DIAAS inputs cite
      row-level literature or the FAO 2013 report.
      See <a href="/methodology/" class="underline" style="color: #F29B30;">how we check the math</a>.
    </p>

    <div class="space-y-10 mb-16">
      {
        CONTENT_CLUSTERS.map((cluster) => {
          const spokes = spokesByCluster[cluster.id];
          return (
            <section
              class="rounded-xl p-6 md:p-8"
              style="background-color: var(--card-bg); border: 1px solid var(--border-color);"
            >
              <p
                class="text-xs font-bold uppercase tracking-[0.18em] mb-2"
                style="color: #F29B30;"
              >
                {cluster.label} pillar
              </p>
              <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--heading-color);">
                <a href={`/${cluster.parentPillar}/`} class="hover:text-[#F29B30] transition-colors">
                  {cluster.title}
                </a>
              </h2>
              <p class="mb-5" style="color: var(--muted-color);">
                {cluster.blurb}
              </p>
              {
                cluster.id === "budget-fiber" && (
                  <p class="mb-5" style="color: var(--text-color);">
                    The short $1 cut is{" "}
                    <a
                      href="/one-dollar-fiber-what-it-buys/"
                      class="underline"
                      style="color: #F29B30;"
                    >
                      what one dollar of fiber buys
                    </a>
                    .
                  </p>
                )
              }
              <a
                href={`/${cluster.parentPillar}/`}
                class="inline-flex font-bold mb-6"
                style="color: #F29B30;"
              >
                Read the full guide
              </a>
              {
                spokes.length > 0 && (
                  <div>
                    <h3
                      class="text-sm font-bold uppercase tracking-wider mb-3"
                      style="color: var(--heading-color);"
                    >
                      Related articles
                    </h3>
                    <ul class="grid gap-2 sm:grid-cols-2">
                      {spokes.map((spoke) => (
                        <li>
                          <a
                            href={`/${spoke.id}/`}
                            class="text-sm underline-offset-2 hover:underline"
                            style="color: var(--text-color);"
                          >
                            {spoke.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </section>
          );
        })
      }
    </div>

    <p class="text-base" style="color: var(--muted-color);">
      Prefer to start with your own numbers? Open the
      <a href="/tools/" class="underline" style="color: #F29B30;">free grocery calculators</a>.
    </p>
  </main>
  <Footer />
</BaseLayout>
