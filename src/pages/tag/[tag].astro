/**
 * Tag archives are deliberately not emitted.
 *
 * The old taxonomy produced hundreds of thin, noindex pages. High-impression
 * legacy tag URLs are handled explicitly by functions/[[path]].js; every
 * other /tag or /tag/* path returns 410 so crawlers drop the leftover
 * archives instead of keeping soft 404s.
 */
export function getStaticPaths() {
  return [];
}
