# Cloudflare Pages — HTTP headers
# Early Hints: preconnect for external domains (sent as 103 when Early Hints is enabled)
# Cache: aggressive for static assets
# Security: baseline headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Embeddable chart pages must be frameable by third parties (growth method #18).
# Scoped to /embed/* only — the sitewide SAMEORIGIN above still protects
# every other page. `!` unsets the inherited header for this path.
/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=300, must-revalidate

/images/pins/*
  Cache-Control: public, max-age=300, must-revalidate

/dashboard
  X-Robots-Tag: noindex, nofollow

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/rss.xml
  X-Robots-Tag: noindex
